        // 한 주 = 수요일 ~ 화요일 (주차 N = 시작일 + 7(N-1) ~ +6일, 입력 마감 = 다음 주 수요일 오전 6시 점검 전)
        static constexpr int DAYS_PER_WEEK{ 7 };

