}﻿module LostArkMultiTool.Services.AssetCalculationService;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.DataRepository;
import LostArkMultiTool.Core.LocalTime;
import LostArkMultiTool.Core.MarketAPI;
import LostArkMultiTool.Models.Character;
import LostArkMultiTool.Models.ItemData;
import LostArkMultiTool.Models.PriceData;
import LostArkMultiTool.Models.UserData;

namespace LostArkMultiTool::Services
{
    namespace
    {
        using PriceTable = std::unordered_map<std::string, Models::PriceData>;

        // 조회할 재료 정의 (C# MaterialQuery 대응)
        struct MaterialQuery
        {
            std::string_view m_name;
            std::size_t m_col;      // 표의 열 번호 = Core::APPConstants::MAT_KEYS 인덱스
            bool m_isShard;         // 파편 주머니 (3000개 단위 시세)
            bool m_isBundle;        // 묶음 판매 (묶음 개수로 나눈 시세)
        };

        // 표의 열 번호 (MAT_KEYS 인덱스와 같음)
        constexpr std::size_t COL_SHARD{ 1 };
        constexpr std::size_t COL_DEST{ 2 };
        constexpr std::size_t COL_GUARD{ 3 };
        constexpr std::size_t COL_LEAP{ 4 };
        constexpr std::size_t COL_FUSION{ 5 };
        constexpr std::size_t COL_YONG{ 6 };
        constexpr std::size_t COL_BING{ 7 };

        constexpr double ZERO_PRICE{ 0.0 };

        // 상위 재료 (1730 이상)
        constexpr std::array TOP_MATERIALS{
            MaterialQuery{ .m_name = "운명의 파편 주머니(대)", .m_col = COL_SHARD, .m_isShard = true, .m_isBundle = false },
            MaterialQuery{ .m_name = "운명의 파괴석 결정", .m_col = COL_DEST, .m_isShard = false, .m_isBundle = true },
            MaterialQuery{ .m_name = "운명의 수호석 결정", .m_col = COL_GUARD, .m_isShard = false, .m_isBundle = true },
            MaterialQuery{ .m_name = "위대한 운명의 돌파석", .m_col = COL_LEAP, .m_isShard = false, .m_isBundle = false },
            MaterialQuery{ .m_name = "상급 아비도스 융화 재료", .m_col = COL_FUSION, .m_isShard = false, .m_isBundle = false },
            MaterialQuery{ .m_name = "용암의 숨결", .m_col = COL_YONG, .m_isShard = false, .m_isBundle = false },
            MaterialQuery{ .m_name = "빙하의 숨결", .m_col = COL_BING, .m_isShard = false, .m_isBundle = false }
        };

        // 하위 재료 (1730 미만)
        constexpr std::array BOT_MATERIALS{
            MaterialQuery{ .m_name = "운명의 파괴석", .m_col = COL_DEST, .m_isShard = false, .m_isBundle = true },
            MaterialQuery{ .m_name = "운명의 수호석", .m_col = COL_GUARD, .m_isShard = false, .m_isBundle = true },
            MaterialQuery{ .m_name = "운명의 돌파석", .m_col = COL_LEAP, .m_isShard = false, .m_isBundle = false },
            MaterialQuery{ .m_name = "아비도스 융화 재료", .m_col = COL_FUSION, .m_isShard = false, .m_isBundle = false }
        };

        // 상위·하위 단가가 같은 재료 (운파, 용숨, 빙숨)
        constexpr std::array SHARED_MATERIAL_COLS{ COL_SHARD, COL_YONG, COL_BING };

        // 단가 갱신 (처음이면 직전값 = 현재값 → 등락 0)
        void UpdatePriceDict(PriceTable& dict, const std::string& key, double newPrice)
        {
            Models::PriceData& data{ dict[key] };
            const double currentPrice{ data.GetCurrent() };
            data.SetPrevious(currentPrice == ZERO_PRICE ? newPrice : currentPrice);
            data.SetCurrent(newPrice);
        }

        // 현재 단가 조회 (없으면 0)
        double GetCurrentPrice(const PriceTable& dict, std::string_view key)
        {
            const auto found{ dict.find(std::string{ key }) };
            return found != dict.end() ? found->second.GetCurrent() : ZERO_PRICE;
        }

        // 캐릭터 한 명의 재료 가치 계산 → 합계 반환
        double ApplyMaterialValues(Models::Character& charData, const PriceTable& topPrices, const PriceTable& botPrices)
        {
            double total{};
            for (const std::string_view key : Core::APPConstants::MAT_KEYS)
            {
                if (key.empty()) continue;

                Models::ItemData& item{ charData.GetMaterial(key) };
                item.SetCalculatedTopValue(std::floor(item.GetTopQty() * GetCurrentPrice(topPrices, key)));
                item.SetCalculatedBotValue(std::floor(item.GetBottomQty() * GetCurrentPrice(botPrices, key)));
                total += item.GetCalculatedTopValue() + item.GetCalculatedBotValue();
            }
            return total;
        }
    }

    AssetCalculationService::AssetCalculationService(Core::DataRepository& repository)
        : m_repository{ repository }
    {}

    void AssetCalculationService::AddAssetCalculatedListener(std::function<void()> listener)
    {
        if (!listener) return;   // 빈 함수는 등록하지 않음 (C# event 구독 없음과 같음)
        m_assetCalculatedListeners.push_back(std::move(listener));
    }

    std::unordered_map<std::string, Models::PriceData> AssetCalculationService::GetTopPrices() const
    {
        std::scoped_lock lock{ m_pricesMutex };
        return m_topPrices;   // 복사본 반환 → 호출 쪽은 잠금 없이 안전하게 읽음
    }

    std::unordered_map<std::string, Models::PriceData> AssetCalculationService::GetBotPrices() const
    {
        std::scoped_lock lock{ m_pricesMutex };
        return m_botPrices;
    }

    bool AssetCalculationService::HasPrices() const
    {
        std::scoped_lock lock{ m_pricesMutex };
        return !m_topPrices.empty() && !m_botPrices.empty();
    }

    // 재료마다 거래소 요청 한 번 (상위 · 하위 재료 목록 크기의 합)
    int AssetCalculationService::GetRequestCount() const noexcept
    {
        return static_cast<int>(TOP_MATERIALS.size() + BOT_MATERIALS.size());
    }

    void AssetCalculationService::FetchMarketPrices(Core::MarketAPI& api)
    {
        // 네트워크 호출은 잠금 밖에서 수행 (화면 읽기를 오래 막지 않도록)
        // 임시 맵에 전부 모은 뒤, 모두 성공했을 때만 반영 (부분 갱신 방지)
        std::unordered_map<std::string, double> newTop;
        std::unordered_map<std::string, double> newBot;

        for (const MaterialQuery& material : TOP_MATERIALS)
        {
            const std::string key{ Core::APPConstants::MAT_KEYS.at(material.m_col) };
            newTop.insert_or_assign(key, api.GetPrice(material.m_name, material.m_isShard, material.m_isBundle));
        }

        for (const MaterialQuery& material : BOT_MATERIALS)
        {
            const std::string key{ Core::APPConstants::MAT_KEYS.at(material.m_col) };
            newBot.insert_or_assign(key, api.GetPrice(material.m_name, material.m_isShard, material.m_isBundle));
        }

        // 상위·하위 단가가 같은 재료는 상위 시세를 그대로 사용
        for (const std::size_t col : SHARED_MATERIAL_COLS)
        {
            const std::string key{ Core::APPConstants::MAT_KEYS.at(col) };
            newBot.insert_or_assign(key, newTop.at(key));
        }

        // 여기서만 잠금: 맵 반영 구간
        std::scoped_lock lock{ m_pricesMutex };
        for (const auto& [key, price] : newTop) UpdatePriceDict(m_topPrices, key, price);
        for (const auto& [key, price] : newBot) UpdatePriceDict(m_botPrices, key, price);
    }

    void AssetCalculationService::CalculateCharacterAssets(std::string_view charName)
    {
        Models::Character* charData{ m_repository.GetData().FindCharacter(charName) };
        if (charData == nullptr) return;   // 없는 캐릭터는 조용히 무시 (원본과 같음)

        {
            std::scoped_lock lock{ m_pricesMutex };
            ApplyMaterialValues(*charData, m_topPrices, m_botPrices);
        }
        NotifyAssetCalculated();   // 리스너는 잠금을 푼 뒤 호출 (데드락 방지)
    }

    void AssetCalculationService::CalculateAllCharacters()
    {
        ApplyAllCharacterValues();
        NotifyAssetCalculated();
    }

    // 모든 캐릭터의 계산값까지 갱신하므로 호출 측에서 CalculateCharacterAssets를 따로 부를 필요 없음 (알림 1회)
    void AssetCalculationService::CalculateRosterHistory()
    {
        if (!HasPrices()) return;   // 시세 없이 0원이 기록되는 것 방지

        const double totalRosterAsset{ ApplyAllCharacterValues() };

        Models::UserData& data{ m_repository.GetData() };
        // 그래프의 하루는 오전 6시(일일 컨텐츠 초기화)부터 → 06시 전 갱신은 전날 기록에 반영
        data.RecordHistory(Models::UserData::MakeHistoryKey(Core::LocalTime::GetGameToday()), totalRosterAsset);

        // 원본 C# finally 대응: 저장이 실패해도 화면 갱신은 보장하고, 예외는 그대로 다시 던짐
        try
        {
            m_repository.Save();
        }
        catch (...)
        {
            NotifyAssetCalculated();
            throw;
        }
        NotifyAssetCalculated();
    }

    double AssetCalculationService::ApplyAllCharacterValues()
    {
        Models::UserData& data{ m_repository.GetData() };

        // 맵 구조는 바뀌지 않으므로 const로 순회하고, 값 수정은 FindCharacter가 준 포인터로 함
        std::scoped_lock lock{ m_pricesMutex };
        double totalRosterAsset{};
        for (const auto& entry : std::as_const(data).GetCharacters())
        {
            if (Models::Character* charData{ data.FindCharacter(entry.first) }; charData != nullptr)
            {
                totalRosterAsset += ApplyMaterialValues(*charData, m_topPrices, m_botPrices);
            }
        }
        return totalRosterAsset;
    }

    void AssetCalculationService::NotifyAssetCalculated()
    {
        for (const auto& listener : m_assetCalculatedListeners)
        {
            listener();
        }
    }
}module LostArkMultiTool.Services.AuctionAccessorySearchService;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.AccessorySearchService;
import LostArkMultiTool.Core.MarketAPI;
import LostArkMultiTool.Models.AccessoryListing;
import LostArkMultiTool.Models.AccessorySearchQuery;
import LostArkMultiTool.Models.AuctionOption;

namespace LostArkMultiTool::Services
{
    namespace
    {
        // ===== 부위별 딜러 유효옵션 (띄어쓰기를 뺀 이름, 화면에 보여 줄 순서) =====
        // API 옵션 이름의 띄어쓰기가 달라도("공격력 +" / "공격력+") 같은 옵션으로 보도록 비교할 때 띄어쓰기를 뺌
        constexpr std::size_t DEALER_OPTION_COUNT{ 4 };
        using DealerOptionNames = std::array<std::string_view, DEALER_OPTION_COUNT>;

        constexpr DealerOptionNames NECKLACE_DEALER_OPTIONS{ "추가피해", "적에게주는피해증가", "공격력+", "무기공격력+" };
        constexpr DealerOptionNames EARRING_DEALER_OPTIONS{ "공격력+", "공격력%", "무기공격력+", "무기공격력%" };
        constexpr DealerOptionNames RING_DEALER_OPTIONS{ "공격력+", "무기공격력+", "치명타적중률", "치명타피해" };

        constexpr std::string_view IGNORED_CHARACTERS{ " \t" };   // 비교할 때 무시하는 글자

        // 띄어쓰기를 뺀 이름
        [[nodiscard]] std::string RemoveSpaces(std::string_view text)
        {
            std::string compact;
            compact.reserve(text.size());
            for (const char character : text)
            {
                if (!IGNORED_CHARACTERS.contains(character)) compact.push_back(character);
            }
            return compact;
        }

        // ===== 연마 효과 상 · 중 · 하 수치 (띄어쓰기를 뺀 이름 → 상 · 중 · 하 순서, 퍼센트 옵션은 % 단위) =====
        constexpr std::size_t POLISH_GRADE_COUNT{ 3 };
        struct PolishTier
        {
            std::string_view m_name;
            bool m_isPercent{};
            std::array<double, POLISH_GRADE_COUNT> m_amounts{};
        };

        constexpr std::size_t POLISH_TIER_COUNT{ 8 };
        constexpr std::array<PolishTier, POLISH_TIER_COUNT> POLISH_TIERS
        { {
            { "추가피해",           true,  { 2.6, 1.6, 0.7 } },
            { "적에게주는피해증가", true,  { 2.0, 1.2, 0.55 } },
            { "공격력+",            false, { 390.0, 195.0, 80.0 } },
            { "무기공격력+",        false, { 960.0, 480.0, 195.0 } },
            { "공격력%",            true,  { 1.55, 0.95, 0.4 } },
            { "무기공격력%",        true,  { 3.0, 1.8, 0.8 } },
            { "치명타적중률",       true,  { 1.55, 0.95, 0.4 } },
            { "치명타피해",         true,  { 4.0, 2.4, 1.1 } },
        } };

        constexpr std::array<Models::PolishGrade, POLISH_GRADE_COUNT> POLISH_GRADES
        {
            Models::PolishGrade::GRADE_HIGH, Models::PolishGrade::GRADE_MIDDLE, Models::PolishGrade::GRADE_LOW
        };
        constexpr std::array<std::string_view, POLISH_GRADE_COUNT> POLISH_GRADE_NAMES{ "상", "중", "하" };

        constexpr double AMOUNT_TOLERANCE{ 0.001 };       // 표시 수치 비교 오차 (소수 둘째 자리까지)
        constexpr double PERCENT_REQUEST_SCALE{ 100.0 };  // API 값을 못 찾았을 때: 2.60% → 260 (API 표시 "0.60%" = 값 60 기준)

        // 표시 글자에서 첫 숫자 읽기 ("+2.60%" → 2.6, "1,234" → 1234, 숫자가 없으면 nullopt)
        [[nodiscard]] std::optional<double> ParseAmount(std::string_view text)
        {
            const std::size_t first{ text.find_first_of("0123456789") };
            if (first == std::string_view::npos) return std::nullopt;

            std::string digits;
            for (const char character : text.substr(first))
            {
                if (character == ',') continue;   // 천 단위 구분
                if (!std::isdigit(static_cast<unsigned char>(character)) && character != '.') break;
                digits.push_back(character);
            }

            double amount{};
            const auto [end, error]{ std::from_chars(digits.data(), digits.data() + digits.size(), amount) };
            if (error != std::errc{}) return std::nullopt;
            return amount;
        }

        // 수치 → 검색 요청 값: API 값 목록에서 같은 수치를 찾고, 없으면 API 값 · 표시 비율로 환산, 그것도 없으면 단위 규칙으로
        [[nodiscard]] int FindRequestValue(const Models::AuctionOption& option, double amount, bool isPercent)
        {
            std::optional<double> ratio;
            for (const Models::AuctionOptionValue& value : option.m_values)
            {
                const std::optional<double> shown{ ParseAmount(value.m_displayText) };
                if (!shown.has_value()) continue;
                if (std::abs(*shown - amount) < AMOUNT_TOLERANCE) return value.m_value;
                if (!ratio.has_value() && *shown > 0.0) ratio = static_cast<double>(value.m_value) / *shown;
            }

            const double scale{ ratio.value_or(isPercent ? PERCENT_REQUEST_SCALE : 1.0) };
            return static_cast<int>(std::lround(amount * scale));
        }

        // 딜러 유효옵션이면 값 목록을 상 · 중 · 하 세 개로 바꿈 (표에 없는 옵션은 API 값 그대로)
        void ApplyPolishTiers(Models::AuctionOption& option, std::string_view compactName)
        {
            const auto tier{ std::ranges::find(POLISH_TIERS, compactName, &PolishTier::m_name) };
            if (tier == POLISH_TIERS.end()) return;

            std::vector<Models::AuctionOptionValue> values;
            values.reserve(POLISH_GRADE_COUNT);
            for (std::size_t gradeIndex{}; gradeIndex < POLISH_GRADE_COUNT; ++gradeIndex)
            {
                const double amount{ tier->m_amounts[gradeIndex] };
                const std::string displayText{ tier->m_isPercent
                    ? std::format("{} (+{:.2f}%)", POLISH_GRADE_NAMES[gradeIndex], amount)
                    : std::format("{} (+{:.0f})", POLISH_GRADE_NAMES[gradeIndex], amount) };
                values.push_back(Models::AuctionOptionValue{ displayText, FindRequestValue(option, amount, tier->m_isPercent), POLISH_GRADES[gradeIndex] });
            }
            option.m_values = std::move(values);
        }

        // 부위 카테고리 → 유효옵션 목록 (모르는 부위면 nullptr)
        [[nodiscard]] const DealerOptionNames* FindDealerOptions(int categoryCode) noexcept
        {
            switch (categoryCode)
            {
                case Core::APPConstants::NECKLACE_CATEGORY_CODE: return &NECKLACE_DEALER_OPTIONS;
                case Core::APPConstants::EARRING_CATEGORY_CODE:  return &EARRING_DEALER_OPTIONS;
                case Core::APPConstants::RING_CATEGORY_CODE:     return &RING_DEALER_OPTIONS;
                default:                                         return nullptr;
            }
        }
    }

    AuctionAccessorySearchService::AuctionAccessorySearchService() = default;

    // 묶음 이름에 "연마"가 들어간 옵션만 (찾지 못하면 이름이 바뀌었을 수 있으니 전체를 그대로 보여 줌)
    std::vector<Models::AuctionOption> AuctionAccessorySearchService::FetchOptions(Core::MarketAPI& api) const
    {
        std::vector<Models::AuctionOption> options{ api.GetAuctionOptions() };

        std::vector<Models::AuctionOption> polishOptions;
        for (Models::AuctionOption& option : options)
        {
            if (option.m_groupName.contains(Core::APPConstants::POLISH_OPTION_KEYWORD)) polishOptions.push_back(std::move(option));
        }
        return polishOptions.empty() ? options : polishOptions;
    }

    // 유효옵션 순서대로 이름이 같은 옵션을 찾아 담음 (API 이름이 바뀌어 하나도 못 찾으면 고를 수 있게 전체를 그대로 돌려줌)
    std::vector<Models::AuctionOption> AuctionAccessorySearchService::FilterOptions(const std::vector<Models::AuctionOption>& options, int categoryCode) const
    {
        const DealerOptionNames* dealerOptions{ FindDealerOptions(categoryCode) };
        if (dealerOptions == nullptr) return options;

        std::vector<Models::AuctionOption> filtered;
        filtered.reserve(dealerOptions->size());
        for (const std::string_view dealerOption : *dealerOptions)
        {
            const auto found{ std::ranges::find_if(options, [dealerOption](const Models::AuctionOption& option)
            {
                return RemoveSpaces(option.m_name) == dealerOption;
            }) };
            if (found == options.end()) continue;

            // 값 고르기는 상 · 중 · 하만
            Models::AuctionOption& option{ filtered.emplace_back(*found) };
            ApplyPolishTiers(option, dealerOption);
        }
        return filtered.empty() ? options : filtered;
    }

    Models::AccessorySearchPage AuctionAccessorySearchService::Search(Core::MarketAPI& api, const Models::AccessorySearchQuery& query) const
    {
        return api.SearchAccessories(query);
    }
}
﻿module LostArkMultiTool.Services.AuctionGemPriceService;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.APPExceptions;
import LostArkMultiTool.Core.GemDataRepository;
import LostArkMultiTool.Core.GemPriceService;
import LostArkMultiTool.Core.LocalTime;
import LostArkMultiTool.Core.MarketAPI;
import LostArkMultiTool.Models.GemCatalog;
import LostArkMultiTool.Models.GemData;
import LostArkMultiTool.Models.GemQuote;
import LostArkMultiTool.Models.PriceAlarm;
import LostArkMultiTool.Models.RefreshSettings;

namespace LostArkMultiTool::Services
{
    AuctionGemPriceService::AuctionGemPriceService(Core::GemDataRepository& repository)
        : m_repository{ repository }
    {
        // 조회 대상(종류 × 레벨)마다 시세 칸을 만들고, 지난 실행의 전체 갱신가를 등락 기준으로 넣어 둠
        const std::map<std::string, std::int64_t>& lastPrices{ m_repository.GetData().GetLastPrices() };
        for (Models::GemSelection& gem : Models::GemCatalog::GetAllGems())
        {
            std::string gemKey{ Models::GemCatalog::MakeKey(gem) };
            Models::GemQuote quote{ std::move(gem) };
            if (const auto saved{ lastPrices.find(gemKey) }; saved != lastPrices.end()) quote.SetPreviousPrice(saved->second);
            m_quotes.emplace(std::move(gemKey), std::move(quote));
        }
    }

    const std::map<std::string, Models::GemQuote>& AuctionGemPriceService::GetQuotes() const noexcept
    {
        return m_quotes;
    }

    const std::vector<Models::PriceAlarm>& AuctionGemPriceService::GetAlarms() const noexcept
    {
        return m_repository.GetData().GetAlarms();
    }

    const std::optional<std::int64_t>& AuctionGemPriceService::GetLastFullUpdated() const noexcept
    {
        return m_lastFullUpdated;
    }

    const std::optional<std::int64_t>& AuctionGemPriceService::GetLastWatchUpdated() const noexcept
    {
        return m_lastWatchUpdated;
    }

    std::vector<Models::GemSelection> AuctionGemPriceService::GetAllTargets() const
    {
        return Models::GemCatalog::GetAllGems();
    }

    // 알림이 걸린 보석만 (조회 범위 밖이거나 알 수 없는 종류는 제외, 중복 제거)
    std::vector<Models::GemSelection> AuctionGemPriceService::GetWatchedTargets() const
    {
        std::vector<Models::GemSelection> targets;
        std::set<std::string> seenKeys;
        for (const Models::PriceAlarm& alarm : m_repository.GetData().GetAlarms())
        {
            std::string gemKey{ alarm.GetGemKey() };
            if (!m_quotes.contains(gemKey)) continue;              // 조회 범위 밖
            if (!seenKeys.insert(std::move(gemKey)).second) continue;   // 이미 추가한 보석

            targets.push_back(alarm.GetGem());
        }
        return targets;
    }

    // 동시 요청 수를 제한해서 모두 조회 (원본 SemaphoreSlim + Task.WhenAll → 작업자 스레드 3개가 차례로 하나씩 가져감)
    std::vector<Core::FetchedPrice> AuctionGemPriceService::FetchPrices(Core::MarketAPI& api, const std::vector<Models::GemSelection>& targets) const
    {
        std::vector<Core::FetchedPrice> results(targets.size());
        std::stop_source stopSource;            // 하나가 실패하면 나머지 중단 (원본 CancellationTokenSource)
        std::atomic<std::size_t> nextIndex{};   // 다음에 조회할 보석 번호
        std::mutex errorMutex;
        std::exception_ptr firstError;          // 처음 실패한 진짜 원인 (중단으로 생긴 예외는 제외)

        const auto worker{ [&]
        {
            while (!stopSource.stop_requested())
            {
                const std::size_t index{ nextIndex.fetch_add(1) };
                if (index >= targets.size()) return;

                const Models::GemSelection& gem{ targets[index] };
                results[index].m_gemKey = Models::GemCatalog::MakeKey(gem);

                const Models::GemType* type{ Models::GemCatalog::FindType(gem.m_typeName) };
                if (type == nullptr) continue;   // 알 수 없는 종류는 매물 없음으로 (GetWatchedTargets에서 이미 걸러짐)

                try
                {
                    results[index].m_price = api.GetLowestBuyPrice(Models::GemCatalog::MakeItemName(*type, gem.m_level), type->m_tier,
                        stopSource.get_token());
                }
                catch (const Core::RequestCanceledException&)
                {
                    return;   // 다른 요청의 실패로 중단됨 → 원인으로 보지 않음
                }
                catch (...)
                {
                    {
                        std::scoped_lock lock{ errorMutex };
                        if (!firstError) firstError = std::current_exception();
                    }
                    stopSource.request_stop();   // 이번 회차는 반영되지 않으므로 나머지 요청 중단
                    return;
                }
            }
        } };

        {
            // 작업자는 이 범위를 벗어날 때 모두 끝날 때까지 기다림 (jthread 소멸자 = join → 결과 · 예외를 안전하게 읽음)
            const std::size_t workerCount{ std::min(targets.size(), static_cast<std::size_t>(Core::APPConstants::MAX_CONCURRENT_REQUESTS)) };
            std::vector<std::jthread> workers;
            workers.reserve(workerCount);
            for (std::size_t count{}; count < workerCount; ++count) workers.emplace_back(worker);
        }

        if (firstError) std::rethrow_exception(firstError);
        return results;
    }

    // 조회 결과 반영 → 알림 판정 → (바뀐 게 있으면) 저장 (원본 RefreshTargetsAsync 뒷부분)
    Core::RefreshResult AuctionGemPriceService::ApplyPrices(const std::vector<Core::FetchedPrice>& prices, bool isFull)
    {
        Core::RefreshResult result;
        // 일별 최저가의 하루는 오전 6시(일일 컨텐츠 초기화)부터 → 06시 전 조회는 전날 기록에 반영
        const std::string today{ Core::LocalTime::MakeDateKey(Core::LocalTime::GetGameToday()) };

        bool isChanged{};
        for (const Core::FetchedPrice& fetched : prices) isChanged |= ApplyPrice(fetched, isFull, today);
        isChanged |= EvaluateAlarms(result.m_reachedAlarms);

        // 전체 · 감시 갱신 시각을 따로 기록
        (isFull ? m_lastFullUpdated : m_lastWatchUpdated) = Core::LocalTime::GetUnixSeconds();

        if (!isChanged) return result;   // 저장할 변경이 있을 때만 파일에 씀
        try
        {
            m_repository.Save();
        }
        catch (const std::exception& error)
        {
            result.m_saveError = error.what();   // 저장 실패는 "시세 갱신 실패"와 구분해서 전달
        }
        return result;
    }

    void AuctionGemPriceService::SetAlarm(const Models::GemSelection& gem, std::int64_t targetPrice)
    {
        std::vector<Models::PriceAlarm>& alarms{ m_repository.GetData().GetAlarms() };
        const std::string gemKey{ Models::GemCatalog::MakeKey(gem) };

        // 같은 보석에 알림이 이미 있으면 목표가만 변경 (되돌리기용으로 이전 상태를 복사해 둠)
        const auto existing{ std::find_if(alarms.begin(), alarms.end(), [&gemKey](const Models::PriceAlarm& alarm) { return alarm.GetGemKey() == gemKey; }) };
        const bool isNew{ existing == alarms.end() };
        const std::optional<Models::PriceAlarm> previous{ isNew ? std::nullopt : std::optional<Models::PriceAlarm>{ *existing } };
        const auto index{ static_cast<std::size_t>(std::distance(alarms.begin(), existing)) };

        if (isNew) alarms.emplace_back(gem, targetPrice);

        Models::PriceAlarm& alarm{ alarms[index] };   // push_back 뒤라도 번호로 다시 찾으므로 안전
        alarm.SetTargetPrice(targetPrice);
        alarm.SetTriggered(false);
        alarm.SetNotified(false);
        static_cast<void>(UpdateAlarmState(alarm, false));   // 이미 목표가 이하라면 표시만 하고 풍선 알림은 생략

        try
        {
            m_repository.Save();
        }
        catch (...)
        {
            // 저장에 실패하면 화면과 파일이 어긋나지 않게 메모리 상태를 원래대로
            if (isNew) alarms.pop_back();
            else alarms[index] = *previous;
            throw;
        }
    }

    void AuctionGemPriceService::RemoveAlarm(std::string_view gemKey)
    {
        std::vector<Models::PriceAlarm>& alarms{ m_repository.GetData().GetAlarms() };
        const auto found{ std::find_if(alarms.begin(), alarms.end(), [gemKey](const Models::PriceAlarm& alarm) { return alarm.GetGemKey() == gemKey; }) };
        if (found == alarms.end()) return;

        const auto index{ std::distance(alarms.begin(), found) };
        Models::PriceAlarm removed{ std::move(*found) };
        alarms.erase(found);

        try
        {
            m_repository.Save();
        }
        catch (...)
        {
            alarms.insert(alarms.begin() + index, std::move(removed));   // 원래 위치에 되돌림
            throw;
        }
    }

    Models::RefreshSettings AuctionGemPriceService::GetSettings() const
    {
        return m_repository.GetData().GetSettings();
    }

    void AuctionGemPriceService::UpdateSettings(const Models::RefreshSettings& settings)
    {
        Models::GemData& data{ m_repository.GetData() };
        const Models::RefreshSettings previous{ data.GetSettings() };

        Models::RefreshSettings next{ settings };
        next.Normalize();
        data.SetSettings(next);

        try
        {
            m_repository.Save();
        }
        catch (...)
        {
            data.SetSettings(previous);
            throw;
        }
    }

    const std::map<std::string, std::int64_t>& AuctionGemPriceService::GetHistory(std::string_view gemKey) const
    {
        static const std::map<std::string, std::int64_t> EMPTY_HISTORY;   // 기록이 없는 보석에 돌려줄 빈 목록 (매번 만들지 않도록 공유)

        const auto& history{ m_repository.GetData().GetHistory() };
        const auto found{ history.find(std::string{ gemKey }) };
        return found != history.end() ? found->second : EMPTY_HISTORY;
    }

    bool AuctionGemPriceService::ApplyPrice(const Core::FetchedPrice& fetched, bool isFull, const std::string& today)
    {
        const auto found{ m_quotes.find(fetched.m_gemKey) };
        if (found == m_quotes.end()) return false;

        Models::GemQuote& quote{ found->second };
        quote.SetPrice(fetched.m_price);
        quote.SetQueried(true);

        // 등락 기준은 "전체 갱신"에서만 넘김 → 감시 갱신이 기준을 흔들지 않음
        if (isFull)
        {
            if (quote.GetLastFullPrice().has_value()) quote.SetPreviousPrice(quote.GetLastFullPrice());   // 첫 전체 갱신이면 저장값 유지
            if (fetched.m_price.has_value()) quote.SetLastFullPrice(fetched.m_price);                     // 매물 없음이면 기준을 지우지 않음
        }

        if (!fetched.m_price.has_value()) return false;   // 매물 없음 → 기록하지 않음
        const std::int64_t price{ *fetched.m_price };

        // 재시작 후 비교용 가격도 전체 갱신 기준으로만 저장
        bool isChanged{};
        std::map<std::string, std::int64_t>& lastPrices{ m_repository.GetData().GetLastPrices() };
        if (isFull)
        {
            const auto saved{ lastPrices.find(fetched.m_gemKey) };
            if (saved == lastPrices.end() || saved->second != price)
            {
                lastPrices.insert_or_assign(fetched.m_gemKey, price);
                isChanged = true;
            }
        }

        return RecordDailyLowest(fetched.m_gemKey, today, price) || isChanged;
    }

    bool AuctionGemPriceService::RecordDailyLowest(const std::string& gemKey, const std::string& day, std::int64_t price)
    {
        std::map<std::string, std::int64_t>& days{ m_repository.GetData().GetHistory()[gemKey] };

        if (const auto recorded{ days.find(day) }; recorded != days.end() && price >= recorded->second) return false;
        days.insert_or_assign(day, price);
        return true;
    }

    bool AuctionGemPriceService::EvaluateAlarms(std::vector<Core::ReachedAlarm>& reached)
    {
        bool isChanged{};
        for (Models::PriceAlarm& alarm : m_repository.GetData().GetAlarms())
        {
            const bool wasTriggered{ alarm.IsTriggered() };
            if (UpdateAlarmState(alarm, true))
            {
                reached.push_back(Core::ReachedAlarm{ alarm.GetDisplayName(), *m_quotes.at(alarm.GetGemKey()).GetPrice(), alarm.GetTargetPrice() });
            }
            if (wasTriggered != alarm.IsTriggered()) isChanged = true;
        }
        return isChanged;
    }

    bool AuctionGemPriceService::UpdateAlarmState(Models::PriceAlarm& alarm, bool canNotify)
    {
        // 시세가 있고 가격도 있을 때만 판정
        const auto quote{ m_quotes.find(alarm.GetGemKey()) };
        if (quote == m_quotes.end() || !quote->second.GetPrice().has_value()) return false;

        const bool isReached{ *quote->second.GetPrice() <= alarm.GetTargetPrice() };
        alarm.SetTriggered(isReached);

        if (!isReached)
        {
            alarm.SetNotified(false);
            return false;
        }

        if (alarm.IsNotified()) return false;   // 이미 알림
        alarm.SetNotified(true);
        return canNotify;
    }
