        constexpr double PERCENT_SCALE{ 100.0 };   // 비율 → 퍼센트
    }

    EngravingQuote::EngravingQuote(MarketItem item)
        : m_item{ std::move(item) }
    {}

    const std::string& EngravingQuote::GetName() const noexcept
