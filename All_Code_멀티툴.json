export module LostArkMultiTool.Views.AccessoryFinderManager;

import std;
import LostArkMultiTool.Core.AccessorySearchService;
import LostArkMultiTool.Core.BackgroundTask;
import LostArkMultiTool.Core.Input;
import LostArkMultiTool.Core.Renderer;
import LostArkMultiTool.Core.Singleton;
import LostArkMultiTool.Core.ToolContext;
import LostArkMultiTool.Core.ToolManager;
import LostArkMultiTool.Models.AccessoryListing;
import LostArkMultiTool.Models.AccessorySearchQuery;
import LostArkMultiTool.Models.AuctionOption;
import LostArkMultiTool.Views.AccessoryFinderView;

export namespace LostArkMultiTool::Views
{
    // 악세 검색기 최상위 매니저 (이 툴의 화면구성 · 렌더링 · 모델을 묶어서 관리)
    // ToolManager(탭으로 동작) + Singleton(프로그램에 하나만 존재) 다중 상속
    // 화면구성 · 렌더링 = AccessoryFinderView, 모델 = AccessorySearchService(경매장 악세 검색)
    // 매니저는 연마 효과 목록 불러오기 · 검색 조건 만들기 · 페이지 이동 · 오류 안내를 맡음
    class AccessoryFinderManager final : public Core::ToolManager, public Core::Singleton<AccessoryFinderManager>
    {
    public:
        [[nodiscard]] std::wstring_view GetTabTitle() const noexcept override;

        void Initialize(Core::ToolContext& context) override;
        void Shutdown() override;

        void OnActivated() override;
        void OnDeactivated() override;

        void Update(double deltaSeconds) override;
        void Render(Core::Renderer& renderer, const Core::RectF& contentArea) override;

        [[nodiscard]] bool HandleInput(const Core::InputEvent& event) override;
        [[nodiscard]] Core::CursorShape GetCursor() const noexcept override;
        void OnAPIKeyChanged() override;

    private:
        friend class Core::Singleton<AccessoryFinderManager>;   // GetInstance만 생성 · 소멸할 수 있게

        AccessoryFinderManager();
        ~AccessoryFinderManager() override;

        // ===== 연마 효과 목록 =====
        void RequestOptions();         // 아직 불러오지 않았을 때만 (탭을 처음 열 때 · 키를 바꿨을 때)
        void FinishOptions();
        void ChangeOption(std::size_t slotIndex);   // 옵션을 바꾸면 그 옵션의 값 목록으로 값 칸을 채움
        void ApplyCategoryOptions();                // 지금 부위의 딜러 유효옵션만 연마 효과 칸에 채움 (목록을 받았을 때 · 부위를 바꿨을 때)

        // ===== 검색 =====
        void Search();                 // 화면 조건으로 첫 페이지
        void MovePage(int pageStep);   // 지난 조건으로 이전 · 다음 페이지
        void RequestSearch(Models::AccessorySearchQuery query);
        void FinishSearch();
        [[nodiscard]] Models::AccessorySearchQuery BuildQuery() const;

        // ===== 안내 =====
        [[nodiscard]] bool CheckRateLimit();   // 남은 호출이 부족하면 안내하고 false
        void ShowRequestError(const std::exception& error);   // 키 오류면 재입력 안내, 나머지는 메시지
        void HandleAPIKeyError(const std::string& message);
        void UpdatePageInfo();

        Core::ToolContext* m_context{};   // Application이 소유 (Initialize ~ Shutdown 동안만 유효)

        // 선언 순서 = 생성 순서 (화면은 서비스 결과를 쓰므로 반대 순서로 해제)
        std::unique_ptr<Core::AccessorySearchService> m_service;
        std::unique_ptr<AccessoryFinderView> m_view;

        Core::BackgroundTask<std::vector<Models::AuctionOption>> m_optionsTask;
        Core::BackgroundTask<Models::AccessorySearchPage> m_searchTask;

        std::vector<Models::AuctionOption> m_allOptions;       // API에서 받은 연마 효과 전체
        std::vector<Models::AuctionOption> m_options;          // 지금 부위의 유효옵션 (콤보 상자 항목 순서)
        bool m_isOptionsLoaded{};
        bool m_isOptionsFailed{};                              // 마지막 불러오기가 실패함 (자동 재시도 멈춤)
        std::optional<Models::AccessorySearchQuery> m_runningQuery;   // 조회 중인 조건
        std::optional<Models::AccessorySearchQuery> m_lastQuery;      // 마지막으로 결과를 받은 조건 (페이지 이동 기준)
        Models::AccessorySearchPage m_page;                           // 지금 보이는 결과
    };
}
export module LostArkMultiTool.Views.AccessoryFinderView;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.Input;
import LostArkMultiTool.Core.Platform;
import LostArkMultiTool.Core.Renderer;
import LostArkMultiTool.Models.AccessoryListing;
import LostArkMultiTool.Views.UI.Button;
import LostArkMultiTool.Views.UI.ComboBox;
import LostArkMultiTool.Views.UI.ControlHost;
import LostArkMultiTool.Views.UI.Grid;
import LostArkMultiTool.Views.UI.Label;

export namespace LostArkMultiTool::Views
{
    // 악세 검색기 화면 구성
    // 부품 배치 · 표시 형식만 알고, 옵션 불러오기 · 검색 · 페이지 이동은 AccessoryFinderManager가 맡음
    class AccessoryFinderView
    {
    public:
        explicit AccessoryFinderView(Core::Platform& platform);
        ~AccessoryFinderView();

        AccessoryFinderView(const AccessoryFinderView&) = delete;
        AccessoryFinderView& operator=(const AccessoryFinderView&) = delete;

        // ===== 사용자 동작 알림 (AccessoryFinderManager가 연결) =====
        void SetOnSearch(std::function<void()> onSearch);
        void SetOnPageMove(std::function<void(int pageStep)> onPageMove);                     // -1 = 이전, +1 = 다음
        void SetOnOptionChanged(std::function<void(std::size_t slotIndex)> onOptionChanged);   // 연마 효과 칸의 옵션을 바꿈
        void SetOnCategoryChanged(std::function<void()> onCategoryChanged);                     // 부위를 바꿈 (유효옵션 목록이 달라짐)

        // ===== 검색 조건 =====
        [[nodiscard]] int GetCategoryCode() const noexcept;
        [[nodiscard]] std::optional<int> GetMinQuality() const noexcept;   // nullopt = 품질 전체

        // 연마 효과 칸 (옵션 이름 목록은 모든 칸 공통, 값 목록은 칸마다)
        void SetOptionNames(const std::vector<std::wstring>& optionNames);   // 모든 칸이 "선택 안 함"으로 돌아감
        // 값 칸이 "값 전체"로 돌아감 (valueColors = 항목마다 글자색, 비어 있으면 기본색)
        void SetOptionValues(std::size_t slotIndex, const std::vector<std::wstring>& valueTexts,
            const std::vector<std::optional<Core::Color>>& valueColors = {});
        [[nodiscard]] std::optional<std::size_t> GetSelectedOption(std::size_t slotIndex) const noexcept;   // 옵션 이름 목록의 번호 (선택 안 함 = nullopt)
        [[nodiscard]] std::optional<std::size_t> GetSelectedValue(std::size_t slotIndex) const noexcept;    // 값 목록의 번호 (값 전체 = nullopt)

        // ===== 상태 =====
        void SetBusy(bool isBusy) noexcept;   // 조회 중에는 검색 · 페이지 버튼 비활성
        void SetStatusText(std::wstring text);
        void SetPageInfo(std::wstring text, bool hasPrevious, bool hasNext);

        // ===== 결과 표 =====
        void ShowListings(const std::vector<Models::AccessoryListing>& listings);

        // ===== 프레임 =====
        void Update(double deltaSeconds);
        void Render(Core::Renderer& renderer, const Core::RectF& contentArea);
        [[nodiscard]] bool HandleInput(const Core::InputEvent& event);
        [[nodiscard]] Core::CursorShape GetCursor() const noexcept;
        void SuspendFocus();   // 다른 탭 · 대화상자로 입력을 넘길 때
        void RestoreFocus();

    private:
        // 연마 효과 조건 칸 하나 (옵션 + 최소 값)
        struct OptionSlot
        {
            UI::ComboBox* m_optionBox{};   // m_host가 소유
            UI::ComboBox* m_valueBox{};    // m_host가 소유
        };

        // 연마 효과 칸 부품 만들기 (생성자 초기화 목록에서 호출 → 옵션 · 값 상자가 Tab 순서대로 m_host에 추가됨)
        [[nodiscard]] std::array<OptionSlot, Core::APPConstants::MAX_ACCESSORY_OPTION_FILTERS> MakeOptionSlots();

        void Layout(const Core::RectF& contentArea);
        void RenderPanel(Core::Renderer& renderer) const;
        void UpdatePageButtons() noexcept;

        UI::ControlHost m_host;

        // 부품은 m_host가 소유 (참조는 배치 · 값 설정용, 추가 순서 = Tab 이동 순서)
        UI::Label& m_categoryLabel;
        UI::ComboBox& m_categoryBox;
        UI::Label& m_qualityLabel;
        UI::ComboBox& m_qualityBox;
        UI::Button& m_searchButton;
        UI::Label& m_statusLabel;
        UI::Label& m_optionLabel;
        std::array<OptionSlot, Core::APPConstants::MAX_ACCESSORY_OPTION_FILTERS> m_optionSlots;
        UI::Grid& m_listingGrid;
        UI::Button& m_previousButton;
        UI::Label& m_pageLabel;
        UI::Button& m_nextButton;

        bool m_isBusy{};
        bool m_hasPrevious{};
        bool m_hasNext{};

        Core::RectF m_panelBounds;   // 묶음 상자 (테두리 + 제목)
        Core::RectF m_layoutArea;
        bool m_hasLayout{};

        std::function<void()> m_onSearch;
        std::function<void(int)> m_onPageMove;
        std::function<void(std::size_t)> m_onOptionChanged;
        std::function<void()> m_onCategoryChanged;
    };
}
export module LostArkMultiTool.Models.AccessoryListing;

import std;

// 경매장 악세 매물 (Open API /auctions/items 응답의 Items 한 칸 + 페이지 정보)
// 타입 정의만 있어서 .cpp가 필요 없음
export namespace LostArkMultiTool::Models
{
    // 매물에 붙은 옵션 한 줄 (예: 추가 피해 +0.60%)
    struct AccessoryOptionLine
    {
        std::string m_type;          // 옵션 종류 (예: ACCESSORY_UPGRADE = 연마 효과, STAT = 기본 스탯)
        std::string m_name;          // 옵션 이름 (UTF-8)
        double m_value{};
        bool m_isPercentage{};       // 값이 % 단위인지
    };

    struct AccessoryListing
    {
        std::string m_name;                           // 아이템 이름 (UTF-8)
        std::string m_gradeName;                      // 등급 (UTF-8)
        int m_quality{};                              // 품질 (0 ~ 100)
        std::vector<AccessoryOptionLine> m_options;
        std::optional<std::int64_t> m_buyPrice;       // 즉시 구매가 (입찰 전용이면 nullopt)
        std::int64_t m_bidStartPrice{};               // 최소 입찰가
        std::string m_endDate;                        // 판매 마감 (API 형식 "yyyy-MM-ddTHH:mm:ss...")
        std::optional<int> m_tradeAllowCount;         // 남은 거래 가능 횟수
    };

    // 검색 결과 한 페이지
    struct AccessorySearchPage
    {
        std::vector<AccessoryListing> m_listings;
        int m_page{};             // 이번 페이지 번호 (1부터)
        int m_pageSize{};         // 한 페이지 매물 수 (보통 10)
        int m_totalCount{};       // 조건에 맞는 전체 매물 수
    };
}
﻿export module LostArkMultiTool.Models.AccessorySearchQuery;

import std;

// 악세 검색 조건 (경매장 /auctions/items 요청 본문으로 바뀜)
// 타입 정의만 있어서 .cpp가 필요 없음
export namespace LostArkMultiTool::Models
{
    // 옵션 조건 하나 (minValue가 없으면 옵션이 붙어 있기만 하면 됨)
    struct AccessoryOptionFilter
    {
        int m_firstOption{};
        int m_secondOption{};
        std::optional<int> m_minValue;
    };

    struct AccessorySearchQuery
    {
        int m_categoryCode{};                          // 부위 (목걸이 · 귀걸이 · 반지)
        std::string m_gradeName;                       // 등급 (UTF-8, 고대 · 유물)
        std::optional<int> m_minQuality;               // 최소 품질 (nullopt = 전체)
        std::vector<AccessoryOptionFilter> m_options;  // 연마 효과 조건 (모두 만족)
        int m_page{ 1 };                               // 결과 페이지 (1부터)
    };
}
export module LostArkMultiTool.Core.AccessorySearchService;

import std;
import LostArkMultiTool.Core.MarketAPI;
import LostArkMultiTool.Models.AccessoryListing;
import LostArkMultiTool.Models.AccessorySearchQuery;
import LostArkMultiTool.Models.AuctionOption;

export namespace LostArkMultiTool::Core
{
    // 악세 검색 (악세 검색기의 모델)
    // 두 조회 함수 모두 데이터를 건드리지 않아 백그라운드 스레드에서 호출해도 안전
    // 받은 결과(옵션 목록 · 현재 페이지)는 화면 스레드에서 매니저가 보관
    class AccessorySearchService
    {
    public:
        virtual ~AccessorySearchService();

        // 악세에 거는 연마 효과 옵션 목록 (API 검색 옵션 중 연마 효과 묶음만, 없으면 전체)
        [[nodiscard]] virtual std::vector<Models::AuctionOption> FetchOptions(MarketAPI& api) const = 0;

        // 부위에 맞는 딜러 유효옵션만 골라냄 (정해 둔 순서대로, 하나도 맞지 않으면 전체를 그대로)
        [[nodiscard]] virtual std::vector<Models::AuctionOption> FilterOptions(const std::vector<Models::AuctionOption>& options, int categoryCode) const = 0;

        // 조건에 맞는 매물 한 페이지 (즉시 구매가 낮은 순)
        [[nodiscard]] virtual Models::AccessorySearchPage Search(MarketAPI& api, const Models::AccessorySearchQuery& query) const = 0;
    };
}
﻿export module LostArkMultiTool.Views.APIKeyDialog;

import std;
import LostArkMultiTool.Core.Notifier;
import LostArkMultiTool.Core.Platform;
import LostArkMultiTool.Core.Renderer;
import LostArkMultiTool.Views.UI.Button;
import LostArkMultiTool.Views.UI.Dialog;
import LostArkMultiTool.Views.UI.Label;
import LostArkMultiTool.Views.UI.TextBox;

export namespace LostArkMultiTool::Views
{
    // API 키 입력 창을 연 상황
    enum class APIKeyDialogMode
    {
        API_KEY_FIRST_RUN,   // 처음 실행 (저장된 키 없음): [저장 및 시작] [종료]
        API_KEY_CHANGE       // 키 변경 · 키 오류 후 재입력: [저장] [취소]
    };

    // API 키 입력 대화상자 (원본 APIKeyForm 대응, 세 툴 공용 키를 한 번만 입력)
    class APIKeyDialog final : public UI::Dialog
    {
    public:
        // onSave: 저장에 성공하면 true (실패하면 창을 닫지 않음, 실패 안내는 저장하는 쪽에서)
        // onCancel: [종료] · [취소]
        APIKeyDialog(Core::Platform& platform, Core::Notifier& notifier, APIKeyDialogMode mode, std::wstring currentKey,
            std::function<bool(const std::string& apiKey)> onSave, std::function<void()> onCancel);

    protected:
        [[nodiscard]] float MeasureContentHeight(Core::Renderer& renderer, float contentWidth) override;
        void LayoutContent(const Core::RectF& contentArea) override;
        void FocusInitialControl() override;
        void OnSubmit() override;
        void OnCancel() override;

    private:
        void Save();
        void Cancel();
        void OpenKeyPage();
        void ShowHint();
        void ShowError(std::wstring message);

        Core::Platform& m_platform;
        Core::Notifier& m_notifier;
        APIKeyDialogMode m_mode;

        // 부품은 대화상자의 ControlHost가 소유 (참조는 배치 · 값 읽기용)
        UI::Label& m_infoLabel;
        UI::Button& m_linkButton;
        UI::TextBox& m_keyBox;
        UI::Label& m_statusLabel;     // 평소엔 저장 방식 안내, 잘못 입력하면 빨간 오류 문구
        UI::Button& m_saveButton;
        UI::Button& m_cancelButton;
        float m_infoHeight{};

        std::function<bool(const std::string&)> m_onSave;
        std::function<void()> m_onCancel;
    };
}﻿export module LostArkMultiTool.Core.APIKeyStore;

import std;

export namespace LostArkMultiTool::Core
{
    // API 키 저장소 인터페이스 (세 툴이 키 하나를 공유 → 한 번만 입력)
    class APIKeyStore
    {
    public:
        virtual ~APIKeyStore();

        // 저장된 키 (파일이 없거나, 다른 PC·계정에서 만든 파일이라 풀 수 없으면 nullopt → 다시 입력받음)
        [[nodiscard]] virtual std::optional<std::string> Load() const = 0;

        // 키를 암호화해서 저장 (실패하면 예외 → 입력 창에서 안내)
        virtual void Save(std::string_view apiKey) = 0;
    };
}﻿export module LostArkMultiTool.Views.Application;

import std;
import LostArkMultiTool.Core.APIKeyStore;
import LostArkMultiTool.Core.BackgroundTask;
import LostArkMultiTool.Core.Input;
import LostArkMultiTool.Core.IntervalTimer;
import LostArkMultiTool.Core.MarketAPI;
import LostArkMultiTool.Core.Renderer;
import LostArkMultiTool.Core.ServerConfigChecker;
import LostArkMultiTool.Core.ToolContext;
import LostArkMultiTool.Core.ToolManager;
import LostArkMultiTool.Models.ServerConfig;
import LostArkMultiTool.Views.APIKeyDialog;
import LostArkMultiTool.Views.DX11Renderer;
import LostArkMultiTool.Views.MainWindow;
import LostArkMultiTool.Views.UI.Button;
import LostArkMultiTool.Views.UI.ControlHost;
import LostArkMultiTool.Views.UI.Dialog;
import LostArkMultiTool.Views.UI.OverlayNotifier;

export namespace LostArkMultiTool::Views
{
    // 프로그램 본체 (xmind의 Main)
    // 창 · 렌더러 · 공용 서비스(API 키 · API · 알림)를 소유하고, 최상위 매니저 3종을 탭으로 전환하며
    // 매 프레임 갱신 · 그리기 · 입력 나눠 주기를 맡김 (구현 클래스를 만드는 곳은 여기 한 곳 → 매니저는 인터페이스만 앎)
    class Application final : public WindowEventHandler
    {
    public:
        Application();
        ~Application() override;

        Application(const Application&) = delete;
        Application& operator=(const Application&) = delete;

        // 창을 띄우고 닫힐 때까지 실행 (반환값: 프로그램 종료 코드)
        [[nodiscard]] int Run(int showCommand);

        // ===== WindowEventHandler =====
        void OnResize(int pixelWidth, int pixelHeight) override;
        void OnDPIChanged(float dpi) override;
        void OnInput(const Core::InputEvent& event) override;
        void OnTrayCommand(TrayCommand command) override;
        void OnHiddenToTray() override;

    private:
        static constexpr std::size_t TOOL_COUNT{ 7 };   // 귀속재료 계산기 · 보석 최저가 검색기 · 낙원력 트래커 · 유각 시세 검색기 · 악세 검색기 · 강화책 검색기 · 젬 시세 검색기

        // 마우스를 누른 곳 (뗄 때까지 같은 곳으로 입력을 보냄 → 탭 화면에서 끌다가 탭 막대로 넘어가도 끊기지 않음)
        enum class PointerOwner
        {
            POINTER_NONE,
            POINTER_HEADER,   // 탭 막대
            POINTER_TOOL      // 탭 내용
        };

        // ===== 매니저 =====
        void InitializeTools();
        void ShutdownTools();
        void SelectTool(std::size_t index);

        // ===== 원격 설정 (점검 스위치 · 업데이트 · 공지) =====
        void StartServerCheck(bool isStartup);   // isStartup: 실행 직후 확인 (확인 대화상자 표시)
        void FinishServerCheck();
        void LockForMaintenance(const std::optional<std::string>& maintenanceMessage);
        void ShowStartupNotices(const Models::ServerConfig& config);

        // ===== API 키 =====
        void OpenAPIKeyDialog(APIKeyDialogMode mode);
        [[nodiscard]] bool SaveAPIKey(const std::string& apiKey);

        // ===== 입력 =====
        [[nodiscard]] bool HandleShortcut(const Core::KeyEvent& event);
        void RouteInput(const Core::InputEvent& event);
        void RouteMouseButton(const Core::InputEvent& event, const Core::MouseButtonEvent& button);
        void SyncModalState();
        void UpdateCursor();

        // ===== 프레임 =====
        void Update(double deltaSeconds);
        void Render();
        void RenderTabBar();
        void LayoutHeader();

        [[nodiscard]] Core::RectF GetTabRect(std::size_t index) const noexcept;
        [[nodiscard]] float GetTabWidth() const noexcept;   // 탭 하나의 너비 (창이 좁으면 오른쪽 버튼을 가리지 않게 줄어듦)
