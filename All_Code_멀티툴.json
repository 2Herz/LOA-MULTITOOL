namespace LostArkMultiTool::Services
{
    MarketEngravingPriceService::MarketEngravingPriceService() = default;

    const std::vector<Models::EngravingQuote>& MarketEngravingPriceService::GetQuotes() const noexcept
    {
        return m_quotes;
    }

    const std::optional<std::int64_t>& MarketEngravingPriceService::GetLastUpdated() const noexcept
    {
        return m_lastUpdated;
    }

    // 거래소 각인서 카테고리 중 유물 등급만
    std::vector<Models::MarketItem> MarketEngravingPriceService::FetchQuotes(Core::MarketAPI& api) const
    {
        return api.SearchMarketItems(Core::APPConstants::ENGRAVING_CATEGORY_CODE, Core::APPConstants::RELIC_GRADE_NAME, std::string_view{});
    }

    // 새 결과로 바꾸면서 같은 이름의 이전 최저가를 등락 기준으로 기억
    void MarketEngravingPriceService::ApplyQuotes(std::vector<Models::MarketItem> items)
    {
        // 이름 → 이전 최저가 (매물이 없던 각인서는 비교 기준이 없으므로 제외)
        std::unordered_map<std::string, double> previousPrices;
        previousPrices.reserve(m_quotes.size());
        for (const Models::EngravingQuote& quote : m_quotes)
        {
            if (quote.GetCurrentMinPrice() > 0.0) previousPrices.emplace(quote.GetName(), quote.GetCurrentMinPrice());
        }

        std::vector<Models::EngravingQuote> quotes;
        quotes.reserve(items.size());
        for (Models::MarketItem& item : items)
        {
            const auto previous{ previousPrices.find(item.m_name) };
            Models::EngravingQuote& quote{ quotes.emplace_back(std::move(item)) };
            if (previous != previousPrices.end()) quote.SetPreviousMinPrice(previous->second);
        }

        m_quotes = std::move(quotes);
        m_lastUpdated = Core::LocalTime::GetUnixSeconds();
    }
}
module LostArkMultiTool.Services.MarketRefineBookPriceService;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.LocalTime;
import LostArkMultiTool.Core.MarketAPI;
import LostArkMultiTool.Core.RefineBookPriceService;
import LostArkMultiTool.Models.MarketItem;
import LostArkMultiTool.Models.RefineBookQuote;

namespace LostArkMultiTool::Services
{
    namespace
    {
        // ===== 표에 보여 줄 순서 (띄어쓰기를 뺀 이름, "{}" 자리에 야금술 · 재봉술) =====
        // 장인의 1~4단계 → 업화 [11-14] · [15-18] · [19-20] → 강화 업화 [19-20] → 전율 [12-15] · [16-19]
        constexpr std::size_t BOOK_ORDER_COUNT{ 10 };
        constexpr std::array<std::string_view, BOOK_ORDER_COUNT> BOOK_ORDER_FORMATS
        {
            "장인의{}:1단계", "장인의{}:2단계", "장인의{}:3단계", "장인의{}:4단계",
            "{}:업화[11-14]", "{}:업화[15-18]", "{}:업화[19-20]", "강화{}:업화[19-20]",
            "{}:전율[12-15]", "{}:전율[16-19]"
        };

        constexpr std::string_view IGNORED_CHARACTERS{ " \t" };   // 이름을 비교할 때 무시하는 글자

        // 띄어쓰기를 뺀 이름 ("야금술 : 업화 [15-18]" → "야금술:업화[15-18]")
        [[nodiscard]] std::string RemoveSpaces(std::string_view text)
        {
            std::string compact;
            compact.reserve(text.size());
            for (const char character : text)
            {
                if (!IGNORED_CHARACTERS.contains(character)) compact.push_back(character);
            }
            return compact;
        }

        // 정해 둔 순서의 번호 (목록에 없는 이름은 맨 뒤 → 받은 순서 유지)
        [[nodiscard]] std::size_t GetOrderIndex(std::string_view name, std::string_view keyword)
        {
            const std::string compactName{ RemoveSpaces(name) };
            for (std::size_t index{}; index < BOOK_ORDER_FORMATS.size(); ++index)
            {
                if (std::vformat(BOOK_ORDER_FORMATS[index], std::make_format_args(keyword)) == compactName) return index;
            }
            return BOOK_ORDER_FORMATS.size();
        }

        // 이름으로 종류 판정 (야금술 · 재봉술 둘 다 아니면 nullopt → 다른 재료는 버림)
        [[nodiscard]] std::optional<Models::RefineBookKind> FindKind(std::string_view name) noexcept
        {
            if (name.contains(Core::APPConstants::METALLURGY_KEYWORD)) return Models::RefineBookKind::BOOK_METALLURGY;
            if (name.contains(Core::APPConstants::TAILORING_KEYWORD)) return Models::RefineBookKind::BOOK_TAILORING;
            return std::nullopt;
        }

        [[nodiscard]] std::string_view GetKeyword(Models::RefineBookKind kind) noexcept
        {
            return kind == Models::RefineBookKind::BOOK_METALLURGY ? Core::APPConstants::METALLURGY_KEYWORD : Core::APPConstants::TAILORING_KEYWORD;
        }
    }

    MarketRefineBookPriceService::MarketRefineBookPriceService() = default;

    const std::vector<Models::RefineBookQuote>& MarketRefineBookPriceService::GetQuotes() const noexcept
    {
        return m_quotes;
    }

    const std::optional<std::int64_t>& MarketRefineBookPriceService::GetLastUpdated() const noexcept
    {
        return m_lastUpdated;
    }

    // 강화 재료 카테고리에서 "야금술" · "재봉술" 이름으로 각각 검색 (등급은 섞여 있으므로 조건 없이)
    std::vector<Models::MarketItem> MarketRefineBookPriceService::FetchQuotes(Core::MarketAPI& api) const
    {
        std::vector<Models::MarketItem> items{ api.SearchMarketItems(Core::APPConstants::REFINE_MATERIAL_CATEGORY_CODE,
            std::string_view{}, Core::APPConstants::METALLURGY_KEYWORD) };
        std::vector<Models::MarketItem> tailoringItems{ api.SearchMarketItems(Core::APPConstants::REFINE_MATERIAL_CATEGORY_CODE,
            std::string_view{}, Core::APPConstants::TAILORING_KEYWORD) };

        items.insert(items.end(), std::make_move_iterator(tailoringItems.begin()), std::make_move_iterator(tailoringItems.end()));
        return items;
    }

    // 종류로 나누고 정해 둔 순서로 정렬 + 같은 이름의 이전 최저가를 등락 기준으로 기억
    void MarketRefineBookPriceService::ApplyQuotes(std::vector<Models::MarketItem> items)
    {
        // 이름 → 이전 최저가 (매물이 없던 책은 비교 기준이 없으므로 제외)
        std::unordered_map<std::string, double> previousPrices;
        previousPrices.reserve(m_quotes.size());
        for (const Models::RefineBookQuote& quote : m_quotes)
        {
            if (quote.m_item.m_currentMinPrice > 0.0) previousPrices.emplace(quote.m_item.m_name, quote.m_item.m_currentMinPrice);
        }

        std::vector<Models::RefineBookQuote> quotes;
        quotes.reserve(items.size());
        std::unordered_set<std::string> seenNames;   // 두 검색 결과에 같은 책이 겹치면 한 번만
        for (Models::MarketItem& item : items)
        {
            const std::optional<Models::RefineBookKind> kind{ FindKind(item.m_name) };
            if (!kind.has_value() || !seenNames.insert(item.m_name).second) continue;

            const auto previous{ previousPrices.find(item.m_name) };
            quotes.push_back(Models::RefineBookQuote{ *kind, std::move(item),
                previous != previousPrices.end() ? std::optional<double>{ previous->second } : std::nullopt });
        }

        // 종류(야금술 → 재봉술) → 정해 둔 순서 (목록에 없는 책은 받은 순서대로 뒤에)
        std::ranges::stable_sort(quotes, [](const Models::RefineBookQuote& left, const Models::RefineBookQuote& right)
        {
            if (left.m_kind != right.m_kind) return left.m_kind < right.m_kind;
            return GetOrderIndex(left.m_item.m_name, GetKeyword(left.m_kind)) < GetOrderIndex(right.m_item.m_name, GetKeyword(right.m_kind));
        });

        m_quotes = std::move(quotes);
        m_lastUpdated = Core::LocalTime::GetUnixSeconds();
    }
}
﻿module LostArkMultiTool.Views.UI.MessageDialog;

import std;
import LostArkMultiTool.Core.Notifier;
import LostArkMultiTool.Core.Renderer;
import LostArkMultiTool.Views.Theme;
import LostArkMultiTool.Views.UI.Button;
import LostArkMultiTool.Views.UI.Dialog;
import LostArkMultiTool.Views.UI.Label;

namespace LostArkMultiTool::Views::UI
{
    namespace
    {
        constexpr float DIALOG_WIDTH{ 440.0f };
        constexpr float MESSAGE_MIN_HEIGHT{ 24.0f };
        constexpr float MESSAGE_MAX_HEIGHT{ 320.0f };   // 아주 긴 오류 문구도 창을 넘지 않게
        constexpr float BUTTON_WIDTH{ 96.0f };
        constexpr float BUTTON_GAP{ 8.0f };
        constexpr float BUTTON_ROW_GAP{ 20.0f };        // 문구와 버튼 줄 사이

        constexpr std::wstring_view OK_TEXT{ L"확인" };
        constexpr std::wstring_view YES_TEXT{ L"예" };
        constexpr std::wstring_view NO_TEXT{ L"아니요" };

        constexpr Core::TextStyle MESSAGE_STYLE{ Theme::FONT_SIZE_NORMAL, Core::FontWeight::NORMAL, Core::TextAlign::LEADING,
            Core::VerticalAlign::ALIGN_TOP, Core::TextWrap::WORD_WRAP };
    }

    MessageDialog::MessageDialog(std::wstring title, std::wstring message, Core::NoticeKind kind, MessageButtons buttons,
        std::function<void(bool isConfirmed)> onAnswer)
        : Dialog{ std::move(title), kind, DIALOG_WIDTH }
        , m_messageLabel{ GetHost().Emplace<Label>(std::move(message), MESSAGE_STYLE, Theme::TEXT_COLOR) }
        , m_confirmButton{ GetHost().Emplace<Button>(std::wstring{ buttons == MessageButtons::MESSAGE_YES_NO ? YES_TEXT : OK_TEXT },
            ButtonStyle::BUTTON_PRIMARY, [this] { Answer(true); }) }
        , m_onAnswer{ std::move(onAnswer) }
    {
        if (buttons == MessageButtons::MESSAGE_YES_NO)
        {
            m_declineButton = &GetHost().Emplace<Button>(std::wstring{ NO_TEXT }, ButtonStyle::BUTTON_SECONDARY, [this] { Answer(false); });
        }
    }

    float MessageDialog::MeasureContentHeight(Core::Renderer& renderer, float contentWidth)
    {
        m_messageHeight = std::clamp(m_messageLabel.MeasureHeight(renderer, contentWidth), MESSAGE_MIN_HEIGHT, MESSAGE_MAX_HEIGHT);
        return m_messageHeight + BUTTON_ROW_GAP + Theme::CONTROL_HEIGHT;
    }

    // 문구는 위, 버튼은 오른쪽 아래 ([예] [아니요] 순서)
    void MessageDialog::LayoutContent(const Core::RectF& contentArea)
    {
        m_messageLabel.SetBounds(Core::RectF{ contentArea.m_left, contentArea.m_top, contentArea.m_right, contentArea.m_top + m_messageHeight });

        const float buttonTop{ contentArea.m_bottom - Theme::CONTROL_HEIGHT };
        float buttonRight{ contentArea.m_right };
        if (m_declineButton != nullptr)
        {
            m_declineButton->SetBounds(Core::RectF{ buttonRight - BUTTON_WIDTH, buttonTop, buttonRight, contentArea.m_bottom });
            buttonRight -= BUTTON_WIDTH + BUTTON_GAP;
        }
        m_confirmButton.SetBounds(Core::RectF{ buttonRight - BUTTON_WIDTH, buttonTop, buttonRight, contentArea.m_bottom });
    }

    void MessageDialog::FocusInitialControl()
    {
        GetHost().SetFocus(&m_confirmButton);
    }

    void MessageDialog::OnSubmit()
    {
        Answer(true);
    }

    void MessageDialog::OnCancel()
    {
        Answer(m_declineButton == nullptr);   // 확인만 있으면 Esc도 확인, 예/아니요면 Esc = 아니요
    }

    void MessageDialog::Answer(bool isConfirmed)
    {
        if (IsClosed()) return;   // 두 번 눌러도 한 번만 응답

        Close();
        if (m_onAnswer) m_onAnswer(isConfirmed);   // 닫은 뒤에 알림 → 응답에서 새 대화상자를 열어도 순서가 맞음
    }
