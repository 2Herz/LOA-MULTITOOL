import std;
import LostArkMultiTool.Core.LocalTime;
import LostArkMultiTool.Core.Notifier;
import LostArkMultiTool.Core.Platform;
import LostArkMultiTool.Core.Renderer;
import LostArkMultiTool.Core.TextEncoding;
import LostArkMultiTool.Views.Theme;
import LostArkMultiTool.Views.UI.Button;
import LostArkMultiTool.Views.UI.Dialog;
import LostArkMultiTool.Views.UI.Label;
import LostArkMultiTool.Views.UI.TextBox;

namespace LostArkMultiTool::Views::UI
{
    namespace
    {
        // ===== 문구 =====
        constexpr std::wstring_view CONFIRM_TEXT{ L"확인" };
        constexpr std::wstring_view CANCEL_TEXT{ L"취소" };
        constexpr std::wstring_view START_LABEL_TEXT{ L"시작일 (수요일)" };
        constexpr std::wstring_view END_LABEL_TEXT{ L"종료일" };
        constexpr std::wstring_view DATE_PLACEHOLDER{ L"yyyy-MM-dd" };
        constexpr std::wstring_view FORMAT_HINT_TEXT{ L"날짜는 yyyy-MM-dd 형식으로 입력해 주세요. (예: 2026-11-12)" };
        constexpr std::wstring_view INVALID_START_TEXT{ L"시작일이 올바른 날짜가 아니에요!" };
        constexpr std::wstring_view INVALID_END_TEXT{ L"종료일이 올바른 날짜가 아니에요!" };
        constexpr std::wstring_view END_BEFORE_START_TEXT{ L"종료일은 시작일보다 뒤여야 해요!" };
        constexpr std::wstring_view PREVIEW_FORMAT{ L"총 {}주 · {} ~ {}" };
        constexpr std::wstring_view DATE_LABEL_FORMAT{ L"{:02}/{:02}({})" };
        constexpr std::array<std::wstring_view, 7> WEEKDAY_NAMES{ L"일", L"월", L"화", L"수", L"목", L"금", L"토" };   // c_encoding 순서 (일요일 = 0)

        // ===== 배치 (DIP) =====
        constexpr float DIALOG_WIDTH{ 420.0f };
        constexpr float LABEL_WIDTH{ 110.0f };
        constexpr float DATE_BOX_WIDTH{ 130.0f };
        constexpr float STATUS_HEIGHT{ 18.0f };
        constexpr float BUTTON_WIDTH{ 96.0f };
        constexpr float BUTTON_GAP{ 8.0f };
        constexpr float MESSAGE_BOX_GAP{ 12.0f };
        constexpr float ROW_GAP{ 8.0f };
        constexpr float BOX_STATUS_GAP{ 8.0f };
        constexpr float STATUS_BUTTON_GAP{ 18.0f };
        constexpr std::size_t DATE_MAX_LENGTH{ 10 };   // "yyyy-MM-dd"
        constexpr int DAYS_PER_WEEK{ 7 };

        constexpr Core::TextStyle MESSAGE_STYLE{ Theme::FONT_SIZE_NORMAL, Core::FontWeight::NORMAL, Core::TextAlign::LEADING,
            Core::VerticalAlign::ALIGN_TOP, Core::TextWrap::WORD_WRAP };
        constexpr Core::TextStyle FIELD_LABEL_STYLE{ Theme::FONT_SIZE_NORMAL, Core::FontWeight::NORMAL, Core::TextAlign::LEADING };
        constexpr Core::TextStyle STATUS_STYLE{ Theme::FONT_SIZE_SMALL, Core::FontWeight::NORMAL, Core::TextAlign::LEADING };

        // 날짜 칸에 받을 글자 (숫자 · 하이픈)
        [[nodiscard]] bool IsDateCharacter(wchar_t character) noexcept
        {
            return (character >= L'0' && character <= L'9') || character == L'-';
        }

        // 입력칸 글자 → 날짜 (형식이 다르면 nullopt)
        [[nodiscard]] std::optional<std::chrono::year_month_day> ParseDate(const std::wstring& text)
        {
            if (text.size() != DATE_MAX_LENGTH) return std::nullopt;
            return Core::LocalTime::ParseDateKey(Core::TextEncoding::WideToUTF8(text));
        }

        [[nodiscard]] std::wstring ToDateText(const std::chrono::year_month_day& date)
        {
            return Core::TextEncoding::UTF8ToWide(Core::LocalTime::MakeDateKey(date));
        }

        // "11/12(수)"
        [[nodiscard]] std::wstring ToDateLabel(const std::chrono::year_month_day& date)
        {
            const std::chrono::weekday weekday{ std::chrono::sys_days{ date } };
            return std::format(DATE_LABEL_FORMAT, static_cast<unsigned>(date.month()), static_cast<unsigned>(date.day()),
                WEEKDAY_NAMES.at(weekday.c_encoding()));
        }
    }

    DateRangeDialog::DateRangeDialog(Core::Platform& platform, std::wstring title, std::wstring message,
        const std::chrono::year_month_day& initialStart, const std::chrono::year_month_day& initialEnd, DateRangeConfirm onConfirm)
        : Dialog{ std::move(title), Core::NoticeKind::NOTICE_INFO, DIALOG_WIDTH }
        , m_messageLabel{ GetHost().Emplace<Label>(std::move(message), MESSAGE_STYLE, Theme::TEXT_COLOR) }
        , m_startLabel{ GetHost().Emplace<Label>(std::wstring{ START_LABEL_TEXT }, FIELD_LABEL_STYLE, Theme::TEXT_COLOR) }
        , m_startBox{ GetHost().Emplace<TextBox>(platform, std::wstring{ DATE_PLACEHOLDER }) }
        , m_endLabel{ GetHost().Emplace<Label>(std::wstring{ END_LABEL_TEXT }, FIELD_LABEL_STYLE, Theme::TEXT_COLOR) }
        , m_endBox{ GetHost().Emplace<TextBox>(platform, std::wstring{ DATE_PLACEHOLDER }) }
        , m_statusLabel{ GetHost().Emplace<Label>(std::wstring{}, STATUS_STYLE, Theme::MUTED_TEXT_COLOR) }
        , m_confirmButton{ GetHost().Emplace<Button>(std::wstring{ CONFIRM_TEXT }, ButtonStyle::BUTTON_PRIMARY, [this] { Confirm(); }) }
        , m_cancelButton{ GetHost().Emplace<Button>(std::wstring{ CANCEL_TEXT }, ButtonStyle::BUTTON_SECONDARY, [this] { Cancel(); }) }
        , m_onConfirm{ std::move(onConfirm) }
    {
        // 날짜 전용 칸: IME 끔 (한/영 상태와 상관없이 숫자 입력), 숫자 · 하이픈만, Enter = 확인
        for (TextBox* box : { &m_startBox, &m_endBox })
        {
            box->SetIMEAllowed(false);
            box->SetInputFilter(IsDateCharacter);
            box->SetMaxLength(DATE_MAX_LENGTH);
            box->SetOnTextChanged([this] { ShowPreview(); });
            box->SetOnSubmit([this] { Confirm(); });
        }
        m_startBox.SetText(ToDateText(initialStart));
        m_endBox.SetText(ToDateText(initialEnd));

        ShowPreview();
    }

    float DateRangeDialog::MeasureContentHeight(Core::Renderer& renderer, float contentWidth)
    {
        m_messageHeight = m_messageLabel.MeasureHeight(renderer, contentWidth);
        return m_messageHeight + MESSAGE_BOX_GAP + Theme::CONTROL_HEIGHT + ROW_GAP + Theme::CONTROL_HEIGHT
            + BOX_STATUS_GAP + STATUS_HEIGHT + STATUS_BUTTON_GAP + Theme::CONTROL_HEIGHT;
    }

    // 안내 → [시작일 칸] → [종료일 칸] → 미리보기/오류 → 버튼 (위에서 아래로)
    void DateRangeDialog::LayoutContent(const Core::RectF& contentArea)
    {
        float top{ contentArea.m_top };
        m_messageLabel.SetBounds(Core::RectF{ contentArea.m_left, top, contentArea.m_right, top + m_messageHeight });

        // 날짜 줄 하나: 왼쪽 이름표 + 오른쪽 입력칸
        const float boxLeft{ contentArea.m_left + LABEL_WIDTH };
        const auto placeRow{ [&](Label& label, TextBox& box, float rowTop)
        {
            label.SetBounds(Core::RectF{ contentArea.m_left, rowTop, boxLeft, rowTop + Theme::CONTROL_HEIGHT });
            box.SetBounds(Core::RectF{ boxLeft, rowTop, boxLeft + DATE_BOX_WIDTH, rowTop + Theme::CONTROL_HEIGHT });
        } };

        top += m_messageHeight + MESSAGE_BOX_GAP;
        placeRow(m_startLabel, m_startBox, top);
        top += Theme::CONTROL_HEIGHT + ROW_GAP;
        placeRow(m_endLabel, m_endBox, top);

        top += Theme::CONTROL_HEIGHT + BOX_STATUS_GAP;
        m_statusLabel.SetBounds(Core::RectF{ contentArea.m_left, top, contentArea.m_right, top + STATUS_HEIGHT });

        const float buttonTop{ contentArea.m_bottom - Theme::CONTROL_HEIGHT };
        const float cancelLeft{ contentArea.m_right - BUTTON_WIDTH };
        m_cancelButton.SetBounds(Core::RectF{ cancelLeft, buttonTop, contentArea.m_right, contentArea.m_bottom });

        const float confirmRight{ cancelLeft - BUTTON_GAP };
        m_confirmButton.SetBounds(Core::RectF{ confirmRight - BUTTON_WIDTH, buttonTop, confirmRight, contentArea.m_bottom });
    }

    // 시작일 칸부터 (전체 선택 → 바로 입력하면 교체)
    void DateRangeDialog::FocusInitialControl()
    {
        GetHost().SetFocus(&m_startBox);
        m_startBox.SelectAll();
    }

    void DateRangeDialog::OnSubmit()
    {
        Confirm();
    }

    void DateRangeDialog::OnCancel()
    {
        Cancel();
    }

    void DateRangeDialog::Confirm()
    {
        if (IsClosed()) return;

        const std::optional<std::chrono::year_month_day> startDate{ ParseDate(m_startBox.GetText()) };
        if (!startDate.has_value())
        {
            ShowError(std::wstring{ INVALID_START_TEXT });
            GetHost().SetFocus(&m_startBox);
            return;
        }
        const std::optional<std::chrono::year_month_day> endDate{ ParseDate(m_endBox.GetText()) };
        if (!endDate.has_value())
        {
            ShowError(std::wstring{ INVALID_END_TEXT });
            GetHost().SetFocus(&m_endBox);
            return;
        }
        if (std::chrono::sys_days{ *endDate } < std::chrono::sys_days{ *startDate })
        {
            ShowError(std::wstring{ END_BEFORE_START_TEXT });
            GetHost().SetFocus(&m_endBox);
            return;
        }

        // 받는 쪽이 거절하면(예: 시작일이 수요일이 아님) 창을 열어 둔 채 다시 고를 수 있게
        if (m_onConfirm)
        {
            if (std::optional<std::wstring> error{ m_onConfirm(*startDate, *endDate) }; error.has_value())
            {
                ShowError(std::move(*error));
                GetHost().SetFocus(&m_startBox);
                m_startBox.SelectAll();
                return;
            }
        }
        Close();
    }

    void DateRangeDialog::Cancel()
    {
        if (!IsClosed()) Close();
    }

    void DateRangeDialog::ShowPreview()
    {
        m_statusLabel.SetColor(Theme::MUTED_TEXT_COLOR);

        const std::optional<std::chrono::year_month_day> startDate{ ParseDate(m_startBox.GetText()) };
        const std::optional<std::chrono::year_month_day> endDate{ ParseDate(m_endBox.GetText()) };
        if (!startDate.has_value() || !endDate.has_value() || std::chrono::sys_days{ *endDate } < std::chrono::sys_days{ *startDate })
        {
            m_statusLabel.SetText(std::wstring{ FORMAT_HINT_TEXT });
            return;
        }

        // 주 수 = (종료일 - 시작일) ÷ 7 + 1 (낙원력 트래커 Season과 같은 계산)
        const auto days{ (std::chrono::sys_days{ *endDate } - std::chrono::sys_days{ *startDate }).count() };
        m_statusLabel.SetText(std::format(PREVIEW_FORMAT, days / DAYS_PER_WEEK + 1, ToDateLabel(*startDate), ToDateLabel(*endDate)));
    }

    void DateRangeDialog::ShowError(std::wstring message)
    {
        m_statusLabel.SetText(std::move(message));
        m_statusLabel.SetColor(Theme::NOTICE_ERROR_COLOR);
    }
}
﻿module LostArkMultiTool.Views.UI.Dialog;

import std;
import LostArkMultiTool.Core.Input;
import LostArkMultiTool.Core.Notifier;
import LostArkMultiTool.Core.Renderer;
import LostArkMultiTool.Views.Theme;
import LostArkMultiTool.Views.UI.ControlHost;

namespace LostArkMultiTool::Views::UI
{
    namespace
    {
        constexpr float PANEL_PADDING{ 20.0f };          // 패널 안쪽 여백
        constexpr float TITLE_HEIGHT{ 28.0f };
        constexpr float TITLE_GAP{ 12.0f };              // 제목과 내용 사이
        constexpr float ACCENT_BAR_WIDTH{ 4.0f };        // 제목 왼쪽 색 막대 (알림 종류 표시)
        constexpr float ACCENT_BAR_HEIGHT{ 16.0f };
        constexpr float ACCENT_BAR_GAP{ 10.0f };
        constexpr float ACCENT_BAR_RADIUS{ 2.0f };
        constexpr float SCREEN_MARGIN{ 24.0f };          // 창이 작을 때 패널과 창 가장자리 사이 최소 여백
        constexpr float HALF{ 0.5f };
        constexpr float BOTH_SIDES{ 2.0f };               // 여백을 양쪽(왼쪽 · 오른쪽 또는 위 · 아래)에 적용

        constexpr double FADE_IN_SECONDS{ 0.15 };
        constexpr float FULL_OPACITY{ 1.0f };

        constexpr Core::TextStyle TITLE_STYLE{ Theme::FONT_SIZE_DIALOG_TITLE, Core::FontWeight::BOLD, Core::TextAlign::LEADING };
    }

    Dialog::Dialog(std::wstring title, Core::NoticeKind kind, float width)
        : m_title{ std::move(title) }
        , m_kind{ kind }
        , m_width{ width }
    {}

    Dialog::~Dialog() = default;

    void Dialog::Update(double deltaSeconds)
    {
        m_ageSeconds += deltaSeconds;
        if (!m_isClosed) m_host.Update(deltaSeconds);
    }

    void Dialog::Render(Core::Renderer& renderer, const Core::RectF& screenArea)
    {
        UpdateLayout(renderer, screenArea);

        const float opacity{ GetOpacity() };
        renderer.FillRect(screenArea, Core::WithAlpha(Theme::OVERLAY_DIM_COLOR, Theme::OVERLAY_DIM_COLOR.m_alpha * opacity));

        const Core::OpacityScope fade{ renderer, opacity };
        renderer.FillRoundedRect(m_panelRect, Theme::PANEL_CORNER_RADIUS, Theme::PANEL_BACK_COLOR);
        renderer.DrawRoundedRect(m_panelRect, Theme::PANEL_CORNER_RADIUS, Theme::PANEL_BORDER_COLOR, Theme::BORDER_WIDTH);

        // 제목 (왼쪽 색 막대 = 알림 종류)
        const float titleTop{ m_panelRect.m_top + PANEL_PADDING };
        const float barTop{ titleTop + (TITLE_HEIGHT - ACCENT_BAR_HEIGHT) * HALF };
        const Core::RectF accentBar{ m_panelRect.m_left + PANEL_PADDING, barTop, m_panelRect.m_left + PANEL_PADDING + ACCENT_BAR_WIDTH, barTop + ACCENT_BAR_HEIGHT };
        renderer.FillRoundedRect(accentBar, ACCENT_BAR_RADIUS, Theme::GetNoticeColor(m_kind));

        const Core::RectF titleRect{ accentBar.m_right + ACCENT_BAR_GAP, titleTop, m_panelRect.m_right - PANEL_PADDING, titleTop + TITLE_HEIGHT };
        renderer.DrawString(m_title, titleRect, Theme::HEADER_TEXT_COLOR, TITLE_STYLE);

        m_host.Render(renderer);
    }

    bool Dialog::HandleInput(const Core::InputEvent& event)
    {
        if (m_isClosed) return true;   // 닫히는 중에는 아무 입력도 받지 않음 (모달 유지)

        if (m_host.HandleInput(event)) return true;

        // 부품이 쓰지 않은 Enter · Esc → 대화상자 기본 동작
        if (const auto* key{ std::get_if<Core::KeyEvent>(&event) }; key != nullptr)
        {
            if (key->m_key == Core::Key::KEY_ENTER) OnSubmit();
            else if (key->m_key == Core::Key::KEY_ESCAPE) OnCancel();
        }
        return true;   // 모달: 대화상자 밖으로 입력이 새지 않음
    }

    void Dialog::Close()
    {
        if (m_isClosed) return;

        m_isClosed = true;
        m_host.SuspendFocus();   // 조합 중인 글자 확정 · IME 끔
    }

    bool Dialog::IsClosed() const noexcept
    {
        return m_isClosed;
    }

    void Dialog::Activate()
    {
        if (m_isClosed) return;

        if (!m_isActivated)
        {
            m_isActivated = true;
            FocusInitialControl();
            return;
        }
        m_host.RestoreFocus();
    }

    void Dialog::Deactivate()
    {
        m_host.SuspendFocus();
    }

    Core::CursorShape Dialog::GetCursor() const noexcept
    {
        return m_isClosed ? Core::CursorShape::CURSOR_ARROW : m_host.GetCursor();
    }

    ControlHost& Dialog::GetHost() noexcept
    {
        return m_host;
    }

    void Dialog::FocusInitialControl()
    {
        m_host.FocusNext(false);
    }

    void Dialog::OnSubmit()
    {}

    void Dialog::OnCancel()
    {}

    // 화면 크기가 바뀌었을 때만 패널 크기 · 내용 배치를 다시 계산 (글자 높이 측정이 필요해 그리기 단계에서)
    void Dialog::UpdateLayout(Core::Renderer& renderer, const Core::RectF& screenArea)
    {
        if (m_hasLayout && m_layoutScreen == screenArea) return;

        const float panelWidth{ std::min(m_width, std::max(0.0f, screenArea.GetWidth() - SCREEN_MARGIN * BOTH_SIDES)) };
        const float contentWidth{ std::max(0.0f, panelWidth - PANEL_PADDING * BOTH_SIDES) };
        const float contentHeight{ MeasureContentHeight(renderer, contentWidth) };
        const float panelHeight{ PANEL_PADDING + TITLE_HEIGHT + TITLE_GAP + contentHeight + PANEL_PADDING };

        const float panelLeft{ screenArea.m_left + (screenArea.GetWidth() - panelWidth) * HALF };
        const float panelTop{ screenArea.m_top + std::max(SCREEN_MARGIN, (screenArea.GetHeight() - panelHeight) * HALF) };
        m_panelRect = Core::RectF{ panelLeft, panelTop, panelLeft + panelWidth, panelTop + panelHeight };

        const float contentTop{ panelTop + PANEL_PADDING + TITLE_HEIGHT + TITLE_GAP };
        LayoutContent(Core::RectF{ panelLeft + PANEL_PADDING, contentTop, panelLeft + PANEL_PADDING + contentWidth, contentTop + contentHeight });

        m_layoutScreen = screenArea;
        m_hasLayout = true;
    }

    float Dialog::GetOpacity() const noexcept
    {
        return static_cast<float>(std::min(m_ageSeconds / FADE_IN_SECONDS, static_cast<double>(FULL_OPACITY)));
    }
}﻿module;

#define NOMINMAX
#define WIN32_LEAN_AND_MEAN
#define NOUSER   // winuser.h 제외: GetClassName 같은 매크로 충돌 방지
#include <Windows.h>
#include <wincrypt.h>   // DATA_BLOB (WIN32_LEAN_AND_MEAN이 빼므로 직접 포함)
#include <dpapi.h>      // CryptProtectData, CryptUnprotectData

#pragma comment(lib, "crypt32.lib")

module LostArkMultiTool.Services.DPAPIKeyStore;

import std;
import LostArkMultiTool.Core.APPConstants;

namespace LostArkMultiTool::Services
{
    namespace
    {
        constexpr const wchar_t* KEY_DESCRIPTION{ L"LostArkMultiTool API Key" };   // 암호화 데이터에 함께 저장되는 설명

        // DPAPI가 LocalAlloc으로 만들어 준 출력 버퍼를 자동 해제 (해제 전에 내용을 지워 키가 메모리에 남지 않게 함)
        class LocalBlob
        {
        public:
            LocalBlob() noexcept = default;

            ~LocalBlob()
            {
                if (m_blob.pbData == nullptr) return;

                ::SecureZeroMemory(m_blob.pbData, m_blob.cbData);
                ::LocalFree(m_blob.pbData);
            }

            LocalBlob(const LocalBlob&) = delete;
            LocalBlob& operator=(const LocalBlob&) = delete;

            [[nodiscard]] DATA_BLOB* GetAddress() noexcept
            {
                return &m_blob;
            }

            [[nodiscard]] std::string_view GetBytes() const noexcept
            {
                return { reinterpret_cast<const char*>(m_blob.pbData), m_blob.cbData };
            }

        private:
            DATA_BLOB m_blob{};
        };

        // 입력 바이트를 DATA_BLOB으로 (DPAPI는 입력을 읽기만 하지만 선언이 non-const라서 const_cast 필요)
        DATA_BLOB MakeInputBlob(std::string_view bytes) noexcept
        {
            return DATA_BLOB{ static_cast<DWORD>(bytes.size()), reinterpret_cast<BYTE*>(const_cast<char*>(bytes.data())) };
        }

        void WriteBinaryFile(const std::filesystem::path& path, std::string_view bytes)
        {
            std::ofstream out{ path, std::ios::binary | std::ios::trunc };
            if (!out) throw std::runtime_error{ "API 키 파일을 열지 못했어요!" };

            out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
            out.close();
            if (out.fail()) throw std::runtime_error{ "API 키 파일 쓰기에 실패했어요!" };
        }
    }

    DPAPIKeyStore::DPAPIKeyStore()
        : m_keyPath{ Core::APPConstants::GetUserDataFilePath(Core::APPConstants::API_KEY_FILE_NAME) }
    {}

    std::optional<std::string> DPAPIKeyStore::Load() const
    {
        std::error_code errorCode;
        if (!std::filesystem::exists(m_keyPath, errorCode)) return std::nullopt;   // 첫 실행

        std::ifstream in{ m_keyPath, std::ios::binary };
        if (!in) return std::nullopt;   // 읽을 수 없음 · 권한 문제 → 종료하지 않고 다시 입력받음

        const std::string encrypted{ std::istreambuf_iterator<char>{ in }, std::istreambuf_iterator<char>{} };
        DATA_BLOB input{ MakeInputBlob(encrypted) };
        DATA_BLOB entropy{ MakeInputBlob(Core::APPConstants::KEY_ENTROPY_TEXT) };
        LocalBlob plain;

        // 다른 PC·계정에서 만든 파일이거나 깨진 파일이면 복호화 실패 → 다시 입력받음 (원본과 같음)
        if (!::CryptUnprotectData(&input, nullptr, &entropy, nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, plain.GetAddress()))
        {
            return std::nullopt;
        }
        return std::string{ plain.GetBytes() };
    }

    void DPAPIKeyStore::Save(std::string_view apiKey)
    {
        DATA_BLOB input{ MakeInputBlob(apiKey) };
        DATA_BLOB entropy{ MakeInputBlob(Core::APPConstants::KEY_ENTROPY_TEXT) };
        LocalBlob encrypted;

        if (!::CryptProtectData(&input, KEY_DESCRIPTION, &entropy, nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, encrypted.GetAddress()))
        {
            throw std::runtime_error{ std::format("API 키 암호화에 실패했어요! (코드 {})", ::GetLastError()) };
        }

        std::filesystem::create_directories(m_keyPath.parent_path());   // 폴더가 없으면 생성

        // 임시 파일에 먼저 쓰고 한 번에 교체 → 중간에 종료돼도 기존 키 파일이 깨지지 않음 (원본 보석 검색기와 같음)
        std::filesystem::path tempPath{ m_keyPath };
        tempPath += Core::APPConstants::TEMP_FILE_SUFFIX;

        WriteBinaryFile(tempPath, encrypted.GetBytes());
        std::filesystem::rename(tempPath, m_keyPath);   // 기존 키 파일이 있으면 교체됨
    }
}﻿module;

