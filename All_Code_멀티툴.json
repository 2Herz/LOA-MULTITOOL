}module LostArkMultiTool.Services.JSONBoundGemRepository;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.BoundGemRepository;
import LostArkMultiTool.Models.BoundGemData;
import LostArkMultiTool.Models.BoundGemRosterData;
import LostArkMultiTool.Services.JSONFileStore;
import LostArkMultiTool.Services.JSONValue;

namespace LostArkMultiTool::Services
{
    namespace
    {
        // ===== JSON 키 =====
        constexpr std::string_view KEY_CHARACTERS{ "Characters" };
        constexpr std::string_view KEY_CLASS_NAME{ "ClassName" };
        constexpr std::string_view KEY_ITEM_LEVEL{ "ItemLevel" };
        constexpr std::string_view KEY_QUANTITIES{ "Quantities" };
        constexpr std::string_view KEY_NAME{ "Name" };
        constexpr std::string_view KEY_GRADE{ "Grade" };
        constexpr std::string_view KEY_COUNT{ "Count" };
        constexpr std::string_view KEY_HISTORY{ "History" };   // { "yyyy-MM-dd": 원정대 총 가치 }

        // 이름 목록에서 번호 찾기 (없으면 nullopt → 모르는 항목은 건너뜀)
        template <std::size_t Count>
        [[nodiscard]] std::optional<std::size_t> FindIndex(const std::array<std::string_view, Count>& names, std::string_view name) noexcept
        {
            const auto found{ std::ranges::find(names, name) };
            if (found == names.end()) return std::nullopt;
            return static_cast<std::size_t>(std::distance(names.begin(), found));
        }

        // 수량 목록 JSON → 모델 (없거나 배열이 아니면 빈 수량)
        [[nodiscard]] Models::BoundGemData ReadQuantities(const JSONValue& quantities)
        {
            Models::BoundGemData data;
            for (const JSONValue& entry : quantities.GetItems())
            {
                const std::optional<std::size_t> gemIndex{ FindIndex(Models::BoundGemData::GEM_NAMES, entry.FindMember(KEY_NAME).GetString()) };
                const std::optional<std::size_t> gradeIndex{ FindIndex(Models::BoundGemData::GRADE_NAMES, entry.FindMember(KEY_GRADE).GetString()) };
                if (!gemIndex.has_value() || !gradeIndex.has_value()) continue;

                const double count{ std::clamp(entry.FindMember(KEY_COUNT).GetNumber(), 0.0, static_cast<double>(Core::APPConstants::MAX_BOUND_GEM_COUNT)) };
                data.SetQuantity(*gemIndex, *gradeIndex, static_cast<int>(count));
            }
            return data;
        }

        // JSON → 모델 (최상위가 객체가 아니면 예외 → JSONFileStore가 손상으로 처리)
        [[nodiscard]] Models::BoundGemRosterData ReadData(const JSONValue& root)
        {
            if (root.GetType() != JSONType::OBJECT_VALUE) throw std::runtime_error{ "귀속 젬 저장 파일 형식이 올바르지 않습니다." };

            Models::BoundGemRosterData data;
            for (const JSONValue& entry : root.FindMember(KEY_CHARACTERS).GetItems())
            {
                const std::string& name{ entry.FindMember(KEY_NAME).GetString() };
                if (name.empty()) continue;   // 이름 없는 캐릭터는 건너뜀

                const JSONValue& className{ entry.FindMember(KEY_CLASS_NAME) };
                data.AddCharacter(Models::BoundGemCharacter{ name,
                    className.GetType() == JSONType::STRING_VALUE ? std::optional<std::string>{ className.GetString() } : std::nullopt,
                    entry.FindMember(KEY_ITEM_LEVEL).GetNumber(),
                    ReadQuantities(entry.FindMember(KEY_QUANTITIES)) });
            }

            // 캐릭터별 저장 이전 파일 (최상위 "Quantities") → 공용 수량
            data.GetUnassigned() = ReadQuantities(root.FindMember(KEY_QUANTITIES));

            // 날짜별 원정대 총 가치 (없으면 빈 기록)
            const JSONValue& history{ root.FindMember(KEY_HISTORY) };
            const std::vector<std::string>& dateKeys{ history.GetKeys() };
            const std::vector<JSONValue>& values{ history.GetValues() };
            for (std::size_t index{}; index < std::min(dateKeys.size(), values.size()); ++index)
            {
                if (values[index].GetType() == JSONType::NUMBER_VALUE) data.RecordHistory(dateKeys[index], values[index].GetNumber());
            }
            return data;
        }

        // 수량 모델 → JSON 배열 (0개는 빼서 파일을 짧게)
        [[nodiscard]] JSONValue BuildQuantities(const Models::BoundGemData& data)
        {
            std::vector<JSONValue> entries;
            for (std::size_t gemIndex{}; gemIndex < Models::BoundGemData::GEM_COUNT; ++gemIndex)
            {
                for (std::size_t gradeIndex{}; gradeIndex < Models::BoundGemData::GRADE_COUNT; ++gradeIndex)
                {
                    const int quantity{ data.GetQuantity(gemIndex, gradeIndex) };
                    if (quantity <= 0) continue;

                    entries.push_back(JSONValue::CreateObject(
                        { std::string{ KEY_NAME }, std::string{ KEY_GRADE }, std::string{ KEY_COUNT } },
                        { JSONValue::CreateString(std::string{ Models::BoundGemData::GEM_NAMES[gemIndex] }),
                          JSONValue::CreateString(std::string{ Models::BoundGemData::GRADE_NAMES[gradeIndex] }),
                          JSONValue::CreateNumber(static_cast<double>(quantity)) }));
                }
            }
            return JSONValue::CreateArray(std::move(entries));
        }

        // 모델 → JSON 텍스트 (직업이 없으면 키 생략, 공용 수량은 남아 있을 때만)
        [[nodiscard]] std::string BuildJSONText(const Models::BoundGemRosterData& data)
        {
            std::vector<JSONValue> characters;
            characters.reserve(data.GetCharacters().size());
            for (const Models::BoundGemCharacter& character : data.GetCharacters())
            {
                std::vector<std::string> keys{ std::string{ KEY_NAME } };
                std::vector<JSONValue> values{ JSONValue::CreateString(character.m_name) };
                if (character.m_className.has_value())
                {
                    keys.emplace_back(KEY_CLASS_NAME);
                    values.push_back(JSONValue::CreateString(*character.m_className));
                }
                keys.emplace_back(KEY_ITEM_LEVEL);
                values.push_back(JSONValue::CreateNumber(character.m_itemLevel));
                keys.emplace_back(KEY_QUANTITIES);
                values.push_back(BuildQuantities(character.m_quantities));
                characters.push_back(JSONValue::CreateObject(std::move(keys), std::move(values)));
            }

            std::vector<std::string> rootKeys{ std::string{ KEY_CHARACTERS } };
            std::vector<JSONValue> rootValues{ JSONValue::CreateArray(std::move(characters)) };
            if (data.HasUnassigned())
            {
                rootKeys.emplace_back(KEY_QUANTITIES);
                rootValues.push_back(BuildQuantities(data.GetUnassigned()));
            }

            // 날짜별 원정대 총 가치
            std::vector<std::string> historyKeys;
            std::vector<JSONValue> historyValues;
            for (const auto& [dateKey, value] : data.GetHistory())
            {
                historyKeys.push_back(dateKey);
                historyValues.push_back(JSONValue::CreateNumber(value));
            }
            rootKeys.emplace_back(KEY_HISTORY);
            rootValues.push_back(JSONValue::CreateObject(std::move(historyKeys), std::move(historyValues)));
            return WriteJSONText(JSONValue::CreateObject(std::move(rootKeys), std::move(rootValues)));
        }
    }

    JSONBoundGemRepository::JSONBoundGemRepository()
        : m_fileStore{ Core::APPConstants::BOUND_GEM_DATA_FILE_NAME }
    {
        // 변환이 끝까지 성공한 파일만 반영 (실패하면 백업으로 다시 시도, 둘 다 없으면 빈 데이터)
        std::optional<Models::BoundGemRosterData> loaded;
        JSONLoadResult result{ m_fileStore.Load([&loaded](const JSONValue& root) { loaded = ReadData(root); }) };
        m_loadWarning = std::move(result.m_warning);
        if (loaded.has_value()) m_data = std::move(*loaded);
    }

    Models::BoundGemRosterData& JSONBoundGemRepository::GetData()
    {
        return m_data;
    }

    const Models::BoundGemRosterData& JSONBoundGemRepository::GetData() const
    {
        return m_data;
    }

    const std::optional<std::string>& JSONBoundGemRepository::GetLoadWarning() const noexcept
    {
        return m_loadWarning;
    }

    void JSONBoundGemRepository::Save()
    {
        m_fileStore.Save(BuildJSONText(m_data));
    }
}
﻿module LostArkMultiTool.Services.JSONDataRepository;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.LocalTime;
import LostArkMultiTool.Models.Character;
import LostArkMultiTool.Models.ItemData;
import LostArkMultiTool.Models.UserData;
import LostArkMultiTool.Services.JSONFileStore;
import LostArkMultiTool.Services.JSONValue;

namespace LostArkMultiTool::Services
{
    namespace
    {
        // ===== 저장 파일 키 이름 (원본 C# 저장 파일과 같아야 옛 기록을 그대로 읽음) =====
        constexpr std::string_view KEY_CHARACTERS{ "Characters" };
        constexpr std::string_view KEY_HISTORY{ "History" };
        constexpr std::string_view KEY_CLASS_NAME{ "ClassName" };
        constexpr std::string_view KEY_ITEM_LEVEL{ "ItemLevel" };
        constexpr std::string_view KEY_MATERIALS{ "Materials" };
        constexpr std::string_view KEY_TOP_QTY{ "TopQty" };
        constexpr std::string_view KEY_BOTTOM_QTY{ "BottomQty" };
        constexpr std::string_view KEY_PREVIOUS_TOP_QTY{ "PrevTopQty" };         // 멀티툴에서 추가 (원본 파일에는 없음 → 없으면 현재 수량)
        constexpr std::string_view KEY_PREVIOUS_BOTTOM_QTY{ "PrevBottomQty" };

        constexpr std::string_view STRUCTURE_ERROR_MESSAGE{ "저장 파일 구조가 올바르지 않습니다." };

        // ===== 쓰기 형식 =====
        constexpr unsigned CONTROL_CHAR_LIMIT{ 0x20 };
        constexpr std::size_t INDENT_WIDTH{ 2 };
        constexpr std::size_t ROOT_DEPTH{ 0 };
        constexpr std::size_t ROOT_MEMBER_DEPTH{ 1 };
        constexpr std::string_view HEX_DIGITS{ "0123456789abcdef" };
        constexpr unsigned NIBBLE_BITS{ 4 };
        constexpr unsigned NIBBLE_MASK{ 0xF };

        // ===== 읽기: JSONValue 트리 → 모델 (구조가 어긋나면 예외 → JSONFileStore가 손상으로 처리) =====
        [[noreturn]] void ThrowStructureError()
        {
            throw std::runtime_error{ std::string{ STRUCTURE_ERROR_MESSAGE } };
        }

        // 없는 키도 FindMember가 null을 돌려주므로 "없음"과 "null"은 같은 취급 (원본 C# 기본값과 같음)
        bool IsNullOrMissing(const JSONValue& value) noexcept
        {
            return value.GetType() == JSONType::NULL_VALUE;
        }

        void RequireType(const JSONValue& value, JSONType expected)
        {
            if (value.GetType() != expected) ThrowStructureError();
        }

        // 숫자 멤버 읽기 (없거나 null이면 기본값, 숫자가 아니면 구조 오류)
        double ReadNumberMember(const JSONValue& object, std::string_view key, double fallback)
        {
            const JSONValue& value{ object.FindMember(key) };
            if (IsNullOrMissing(value)) return fallback;

            RequireType(value, JSONType::NUMBER_VALUE);
            return value.GetNumber();
        }

        std::optional<std::string> ReadNullableString(const JSONValue& value)
        {
            if (IsNullOrMissing(value)) return std::nullopt;

            RequireType(value, JSONType::STRING_VALUE);
            return value.GetString();
        }

        Models::ItemData ReadItem(const JSONValue& itemValue)
        {
            Models::ItemData item;
            if (IsNullOrMissing(itemValue)) return item;   // null 재료는 빈 값 (원본 EnsureMaterials와 같은 결과)

            RequireType(itemValue, JSONType::OBJECT_VALUE);
            item.SetTopQty(ReadNumberMember(itemValue, KEY_TOP_QTY, item.GetTopQty()));
            item.SetBottomQty(ReadNumberMember(itemValue, KEY_BOTTOM_QTY, item.GetBottomQty()));

            // 직전 수량이 없는 옛 파일은 지금 수량 그대로 (증감 0으로 시작)
            item.SetPreviousTopQty(ReadNumberMember(itemValue, KEY_PREVIOUS_TOP_QTY, item.GetTopQty()));
            item.SetPreviousBottomQty(ReadNumberMember(itemValue, KEY_PREVIOUS_BOTTOM_QTY, item.GetBottomQty()));
            return item;
        }

        std::unordered_map<std::string, Models::ItemData> ReadMaterials(const JSONValue& materialsValue)
        {
            std::unordered_map<std::string, Models::ItemData> materials;
            if (IsNullOrMissing(materialsValue)) return materials;

            RequireType(materialsValue, JSONType::OBJECT_VALUE);
            for (const auto& [key, value] : std::views::zip(materialsValue.GetKeys(), materialsValue.GetValues()))
            {
                materials.insert_or_assign(key, ReadItem(value));
            }
            return materials;
        }

        Models::Character ReadCharacter(const JSONValue& characterValue)
        {
            Models::Character character;   // 생성자가 전체 재료 키를 채움
            if (IsNullOrMissing(characterValue)) return character;   // null 캐릭터는 새 캐릭터로 (원본과 같음)

            RequireType(characterValue, JSONType::OBJECT_VALUE);
            character.SetClassName(ReadNullableString(characterValue.FindMember(KEY_CLASS_NAME)));
            character.SetItemLevel(ReadNumberMember(characterValue, KEY_ITEM_LEVEL, character.GetItemLevel()));
            character.SetMaterials(ReadMaterials(characterValue.FindMember(KEY_MATERIALS)));   // 빠진 재료 키는 SetMaterials가 채움
            return character;
        }

        Models::UserData ReadUserData(const JSONValue& root)
        {
            RequireType(root, JSONType::OBJECT_VALUE);

            std::unordered_map<std::string, Models::Character> characters;
            const JSONValue& charactersValue{ root.FindMember(KEY_CHARACTERS) };
            if (!IsNullOrMissing(charactersValue))
            {
                RequireType(charactersValue, JSONType::OBJECT_VALUE);
                for (const auto& [name, value] : std::views::zip(charactersValue.GetKeys(), charactersValue.GetValues()))
                {
                    characters.insert_or_assign(name, ReadCharacter(value));
                }
            }

            std::map<std::string, double> history;
            const JSONValue& historyValue{ root.FindMember(KEY_HISTORY) };
            if (!IsNullOrMissing(historyValue))
            {
                RequireType(historyValue, JSONType::OBJECT_VALUE);
                for (const auto& [date, value] : std::views::zip(historyValue.GetKeys(), historyValue.GetValues()))
                {
                    RequireType(value, JSONType::NUMBER_VALUE);
                    history.insert_or_assign(date, value.GetNumber());
                }
            }

            Models::UserData data;
            data.SetCharacters(std::move(characters));
            data.SetHistory(std::move(history));
            return data;
        }

        // ===== 쓰기 =====
        void AppendIndent(std::string& out, std::size_t depth)
        {
            out.append(depth * INDENT_WIDTH, ' ');
        }

        void AppendQuoted(std::string& out, std::string_view text)
        {
            out.push_back('"');
            for (const char c : text)
            {
                switch (c)
                {
                    case '"':  out += "\\\""; break;
                    case '\\': out += "\\\\"; break;
                    case '\n': out += "\\n"; break;
                    case '\r': out += "\\r"; break;
                    case '\t': out += "\\t"; break;
                    default:
                        if (static_cast<unsigned char>(c) < CONTROL_CHAR_LIMIT)
                        {
                            // \u00XX 형식을 직접 만듦 (std::format 없이 16진수 두 자리)
                            const auto value{ static_cast<unsigned char>(c) };
                            out += "\\u00";
                            out.push_back(HEX_DIGITS[static_cast<std::size_t>(value >> NIBBLE_BITS)]);
                            out.push_back(HEX_DIGITS[static_cast<std::size_t>(value & NIBBLE_MASK)]);
                        }
                        else
                        {
                            out.push_back(c);   // 한글 등 UTF-8 바이트는 그대로 씀 (원본과 같음)
                        }
                        break;
                }
            }
            out.push_back('"');
        }

        // 객체 멤버 하나 시작 (첫 멤버는 쉼표 없이)
        void AppendMemberPrefix(std::string& out, bool& isFirst, std::size_t depth)
        {
            out += isFirst ? "\n" : ",\n";
            isFirst = false;
            AppendIndent(out, depth);
        }

        // 객체 닫기 (객체 자신의 들여쓰기 depth 기준)
        void AppendMemberClose(std::string& out, bool isFirst, std::size_t depth)
        {
            if (!isFirst)
            {
                out.push_back('\n');
                AppendIndent(out, depth);
            }
            out.push_back('}');
        }

        std::string FormatNumber(double value)
        {
            return std::format("{}", value);
        }

        void AppendItem(std::string& out, const Models::ItemData& item, std::size_t depth)
        {
            out.push_back('{');
            bool isFirst{ true };

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_TOP_QTY);
            out += ": " + FormatNumber(item.GetTopQty());

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_BOTTOM_QTY);
            out += ": " + FormatNumber(item.GetBottomQty());

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_PREVIOUS_TOP_QTY);
            out += ": " + FormatNumber(item.GetPreviousTopQty());

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_PREVIOUS_BOTTOM_QTY);
            out += ": " + FormatNumber(item.GetPreviousBottomQty());

            AppendMemberClose(out, isFirst, depth);
        }

        void AppendMaterials(std::string& out, const Models::Character& character, std::size_t depth)
        {
            out.push_back('{');
            bool isFirst{ true };

            for (const std::string_view key : Core::APPConstants::MAT_KEYS)
            {
                if (key.empty()) continue;

                AppendMemberPrefix(out, isFirst, depth + 1);
                AppendQuoted(out, key);
                out += ": ";
                AppendItem(out, character.GetMaterial(key), depth + 1);
            }

            AppendMemberClose(out, isFirst, depth);
        }

        void AppendCharacter(std::string& out, const Models::Character& character, std::size_t depth)
        {
            out.push_back('{');
            bool isFirst{ true };

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_CLASS_NAME);
            out += ": ";
            if (character.GetClassName().has_value()) AppendQuoted(out, *character.GetClassName());
            else out += "null";

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_ITEM_LEVEL);
            out += ": " + FormatNumber(character.GetItemLevel());

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_MATERIALS);
            out += ": ";
            AppendMaterials(out, character, depth + 1);

            AppendMemberClose(out, isFirst, depth);
        }

        void AppendCharacters(std::string& out, const Models::UserData& data, std::size_t depth)
        {
            const auto& characters{ data.GetCharacters() };

            // 저장 순서를 고정하려고 이름순 정렬
            std::vector<std::string_view> names;
            names.reserve(characters.size());
            for (const auto& entry : characters) names.push_back(entry.first);
            std::sort(names.begin(), names.end());

            out.push_back('{');
            bool isFirst{ true };
            for (const std::string_view name : names)
            {
                AppendMemberPrefix(out, isFirst, depth + 1);
                AppendQuoted(out, name);
                out += ": ";
                AppendCharacter(out, characters.at(std::string{ name }), depth + 1);
            }
            AppendMemberClose(out, isFirst, depth);
        }

        void AppendHistory(std::string& out, const Models::UserData& data, std::size_t depth)
        {
            out.push_back('{');
            bool isFirst{ true };
            for (const auto& entry : data.GetHistory())   // std::map이라 이미 날짜순
            {
                AppendMemberPrefix(out, isFirst, depth + 1);
                AppendQuoted(out, entry.first);
                out += ": " + FormatNumber(entry.second);
            }
            AppendMemberClose(out, isFirst, depth);
        }

        std::string BuildJSONText(const Models::UserData& data)
        {
            std::string out;
            out.push_back('{');
            bool isFirst{ true };

            AppendMemberPrefix(out, isFirst, ROOT_MEMBER_DEPTH);
            AppendQuoted(out, KEY_CHARACTERS);
            out += ": ";
            AppendCharacters(out, data, ROOT_MEMBER_DEPTH);

            AppendMemberPrefix(out, isFirst, ROOT_MEMBER_DEPTH);
            AppendQuoted(out, KEY_HISTORY);
            out += ": ";
            AppendHistory(out, data, ROOT_MEMBER_DEPTH);

            AppendMemberClose(out, isFirst, ROOT_DEPTH);
            out.push_back('\n');
            return out;
        }
    }

    JSONDataRepository::JSONDataRepository()
        // 예전 버전은 실행 파일 폴더에 저장했음 → 사용자 데이터 폴더에 파일이 없으면 그 파일을 한 번 가져옴
        : m_fileStore{ Core::APPConstants::ROSTER_DATA_FILE_NAME, { Core::APPConstants::GetDataFilePath(Core::APPConstants::ROSTER_DATA_FILE_NAME) } }
    {
        // 변환이 끝까지 성공한 파일만 반영 (중간에 실패하면 loaded는 그대로 → 백업 파일로 다시 시도)
        std::optional<Models::UserData> loaded;
        JSONLoadResult result{ m_fileStore.Load([&loaded](const JSONValue& root) {
            Models::UserData data{ ReadUserData(root) };
            data.MigrateLegacyHistory(Core::LocalTime::GetLocalToday());
            loaded = std::move(data);
        }) };
        m_loadWarning = std::move(result.m_warning);

        m_data = loaded.has_value() ? std::move(*loaded) : Models::UserData{};

        // 캐릭터가 하나도 없으면 기본 캐릭터 추가 (원본과 같음)
        if (m_data.GetCharacters().empty())
        {
            auto characters{ m_data.GetCharacters() };
            characters.try_emplace(std::string{ Core::APPConstants::DEFAULT_CHARACTER_NAME }, Models::Character{});
            m_data.SetCharacters(std::move(characters));
        }

        // 가져온 기록은 바로 새 위치에 저장 (실패해도 메모리의 값은 유지 → 다음 저장 때 다시 시도, 다음 실행 때 다시 가져옴)
        if (!result.m_isImported) return;
        try
        {
            Save();
        }
        catch (const std::exception&)
        {
            // 안내는 손상 · 가져오기 문구로 이미 표시됨 (저장 실패는 다음 저장에서 사용자에게 알림)
        }
    }

    Models::UserData& JSONDataRepository::GetData()
    {
        return m_data;
    }

    const Models::UserData& JSONDataRepository::GetData() const
    {
        return m_data;
    }

    const std::optional<std::string>& JSONDataRepository::GetLoadWarning() const noexcept
    {
        return m_loadWarning;
    }

    void JSONDataRepository::Save()
    {
        m_fileStore.Save(BuildJSONText(m_data));
    }
}﻿module;

#define NOMINMAX
#define WIN32_LEAN_AND_MEAN
#define NOUSER   // winuser.h 제외: GetClassName 같은 매크로 충돌 방지
#include <Windows.h>

module LostArkMultiTool.Services.JSONFileStore;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.LocalTime;
import LostArkMultiTool.Core.TextEncoding;
import LostArkMultiTool.Services.JSONValue;

namespace LostArkMultiTool::Services
{
    namespace
    {
        constexpr std::string_view UTF8_BOM{ "\xEF\xBB\xBF" };
        constexpr std::string_view CORRUPT_FILE_SUFFIX{ ".corrupt_" };
        constexpr std::string_view UNKNOWN_PATH_TEXT{ "(경로를 표시할 수 없음)" };

        // 파일 읽기 결과 상태
        enum class LoadStatus
        {
            NOT_FOUND,
            LOADED,
            CORRUPTED
        };

        // 경로 뒤에 접미사를 붙인 새 경로 ("...json" → "...json.bak")
        std::filesystem::path AppendSuffix(const std::filesystem::path& path, std::string_view suffix)
        {
            std::filesystem::path result{ path };
            result += suffix;
            return result;
        }

        // 경로 → 안내 문구용 UTF-8 (한글 경로가 깨지지 않도록 UTF-16 → UTF-8)
        std::string ToDisplayPath(const std::filesystem::path& path)
        {
            try
            {
                return Core::TextEncoding::WideToUTF8(path.wstring());
            }
            catch (const std::exception&)
            {
                return std::string{ UNKNOWN_PATH_TEXT };
            }
        }

        // 파일 전체를 문자열로 읽음 (UTF-8 BOM은 제거)
        std::string ReadTextFile(const std::filesystem::path& path)
        {
            std::ifstream in{ path, std::ios::binary };
            if (!in) throw std::runtime_error{ "저장 파일을 열지 못했습니다." };

            std::string text{ std::istreambuf_iterator<char>{ in }, std::istreambuf_iterator<char>{} };
            if (std::string_view{ text }.starts_with(UTF8_BOM)) text.erase(0, UTF8_BOM.size());
            return text;
        }

        void WriteTextFile(const std::filesystem::path& path, const std::string& text)
        {
            std::ofstream out{ path, std::ios::binary | std::ios::trunc };
            if (!out) throw std::runtime_error{ "저장 파일을 열지 못했습니다." };

            out << text;
            out.close();
            if (out.fail()) throw std::runtime_error{ "저장 파일 쓰기에 실패했습니다." };
        }

        // 파일 읽기: 없음 / 성공 / 손상 구분 (파싱이나 onLoaded 변환이 실패하면 예외 없이 CORRUPTED)
        LoadStatus TryLoad(const std::filesystem::path& path, const std::function<void(const JSONValue&)>& onLoaded)
        {
            std::error_code errorCode;
            if (!std::filesystem::exists(path, errorCode)) return LoadStatus::NOT_FOUND;

            try
            {
                onLoaded(ParseJSONText(ReadTextFile(path)));
                return LoadStatus::LOADED;
            }
            catch (const std::exception&)
            {
                return LoadStatus::CORRUPTED;
            }
        }

        // 손상본은 별도 이름으로 보관하고, 본 파일 자리는 비움 → 보관 위치(또는 실패 사유) 반환
        std::string PreserveCorruptFile(const std::filesystem::path& savePath)
        {
            std::filesystem::path corruptPath{ AppendSuffix(savePath, CORRUPT_FILE_SUFFIX) };
            corruptPath += Core::LocalTime::MakeTimestamp();

            try
            {
                std::filesystem::rename(savePath, corruptPath);
                return ToDisplayPath(corruptPath);
            }
            catch (const std::filesystem::filesystem_error& error)
            {
                return std::format("(보관 실패: {})", error.what());
            }
        }
    }

    JSONFileStore::JSONFileStore(std::string_view fileName, std::vector<std::filesystem::path> importPaths)
        : m_savePath{ Core::APPConstants::GetUserDataFilePath(fileName) }
        , m_backupPath{ AppendSuffix(m_savePath, Core::APPConstants::BACKUP_FILE_SUFFIX) }
        , m_tempPath{ AppendSuffix(m_savePath, Core::APPConstants::TEMP_FILE_SUFFIX) }
        , m_importPaths{ std::move(importPaths) }
    {}

    JSONLoadResult JSONFileStore::Load(const std::function<void(const JSONValue&)>& onLoaded)
    {
        const LoadStatus status{ TryLoad(m_savePath, onLoaded) };
        if (status == LoadStatus::LOADED) return {};

        // 저장 파일이 없음: 처음 실행 → 이전 위치 · 다른 프로그램의 파일을 한 번만 가져옴
        if (status == LoadStatus::NOT_FOUND)
        {
            std::optional<std::string> importMessage{ TryImport(onLoaded) };
            const bool isImported{ importMessage.has_value() };
            return JSONLoadResult{ std::move(importMessage), isImported };
        }

        // 손상본을 먼저 치워야 다음 저장 때 .bak이 손상본으로 덮어써지지 않음
        const std::string corruptLocation{ PreserveCorruptFile(m_savePath) };
        const bool isRecovered{ TryLoad(m_backupPath, onLoaded) == LoadStatus::LOADED };

        return JSONLoadResult{ isRecovered
            ? std::format("저장 파일이 손상되어 백업에서 복구했습니다.\n손상된 원본: {}", corruptLocation)
            : std::format("저장 파일이 손상되어 새로 시작합니다.\n손상된 원본: {}", corruptLocation) };
    }

    void JSONFileStore::Save(const std::string& jsonText)
    {
        // 0) 사용자 데이터 폴더가 아직 없으면 만듦 (첫 저장)
        std::filesystem::create_directories(m_savePath.parent_path());

        // 1) 임시 파일에 먼저 전부 씀 (여기서 실패하면 기존 저장본은 그대로)
        WriteTextFile(m_tempPath, jsonText);

        // 2) 처음 저장이면 그냥 이름 변경
        if (!std::filesystem::exists(m_savePath))
        {
            std::filesystem::rename(m_tempPath, m_savePath);
            return;
        }

        // 3) 기존 저장본은 .bak으로 보관하면서 원자적으로 교체 (원본 File.Replace와 같은 역할)
        if (::ReplaceFileW(m_savePath.c_str(), m_tempPath.c_str(), m_backupPath.c_str(), 0, nullptr, nullptr)) return;

        // 4) 교체가 막히면(교체를 지원하지 않는 드라이브 등) 복사로 대신함 (원본 IOException 대응)
        //    덮어쓰기 전에 기존 저장본을 .bak으로 복사 → 대체 경로에서도 직전 저장본이 남아 손상 시 복구할 수 있음
        std::filesystem::copy_file(m_savePath, m_backupPath, std::filesystem::copy_options::overwrite_existing);
        std::filesystem::copy_file(m_tempPath, m_savePath, std::filesystem::copy_options::overwrite_existing);
        std::filesystem::remove(m_tempPath);
    }

    std::optional<std::string> JSONFileStore::TryImport(const std::function<void(const JSONValue&)>& onLoaded) const
    {
        for (const std::filesystem::path& importPath : m_importPaths)
        {
            // 본 파일 → 그 파일의 백업 순서 (없거나 손상이면 다음 후보, 가져온 파일은 읽기만 함)
            const std::array<std::filesystem::path, 2> candidates{ importPath, AppendSuffix(importPath, Core::APPConstants::BACKUP_FILE_SUFFIX) };
            for (const std::filesystem::path& candidate : candidates)
            {
                if (TryLoad(candidate, onLoaded) != LoadStatus::LOADED) continue;

                return std::format("이전 기록을 가져왔습니다.\n가져온 파일: {}\n(원본 파일은 그대로 남아 있어요)", ToDisplayPath(candidate));
            }
        }
        return std::nullopt;
    }
}
﻿module LostArkMultiTool.Services.JSONGemDataRepository;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.LocalTime;
import LostArkMultiTool.Models.GemData;
import LostArkMultiTool.Models.PriceAlarm;
import LostArkMultiTool.Models.RefreshSettings;
import LostArkMultiTool.Services.JSONFileStore;
import LostArkMultiTool.Services.JSONValue;

namespace LostArkMultiTool::Services
{
    namespace
    {
        // ===== 저장 파일 키 이름 (원본 GemData.json과 같은 구조) =====
        constexpr std::string_view KEY_ALARMS{ "Alarms" };
        constexpr std::string_view KEY_TYPE_NAME{ "TypeName" };
        constexpr std::string_view KEY_LEVEL{ "Level" };
        constexpr std::string_view KEY_TARGET_PRICE{ "TargetPrice" };
        constexpr std::string_view KEY_IS_TRIGGERED{ "IsTriggered" };
        constexpr std::string_view KEY_LAST_PRICES{ "LastPrices" };
        constexpr std::string_view KEY_HISTORY{ "History" };
        constexpr std::string_view KEY_SETTINGS{ "Settings" };
        constexpr std::string_view KEY_WATCH_INTERVAL{ "WatchIntervalSeconds" };
        constexpr std::string_view KEY_FULL_INTERVAL{ "FullIntervalMinutes" };
        constexpr std::string_view KEY_AUTO_REFRESH{ "IsAutoRefreshEnabled" };

        constexpr std::string_view STRUCTURE_ERROR_MESSAGE{ "보석 저장 파일 구조가 올바르지 않습니다." };

        // ===== 읽기: JSONValue 트리 → 모델 (구조가 어긋나면 예외 → JSONFileStore가 손상으로 처리) =====
        [[noreturn]] void ThrowStructureError()
        {
            throw std::runtime_error{ std::string{ STRUCTURE_ERROR_MESSAGE } };
        }

        bool IsNullOrMissing(const JSONValue& value) noexcept
        {
            return value.GetType() == JSONType::NULL_VALUE;
        }

        void RequireType(const JSONValue& value, JSONType expected)
        {
            if (value.GetType() != expected) ThrowStructureError();
        }

        // 숫자 멤버 (없거나 null이면 기본값, 숫자가 아니면 구조 오류)
        double ReadNumber(const JSONValue& object, std::string_view key, double fallback)
        {
            const JSONValue& value{ object.FindMember(key) };
            if (IsNullOrMissing(value)) return fallback;

            RequireType(value, JSONType::NUMBER_VALUE);
            return value.GetNumber();
        }

        bool ReadBool(const JSONValue& object, std::string_view key, bool fallback)
        {
            const JSONValue& value{ object.FindMember(key) };
            if (IsNullOrMissing(value)) return fallback;

            RequireType(value, JSONType::BOOL_VALUE);
            return value.GetBool();
        }

        std::string ReadString(const JSONValue& object, std::string_view key)
        {
            const JSONValue& value{ object.FindMember(key) };
            if (IsNullOrMissing(value)) return {};

            RequireType(value, JSONType::STRING_VALUE);
            return value.GetString();
        }

        std::int64_t ToPrice(const JSONValue& value)
        {
            RequireType(value, JSONType::NUMBER_VALUE);
            return std::llround(value.GetNumber());
        }

        void ReadAlarms(const JSONValue& alarmsValue, std::vector<Models::PriceAlarm>& alarms)
        {
            if (IsNullOrMissing(alarmsValue)) return;
            RequireType(alarmsValue, JSONType::ARRAY_VALUE);

            for (const JSONValue& alarmValue : alarmsValue.GetItems())
            {
                if (IsNullOrMissing(alarmValue)) continue;   // null 알림은 건너뜀 (원본 RemoveAll(a is null))
                RequireType(alarmValue, JSONType::OBJECT_VALUE);

                Models::PriceAlarm alarm{
                    Models::GemSelection{ ReadString(alarmValue, KEY_TYPE_NAME), static_cast<int>(ReadNumber(alarmValue, KEY_LEVEL, 0.0)) },
                    std::llround(ReadNumber(alarmValue, KEY_TARGET_PRICE, 0.0)) };
                alarm.SetTriggered(ReadBool(alarmValue, KEY_IS_TRIGGERED, false));
                alarms.push_back(std::move(alarm));
            }
        }

        void ReadLastPrices(const JSONValue& pricesValue, std::map<std::string, std::int64_t>& lastPrices)
        {
            if (IsNullOrMissing(pricesValue)) return;
            RequireType(pricesValue, JSONType::OBJECT_VALUE);

            for (const auto& [gemKey, price] : std::views::zip(pricesValue.GetKeys(), pricesValue.GetValues()))
            {
                lastPrices.insert_or_assign(gemKey, ToPrice(price));
            }
        }

        void ReadHistory(const JSONValue& historyValue, std::map<std::string, std::map<std::string, std::int64_t>>& history)
        {
            if (IsNullOrMissing(historyValue)) return;
            RequireType(historyValue, JSONType::OBJECT_VALUE);

            for (const auto& [gemKey, daysValue] : std::views::zip(historyValue.GetKeys(), historyValue.GetValues()))
            {
                std::map<std::string, std::int64_t>& days{ history[gemKey] };   // null이면 빈 기록 (원본과 같음)
                if (IsNullOrMissing(daysValue)) continue;

                RequireType(daysValue, JSONType::OBJECT_VALUE);
                for (const auto& [dateKey, price] : std::views::zip(daysValue.GetKeys(), daysValue.GetValues()))
                {
                    days.insert_or_assign(dateKey, ToPrice(price));
                }
            }
        }

        Models::RefreshSettings ReadSettings(const JSONValue& settingsValue)
        {
            Models::RefreshSettings settings;
            if (IsNullOrMissing(settingsValue)) return settings;
            RequireType(settingsValue, JSONType::OBJECT_VALUE);

            settings.SetWatchIntervalSeconds(static_cast<int>(ReadNumber(settingsValue, KEY_WATCH_INTERVAL, settings.GetWatchIntervalSeconds())));
            settings.SetFullIntervalMinutes(static_cast<int>(ReadNumber(settingsValue, KEY_FULL_INTERVAL, settings.GetFullIntervalMinutes())));
            settings.SetAutoRefreshEnabled(ReadBool(settingsValue, KEY_AUTO_REFRESH, settings.IsAutoRefreshEnabled()));
            return settings;
        }

        Models::GemData ReadGemData(const JSONValue& root)
        {
            RequireType(root, JSONType::OBJECT_VALUE);

            Models::GemData data;
            ReadAlarms(root.FindMember(KEY_ALARMS), data.GetAlarms());
            ReadLastPrices(root.FindMember(KEY_LAST_PRICES), data.GetLastPrices());
            ReadHistory(root.FindMember(KEY_HISTORY), data.GetHistory());
            data.SetSettings(ReadSettings(root.FindMember(KEY_SETTINGS)));
            return data;
        }

        // ===== 쓰기: 모델 → JSONValue 트리 (키 순서 = 원본 C# 속성 순서) =====
        JSONValue MakeNumber(std::int64_t value)
        {
            return JSONValue::CreateNumber(static_cast<double>(value));
        }

        JSONValue WriteAlarms(const std::vector<Models::PriceAlarm>& alarms)
        {
            std::vector<JSONValue> items;
            items.reserve(alarms.size());
            for (const Models::PriceAlarm& alarm : alarms)
            {
                items.push_back(JSONValue::CreateObject(
                    { std::string{ KEY_TYPE_NAME }, std::string{ KEY_LEVEL }, std::string{ KEY_TARGET_PRICE }, std::string{ KEY_IS_TRIGGERED } },
                    { JSONValue::CreateString(alarm.GetGem().m_typeName), MakeNumber(alarm.GetGem().m_level),
                      MakeNumber(alarm.GetTargetPrice()), JSONValue::CreateBool(alarm.IsTriggered()) }));
            }
            return JSONValue::CreateArray(std::move(items));
        }

        JSONValue WritePriceMap(const std::map<std::string, std::int64_t>& prices)
        {
            std::vector<std::string> keys;
            std::vector<JSONValue> values;
            keys.reserve(prices.size());
            values.reserve(prices.size());
            for (const auto& [key, price] : prices)   // 정렬 맵이라 저장 순서가 고정됨 (날짜는 날짜순)
            {
                keys.push_back(key);
                values.push_back(MakeNumber(price));
            }
            return JSONValue::CreateObject(std::move(keys), std::move(values));
        }

        JSONValue WriteHistory(const std::map<std::string, std::map<std::string, std::int64_t>>& history)
        {
            std::vector<std::string> keys;
            std::vector<JSONValue> values;
            for (const auto& [gemKey, days] : history)
            {
                keys.push_back(gemKey);
                values.push_back(WritePriceMap(days));
            }
            return JSONValue::CreateObject(std::move(keys), std::move(values));
        }

        JSONValue WriteSettings(const Models::RefreshSettings& settings)
        {
            return JSONValue::CreateObject(
                { std::string{ KEY_WATCH_INTERVAL }, std::string{ KEY_FULL_INTERVAL }, std::string{ KEY_AUTO_REFRESH } },
                { MakeNumber(settings.GetWatchIntervalSeconds()), MakeNumber(settings.GetFullIntervalMinutes()),
                  JSONValue::CreateBool(settings.IsAutoRefreshEnabled()) });
        }

        std::string BuildJSONText(const Models::GemData& data)
        {
            return WriteJSONText(JSONValue::CreateObject(
                { std::string{ KEY_ALARMS }, std::string{ KEY_LAST_PRICES }, std::string{ KEY_HISTORY }, std::string{ KEY_SETTINGS } },
                { WriteAlarms(data.GetAlarms()), WritePriceMap(data.GetLastPrices()), WriteHistory(data.GetHistory()),
                  WriteSettings(data.GetSettings()) }));
        }
    }

    JSONGemDataRepository::JSONGemDataRepository()
        // 예전 버전은 실행 파일 폴더에 저장했음 → 사용자 데이터 폴더에 파일이 없으면 그 파일을 한 번 가져옴
        : m_fileStore{ Core::APPConstants::GEM_DATA_FILE_NAME, { Core::APPConstants::GetDataFilePath(Core::APPConstants::GEM_DATA_FILE_NAME) } }
    {
        // 변환이 끝까지 성공한 파일만 반영 (중간에 실패하면 loaded는 그대로 → 백업 파일로 다시 시도)
        std::optional<Models::GemData> loaded;
        JSONLoadResult result{ m_fileStore.Load([&loaded](const JSONValue& root) { loaded = ReadGemData(root); }) };
        m_loadWarning = std::move(result.m_warning);

        m_data = loaded.has_value() ? std::move(*loaded) : Models::GemData{};   // 첫 실행 또는 복구 실패
        m_data.Normalize();

        // 오래된 기록 · 조회 범위 밖 기록 정리 (다음 저장 때 반영, 원본과 같음 / 날짜는 오전 6시 기준 하루)
        const auto oldestKept{ Core::LocalTime::AddDays(Core::LocalTime::GetGameToday(), -Core::APPConstants::HISTORY_KEEP_DAYS) };
        static_cast<void>(m_data.Prune(Core::LocalTime::MakeDateKey(oldestKept)));

        // 가져온 기록은 바로 새 위치에 저장 (실패해도 메모리의 값은 유지 → 다음 저장 때 다시 시도, 다음 실행 때 다시 가져옴)
        if (!result.m_isImported) return;
        try
        {
            Save();
        }
        catch (const std::exception&)
        {
            // 안내는 가져오기 문구로 이미 표시됨 (저장 실패는 다음 저장에서 사용자에게 알림)
        }
    }

    Models::GemData& JSONGemDataRepository::GetData()
    {
        return m_data;
    }

    const Models::GemData& JSONGemDataRepository::GetData() const
    {
        return m_data;
    }

    const std::optional<std::string>& JSONGemDataRepository::GetLoadWarning() const noexcept
    {
        return m_loadWarning;
    }

    void JSONGemDataRepository::Save()
    {
        m_fileStore.Save(BuildJSONText(m_data));
    }
}module LostArkMultiTool.Services.JSONGrowthDataRepository;

import std;
import LostArkMultiTool.Core.APPConstants;
import LostArkMultiTool.Core.LocalTime;
import LostArkMultiTool.Models.CharacterInfo;
import LostArkMultiTool.Models.GrowthData;
import LostArkMultiTool.Models.Season;
import LostArkMultiTool.Models.WeeklyRecord;
import LostArkMultiTool.Services.JSONFileStore;
import LostArkMultiTool.Services.JSONValue;

namespace LostArkMultiTool::Services
{
    namespace
    {
        // ===== 저장 파일 키 이름 (원본 RosterGrowthData_v2.json과 같은 구조 → 원본 파일을 그대로 읽음) =====
        constexpr std::string_view KEY_DATA_VERSION{ "DataVersion" };
        constexpr std::string_view KEY_CHARACTERS{ "Characters" };
        constexpr std::string_view KEY_SEASONS{ "Seasons" };
        constexpr std::string_view KEY_SELECTED_SEASON{ "SelectedSeasonNumber" };
        constexpr std::string_view KEY_LEGACY_RECORDS{ "Records" };   // v1: 루트의 주차 목록 (읽기만)
        constexpr std::string_view KEY_SERVER_NAME{ "ServerName" };
        constexpr std::string_view KEY_CHARACTER_NAME{ "CharacterName" };
        constexpr std::string_view KEY_CLASS_NAME{ "CharacterClassName" };
        constexpr std::string_view KEY_ITEM_MAX_LEVEL{ "ItemMaxLevel" };
        constexpr std::string_view KEY_ITEM_AVG_LEVEL{ "ItemAvgLevel" };
        constexpr std::string_view KEY_SEASON_NUMBER{ "SeasonNumber" };
        constexpr std::string_view KEY_RECORDS{ "Records" };
        constexpr std::string_view KEY_WEEK_NUMBER{ "WeekNumber" };
        constexpr std::string_view KEY_SCORES{ "Scores" };
        constexpr std::string_view KEY_START_DATE{ "StartDate" };   // 시즌 기간 (시즌 5부터, "yyyy-MM-dd")
        constexpr std::string_view KEY_END_DATE{ "EndDate" };

        constexpr std::string_view STRUCTURE_ERROR_MESSAGE{ "낙원력 저장 파일 구조가 올바르지 않습니다." };

        // ===== 읽기: JSONValue 트리 → 모델 (구조가 어긋나면 예외 → JSONFileStore가 손상으로 처리) =====
        [[noreturn]] void ThrowStructureError()
        {
            throw std::runtime_error{ std::string{ STRUCTURE_ERROR_MESSAGE } };
        }

        bool IsNullOrMissing(const JSONValue& value) noexcept
        {
            return value.GetType() == JSONType::NULL_VALUE;
        }

        void RequireType(const JSONValue& value, JSONType expected)
        {
            if (value.GetType() != expected) ThrowStructureError();
        }

        // 숫자 멤버 (없거나 null이면 기본값, 숫자가 아니면 구조 오류)
        double ReadNumber(const JSONValue& object, std::string_view key, double fallback)
        {
            const JSONValue& value{ object.FindMember(key) };
            if (IsNullOrMissing(value)) return fallback;

            RequireType(value, JSONType::NUMBER_VALUE);
            return value.GetNumber();
        }

        int ReadInteger(const JSONValue& object, std::string_view key, int fallback)
        {
            return static_cast<int>(std::lround(ReadNumber(object, key, static_cast<double>(fallback))));
        }

        // 문자열 또는 숫자로 온 값을 글자로 (원본 object 속성 → ToString과 같음, 없으면 nullopt)
        std::optional<std::string> ReadOptionalText(const JSONValue& object, std::string_view key)
        {
            const JSONValue& value{ object.FindMember(key) };
            switch (value.GetType())
            {
                case JSONType::STRING_VALUE:
                    return value.GetString();
                case JSONType::NUMBER_VALUE:
                {
                    // 편집기의 consteval 형식 검사를 거치지 않도록 런타임 포맷 사용 (결과는 std::format과 같음)
                    const double number{ value.GetNumber() };
                    return std::vformat("{}", std::make_format_args(number));
                }
                case JSONType::NULL_VALUE:
                    return std::nullopt;
                default:
                    ThrowStructureError();
            }
        }

        std::vector<Models::CharacterInfo> ReadCharacters(const JSONValue& charactersValue)
        {
            std::vector<Models::CharacterInfo> characters;
            if (IsNullOrMissing(charactersValue)) return characters;
            RequireType(charactersValue, JSONType::ARRAY_VALUE);

            for (const JSONValue& characterValue : charactersValue.GetItems())
            {
                if (IsNullOrMissing(characterValue)) continue;   // null 캐릭터는 건너뜀 (원본 RemoveAll(c is null))
                RequireType(characterValue, JSONType::OBJECT_VALUE);

                characters.emplace_back(
                    ReadOptionalText(characterValue, KEY_CHARACTER_NAME).value_or(std::string{}),
                    ReadOptionalText(characterValue, KEY_CLASS_NAME),
                    ReadOptionalText(characterValue, KEY_ITEM_MAX_LEVEL),
                    ReadOptionalText(characterValue, KEY_ITEM_AVG_LEVEL),
                    ReadOptionalText(characterValue, KEY_SERVER_NAME));
            }
            return characters;
        }

        Models::WeeklyRecord ReadRecord(const JSONValue& recordValue)
        {
            RequireType(recordValue, JSONType::OBJECT_VALUE);
            Models::WeeklyRecord record{ ReadInteger(recordValue, KEY_WEEK_NUMBER, 0) };

            const JSONValue& scoresValue{ recordValue.FindMember(KEY_SCORES) };
            if (IsNullOrMissing(scoresValue)) return record;   // "Scores": null → 빈 기록 (원본 field ?? [])
            RequireType(scoresValue, JSONType::OBJECT_VALUE);

            for (const auto& [name, score] : std::views::zip(scoresValue.GetKeys(), scoresValue.GetValues()))
            {
                RequireType(score, JSONType::NUMBER_VALUE);
                record.SetScore(name, score.GetNumber());   // 0 이하는 미기록으로 걸러짐
            }
            return record;
        }

        std::vector<Models::WeeklyRecord> ReadRecords(const JSONValue& recordsValue)
        {
            std::vector<Models::WeeklyRecord> records;
            if (IsNullOrMissing(recordsValue)) return records;
            RequireType(recordsValue, JSONType::ARRAY_VALUE);

            for (const JSONValue& recordValue : recordsValue.GetItems())
            {
                if (IsNullOrMissing(recordValue)) continue;   // 빈 항목 방어 (원본 Records.RemoveAll(r is null))
                records.push_back(ReadRecord(recordValue));
            }
            return records;
        }

        std::vector<Models::Season> ReadSeasons(const JSONValue& seasonsValue)
        {
            std::vector<Models::Season> seasons;
            if (IsNullOrMissing(seasonsValue)) return seasons;
            RequireType(seasonsValue, JSONType::ARRAY_VALUE);

            for (const JSONValue& seasonValue : seasonsValue.GetItems())
            {
                if (IsNullOrMissing(seasonValue)) continue;
                RequireType(seasonValue, JSONType::OBJECT_VALUE);

                Models::Season season{ ReadInteger(seasonValue, KEY_SEASON_NUMBER, 0) };
                season.SetRecords(ReadRecords(seasonValue.FindMember(KEY_RECORDS)));

                // 시즌 기간 (시즌 5부터, 둘 다 올바른 날짜일 때만 → 예전 파일은 기간 없음 = 잠금 없이 자유 입력)
                const std::optional<std::chrono::year_month_day> startDate{ Core::LocalTime::ParseDateKey(seasonValue.FindMember(KEY_START_DATE).GetString()) };
                const std::optional<std::chrono::year_month_day> endDate{ Core::LocalTime::ParseDateKey(seasonValue.FindMember(KEY_END_DATE).GetString()) };
                if (startDate.has_value() && endDate.has_value()) season.SetPeriod(*startDate, *endDate);
                seasons.push_back(std::move(season));
            }
            return seasons;
        }

        // v1(루트에 주차 목록) · v2(시즌별) 모두 읽음 → EnsureValid가 v1을 첫 시즌(시즌 4)으로 옮김
        Models::GrowthData ReadGrowthData(const JSONValue& root)
        {
            RequireType(root, JSONType::OBJECT_VALUE);

            Models::GrowthData data;
            data.SetCharacters(ReadCharacters(root.FindMember(KEY_CHARACTERS)));
            data.SetSeasons(ReadSeasons(root.FindMember(KEY_SEASONS)));
            data.SetSelectedSeasonNumber(ReadInteger(root, KEY_SELECTED_SEASON, Models::GrowthData::FIRST_SEASON_NUMBER));
            data.EnsureValid(ReadRecords(root.FindMember(KEY_LEGACY_RECORDS)));
            return data;
        }

        // ===== 쓰기: 모델 → JSONValue 트리 (키 순서 = 원본 C# 속성 순서) =====
        JSONValue MakeNumber(double value)
        {
            return JSONValue::CreateNumber(value);
        }

        JSONValue MakeNullableString(const std::optional<std::string>& text)
        {
            return text.has_value() ? JSONValue::CreateString(*text) : JSONValue{};
        }

        JSONValue WriteCharacters(const std::vector<Models::CharacterInfo>& characters)
        {
            std::vector<JSONValue> items;
            items.reserve(characters.size());
            for (const Models::CharacterInfo& character : characters)
            {
                items.push_back(JSONValue::CreateObject(
                    { std::string{ KEY_SERVER_NAME }, std::string{ KEY_CHARACTER_NAME }, std::string{ KEY_CLASS_NAME },
                      std::string{ KEY_ITEM_MAX_LEVEL }, std::string{ KEY_ITEM_AVG_LEVEL } },
                    { MakeNullableString(character.GetServerName()), JSONValue::CreateString(character.GetCharacterName()),
                      MakeNullableString(character.GetCharacterClassName()), MakeNullableString(character.GetItemMaxLevel()),
                      MakeNullableString(character.GetItemAvgLevel()) }));
            }
            return JSONValue::CreateArray(std::move(items));
        }

        JSONValue WriteScores(const std::map<std::string, double>& scores)
        {
            std::vector<std::string> keys;
            std::vector<JSONValue> values;
            keys.reserve(scores.size());
            values.reserve(scores.size());
            for (const auto& [name, score] : scores)   // 정렬 맵이라 저장 순서가 고정됨
            {
                keys.push_back(name);
                values.push_back(MakeNumber(score));
            }
            return JSONValue::CreateObject(std::move(keys), std::move(values));
        }

        JSONValue WriteRecords(const std::vector<Models::WeeklyRecord>& records)
        {
            std::vector<JSONValue> items;
            items.reserve(records.size());
            for (const Models::WeeklyRecord& record : records)
            {
                items.push_back(JSONValue::CreateObject(
                    { std::string{ KEY_WEEK_NUMBER }, std::string{ KEY_SCORES } },
                    { MakeNumber(record.GetWeekNumber()), WriteScores(record.GetScores()) }));
            }
            return JSONValue::CreateArray(std::move(items));
        }

        JSONValue WriteSeasons(const std::vector<Models::Season>& seasons)
        {
            std::vector<JSONValue> items;
            items.reserve(seasons.size());
            for (const Models::Season& season : seasons)
            {
                std::vector<std::string> keys{ std::string{ KEY_SEASON_NUMBER }, std::string{ KEY_RECORDS } };
                std::vector<JSONValue> values{ MakeNumber(season.GetSeasonNumber()), WriteRecords(season.GetRecords()) };

                // 기간이 있는 시즌만 "StartDate" · "EndDate" ("yyyy-MM-dd")
                if (season.HasPeriod())
                {
                    keys.emplace_back(KEY_START_DATE);
                    values.push_back(JSONValue::CreateString(Core::LocalTime::MakeDateKey(*season.GetStartDate())));
                    keys.emplace_back(KEY_END_DATE);
                    values.push_back(JSONValue::CreateString(Core::LocalTime::MakeDateKey(*season.GetEndDate())));
                }
                items.push_back(JSONValue::CreateObject(std::move(keys), std::move(values)));
            }
            return JSONValue::CreateArray(std::move(items));
        }

        std::string BuildJSONText(const Models::GrowthData& data)
        {
            return WriteJSONText(JSONValue::CreateObject(
                { std::string{ KEY_DATA_VERSION }, std::string{ KEY_CHARACTERS }, std::string{ KEY_SEASONS }, std::string{ KEY_SELECTED_SEASON } },
                { MakeNumber(Models::GrowthData::CURRENT_DATA_VERSION), WriteCharacters(data.GetCharacters()), WriteSeasons(data.GetSeasons()),
                  MakeNumber(data.GetSelectedSeasonNumber()) }));
        }

        // 원본 낙원력 트래커의 기록 위치 (본 파일 → 이전 버전 파일 순서, 각 파일의 .bak은 JSONFileStore가 이어서 시도)
        std::vector<std::filesystem::path> MakeImportPaths()
        {
            return {
                Core::APPConstants::GetLocalAppDataFilePath(Core::APPConstants::PARADISE_ORIGINAL_FOLDER_NAME, Core::APPConstants::PARADISE_ORIGINAL_FILE_NAME),
                Core::APPConstants::GetLocalAppDataFilePath(Core::APPConstants::PARADISE_ORIGINAL_FOLDER_NAME, Core::APPConstants::PARADISE_LEGACY_FILE_NAME)
            };
        }
    }

    JSONGrowthDataRepository::JSONGrowthDataRepository()
        : m_fileStore{ Core::APPConstants::PARADISE_DATA_FILE_NAME, MakeImportPaths() }
    {
        // 변환이 끝까지 성공한 파일만 반영 (중간에 실패하면 loaded는 그대로 → 백업 · 다음 후보 파일로 다시 시도)
        std::optional<Models::GrowthData> loaded;
        JSONLoadResult result{ m_fileStore.Load([&loaded](const JSONValue& root) { loaded = ReadGrowthData(root); }) };
        m_loadWarning = std::move(result.m_warning);

        m_data = loaded.has_value() ? std::move(*loaded) : Models::GrowthData{};   // 첫 실행 또는 복구 실패
        m_data.EnsureValid();

        // 가져온 기록은 바로 멀티툴 전용 파일에 저장 (원본 파일은 건드리지 않음, 실패하면 다음 실행 때 다시 가져옴)
        if (!result.m_isImported) return;
        try
        {
            Save();
        }
        catch (const std::exception&)
        {
            // 안내는 가져오기 문구로 이미 표시됨 (저장 실패는 다음 저장에서 사용자에게 알림)
        }
    }

    Models::GrowthData& JSONGrowthDataRepository::GetData()
    {
        return m_data;
    }

    const Models::GrowthData& JSONGrowthDataRepository::GetData() const
    {
        return m_data;
    }

    const std::optional<std::string>& JSONGrowthDataRepository::GetLoadWarning() const noexcept
    {
        return m_loadWarning;
    }

    void JSONGrowthDataRepository::Save()
    {
        m_fileStore.Save(BuildJSONText(m_data));
    }
}
﻿module LostArkMultiTool.Services.JSONValue;

import std;

namespace LostArkMultiTool::Services
{
    namespace
    {
        constexpr std::string_view JSON_FORMAT_ERROR_MESSAGE{ "JSON 형식이 올바르지 않습니다." };   // API 응답 · 저장 파일 공용
        constexpr std::string_view NULL_LITERAL{ "null" };
        constexpr std::string_view TRUE_LITERAL{ "true" };
        constexpr std::string_view FALSE_LITERAL{ "false" };
        constexpr char END_OF_TEXT{ '\0' };

        // \uXXXX 이스케이프 처리용
        constexpr std::size_t HEX_DIGIT_COUNT{ 4 };
        constexpr int HEX_RADIX{ 16 };
        constexpr unsigned HIGH_SURROGATE_FIRST{ 0xD800 };
        constexpr unsigned HIGH_SURROGATE_LAST{ 0xDBFF };
        constexpr unsigned LOW_SURROGATE_FIRST{ 0xDC00 };
        constexpr unsigned LOW_SURROGATE_LAST{ 0xDFFF };
        constexpr unsigned SURROGATE_PAIR_BASE{ 0x10000 };
        constexpr unsigned SURROGATE_PAYLOAD_BITS{ 10 };
        constexpr std::size_t UNICODE_ESCAPE_PREFIX_LENGTH{ 2 };
        constexpr std::string_view UNICODE_ESCAPE_PREFIX{ "\\u" };

        // 코드 포인트 → UTF-8 변환용
        constexpr unsigned UTF8_2BYTE_START{ 0x80 };
        constexpr unsigned UTF8_3BYTE_START{ 0x800 };
        constexpr unsigned UTF8_4BYTE_START{ 0x10000 };
        constexpr unsigned UTF8_2BYTE_LEAD{ 0xC0 };
        constexpr unsigned UTF8_3BYTE_LEAD{ 0xE0 };
        constexpr unsigned UTF8_4BYTE_LEAD{ 0xF0 };
        constexpr unsigned UTF8_CONTINUATION{ 0x80 };
        constexpr unsigned UTF8_PAYLOAD_MASK{ 0x3F };
        constexpr unsigned UTF8_SHIFT_6{ 6 };
        constexpr unsigned UTF8_SHIFT_12{ 12 };
        constexpr unsigned UTF8_SHIFT_18{ 18 };

        [[noreturn]] void ThrowFormatError()
        {
            throw std::runtime_error{ std::string{ JSON_FORMAT_ERROR_MESSAGE } };
        }

        bool IsJSONWhitespace(char c) noexcept
        {
            return c == ' ' || c == '\t' || c == '\n' || c == '\r';
        }

        bool IsNumberChar(char c) noexcept
        {
            return (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E';
        }

        // 코드 포인트 하나를 UTF-8 바이트열로 덧붙임
        void AppendUTF8(std::string& out, unsigned codepoint)
        {
            if (codepoint < UTF8_2BYTE_START)
            {
                out.push_back(static_cast<char>(codepoint));
            }
            else if (codepoint < UTF8_3BYTE_START)
            {
                out.push_back(static_cast<char>(UTF8_2BYTE_LEAD | (codepoint >> UTF8_SHIFT_6)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | (codepoint & UTF8_PAYLOAD_MASK)));
            }
            else if (codepoint < UTF8_4BYTE_START)
            {
                out.push_back(static_cast<char>(UTF8_3BYTE_LEAD | (codepoint >> UTF8_SHIFT_12)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | ((codepoint >> UTF8_SHIFT_6) & UTF8_PAYLOAD_MASK)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | (codepoint & UTF8_PAYLOAD_MASK)));
            }
            else
            {
                out.push_back(static_cast<char>(UTF8_4BYTE_LEAD | (codepoint >> UTF8_SHIFT_18)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | ((codepoint >> UTF8_SHIFT_12) & UTF8_PAYLOAD_MASK)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | ((codepoint >> UTF8_SHIFT_6) & UTF8_PAYLOAD_MASK)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | (codepoint & UTF8_PAYLOAD_MASK)));
            }
        }

        // 재귀 하강 방식의 JSON 파서 (내부 전용)
        class JSONParser
        {
        public:
            explicit JSONParser(std::string_view text) noexcept
                : m_text{ text }
            {}

            JSONValue ParseDocument()
            {
                JSONValue root{ ParseValue() };
                SkipWhitespace();
                if (!IsRawEnd()) ThrowFormatError();   // 값 뒤에 남은 글자가 있으면 형식 오류
                return root;
            }

        private:
            JSONValue ParseValue()
            {
                switch (PeekChar())
                {
                    case '{': return ParseObject();
                    case '[': return ParseArray();
                    case '"': return JSONValue::CreateString(ParseString());
                    case 't':
                        ExpectLiteral(TRUE_LITERAL);
                        return JSONValue::CreateBool(true);
                    case 'f':
                        ExpectLiteral(FALSE_LITERAL);
                        return JSONValue::CreateBool(false);
                    case 'n':
                        ExpectLiteral(NULL_LITERAL);
                        return JSONValue{};
                    default:
                        return JSONValue::CreateNumber(ParseNumber());
                }
            }

            JSONValue ParseObject()
            {
                ExpectChar('{');
                std::vector<std::string> keys;
                std::vector<JSONValue> values;

                if (PeekChar() == '}')
                {
                    ++m_position;
                    return JSONValue::CreateObject(std::move(keys), std::move(values));
                }

                while (true)
                {
                    keys.push_back(ParseString());
                    ExpectChar(':');
                    values.push_back(ParseValue());

                    const char next{ PeekChar() };
                    if (next == ',')
                    {
                        ++m_position;
                        continue;
                    }
                    if (next == '}')
                    {
                        ++m_position;
                        break;
                    }
                    ThrowFormatError();
                }
                return JSONValue::CreateObject(std::move(keys), std::move(values));
            }

            JSONValue ParseArray()
            {
                ExpectChar('[');
                std::vector<JSONValue> items;

                if (PeekChar() == ']')
                {
                    ++m_position;
                    return JSONValue::CreateArray(std::move(items));
                }

                while (true)
                {
                    items.push_back(ParseValue());

                    const char next{ PeekChar() };
                    if (next == ',')
                    {
                        ++m_position;
                        continue;
                    }
                    if (next == ']')
                    {
                        ++m_position;
                        break;
                    }
                    ThrowFormatError();
                }
                return JSONValue::CreateArray(std::move(items));
            }

            std::string ParseString()
            {
                ExpectChar('"');

                std::string result;
                while (true)
                {
                    if (IsRawEnd()) ThrowFormatError();
                    const char current{ m_text[m_position++] };

                    if (current == '"') return result;
                    if (current != '\\')
                    {
                        result.push_back(current);
                        continue;
                    }

                    if (IsRawEnd()) ThrowFormatError();
                    const char escaped{ m_text[m_position++] };
                    switch (escaped)
                    {
                        case '"':  result.push_back('"'); break;
                        case '\\': result.push_back('\\'); break;
                        case '/':  result.push_back('/'); break;
                        case 'b':  result.push_back('\b'); break;
                        case 'f':  result.push_back('\f'); break;
                        case 'n':  result.push_back('\n'); break;
                        case 'r':  result.push_back('\r'); break;
                        case 't':  result.push_back('\t'); break;
                        case 'u':  AppendUTF8(result, ReadUnicodeEscape()); break;
                        default:   ThrowFormatError();
                    }
                }
            }

            // \uXXXX 한 개 (상위·하위 대리 문자면 쌍으로 묶어서 코드 포인트를 만듦)
            unsigned ReadUnicodeEscape()
            {
                const unsigned first{ ReadHex4() };
                if (first < HIGH_SURROGATE_FIRST || first > LOW_SURROGATE_LAST) return first;   // 일반 글자
                if (first >= LOW_SURROGATE_FIRST) ThrowFormatError();                           // 짝 없는 하위 대리 문자

                // 상위 대리 문자 바로 뒤에는 하위 대리 문자 이스케이프가 반드시 와야 함
                if (m_text.substr(m_position, UNICODE_ESCAPE_PREFIX_LENGTH) != UNICODE_ESCAPE_PREFIX) ThrowFormatError();
                m_position += UNICODE_ESCAPE_PREFIX_LENGTH;

                const unsigned second{ ReadHex4() };
                if (second < LOW_SURROGATE_FIRST || second > LOW_SURROGATE_LAST) ThrowFormatError();

                return SURROGATE_PAIR_BASE
                    + ((first - HIGH_SURROGATE_FIRST) << SURROGATE_PAYLOAD_BITS)
                    + (second - LOW_SURROGATE_FIRST);
            }

            unsigned ReadHex4()
            {
                if (m_position + HEX_DIGIT_COUNT > m_text.size()) ThrowFormatError();

                const char* first{ m_text.data() + m_position };
                const char* last{ first + HEX_DIGIT_COUNT };
                unsigned value{};
                const auto [ptr, ec] { std::from_chars(first, last, value, HEX_RADIX) };
                if (ec != std::errc{} || ptr != last) ThrowFormatError();

                m_position += HEX_DIGIT_COUNT;
                return value;
            }

            double ParseNumber()
            {
                SkipWhitespace();
                const std::size_t start{ m_position };
                while (!IsRawEnd() && IsNumberChar(m_text[m_position])) ++m_position;

                const std::string_view token{ m_text.substr(start, m_position - start) };
                double value{};
                const auto [ptr, ec] { std::from_chars(token.data(), token.data() + token.size(), value) };
                if (token.empty() || ec != std::errc{} || ptr != token.data() + token.size()) ThrowFormatError();
                return value;
            }

            void ExpectLiteral(std::string_view literal)
            {
                SkipWhitespace();
                if (m_text.substr(m_position, literal.size()) != literal) ThrowFormatError();
                m_position += literal.size();
            }

            void ExpectChar(char expected)
            {
                if (PeekChar() != expected) ThrowFormatError();
                ++m_position;
            }

            // 공백을 건너뛴 다음 글자를 봄 (끝이면 END_OF_TEXT)
            char PeekChar()
            {
                SkipWhitespace();
                return IsRawEnd() ? END_OF_TEXT : m_text[m_position];
            }

            void SkipWhitespace() noexcept
            {
                while (!IsRawEnd() && IsJSONWhitespace(m_text[m_position])) ++m_position;
            }

            [[nodiscard]] bool IsRawEnd() const noexcept
            {
                return m_position >= m_text.size();
            }

            std::string_view m_text;
            std::size_t m_position{};
        };
    }

    JSONValue::JSONValue() noexcept = default;

    JSONValue JSONValue::CreateBool(bool value)
    {
        JSONValue result;
        result.m_type = JSONType::BOOL_VALUE;
        result.m_boolValue = value;
        return result;
    }

    JSONValue JSONValue::CreateNumber(double value)
    {
        JSONValue result;
        result.m_type = JSONType::NUMBER_VALUE;
        result.m_numberValue = value;
        return result;
    }

    JSONValue JSONValue::CreateString(std::string value)
    {
        JSONValue result;
        result.m_type = JSONType::STRING_VALUE;
        result.m_stringValue = std::move(value);
        return result;
    }

    JSONValue JSONValue::CreateArray(std::vector<JSONValue> items)
    {
        JSONValue result;
        result.m_type = JSONType::ARRAY_VALUE;
        result.m_items = std::move(items);
        return result;
    }

    JSONValue JSONValue::CreateObject(std::vector<std::string> keys, std::vector<JSONValue> values)
    {
        JSONValue result;
        result.m_type = JSONType::OBJECT_VALUE;
        result.m_keys = std::move(keys);
        result.m_items = std::move(values);
        return result;
    }

    JSONType JSONValue::GetType() const noexcept
    {
        return m_type;
    }

    bool JSONValue::GetBool() const noexcept
    {
        return m_type == JSONType::BOOL_VALUE && m_boolValue;
    }

    double JSONValue::GetNumber() const noexcept
    {
        return m_type == JSONType::NUMBER_VALUE ? m_numberValue : 0.0;
    }

    const std::string& JSONValue::GetString() const noexcept
    {
        static const std::string EMPTY_STRING{};
        return m_type == JSONType::STRING_VALUE ? m_stringValue : EMPTY_STRING;
    }

    const std::vector<JSONValue>& JSONValue::GetItems() const noexcept
    {
        static const std::vector<JSONValue> EMPTY_ITEMS{};
        return m_type == JSONType::ARRAY_VALUE ? m_items : EMPTY_ITEMS;
    }

    const std::vector<std::string>& JSONValue::GetKeys() const noexcept
    {
        static const std::vector<std::string> EMPTY_KEYS{};
        return m_type == JSONType::OBJECT_VALUE ? m_keys : EMPTY_KEYS;
    }

    const std::vector<JSONValue>& JSONValue::GetValues() const noexcept
    {
        static const std::vector<JSONValue> EMPTY_VALUES{};
        return m_type == JSONType::OBJECT_VALUE ? m_items : EMPTY_VALUES;
    }

    const JSONValue& JSONValue::FindMember(std::string_view key) const noexcept
    {
        static const JSONValue NULL_NODE{};
        if (m_type != JSONType::OBJECT_VALUE) return NULL_NODE;

        for (std::size_t index{}; index < m_keys.size(); ++index)
        {
            if (m_keys[index] == key) return m_items[index];
        }
        return NULL_NODE;
    }

    JSONValue ParseJSONText(std::string_view text)
    {
        JSONParser parser{ text };
        return parser.ParseDocument();
    }

    namespace
    {
        // ===== 쓰기 형식 =====
        constexpr std::size_t INDENT_WIDTH{ 2 };
        constexpr unsigned CONTROL_CHARACTER_LIMIT{ 0x20 };       // 이보다 작은 글자는 \u00XX로
        constexpr std::string_view LOWER_HEX_DIGITS{ "0123456789abcdef" };
        constexpr unsigned NIBBLE_BITS{ 4 };
        constexpr unsigned NIBBLE_MASK{ 0xF };
        constexpr std::string_view CONTROL_ESCAPE_PREFIX{ "\\u00" };
        constexpr double MAX_EXACT_INTEGER{ 9'007'199'254'740'992.0 };   // 2^53 (double이 정수를 정확히 담는 한계)

        void AppendIndent(std::string& out, std::size_t depth)
        {
            out.append(depth * INDENT_WIDTH, ' ');
        }

        void AppendQuoted(std::string& out, std::string_view text)
        {
            out.push_back('"');
            for (const char c : text)
            {
                switch (c)
                {
                    case '"':  out += "\\\""; break;
                    case '\\': out += "\\\\"; break;
                    case '\n': out += "\\n"; break;
                    case '\r': out += "\\r"; break;
                    case '\t': out += "\\t"; break;
                    default:
                    {
                        const auto byte{ static_cast<unsigned char>(c) };
                        if (byte >= CONTROL_CHARACTER_LIMIT)
                        {
                            out.push_back(c);   // 한글 등 UTF-8 바이트는 그대로
                            break;
                        }
                        out += CONTROL_ESCAPE_PREFIX;
                        out.push_back(LOWER_HEX_DIGITS[static_cast<std::size_t>(byte >> NIBBLE_BITS)]);
                        out.push_back(LOWER_HEX_DIGITS[static_cast<std::size_t>(byte & NIBBLE_MASK)]);
                        break;
                    }
                }
            }
            out.push_back('"');
        }

        void AppendValue(std::string& out, const JSONValue& value, std::size_t depth)
        {
            switch (value.GetType())
            {
                case JSONType::BOOL_VALUE:
                    out += value.GetBool() ? TRUE_LITERAL : FALSE_LITERAL;
                    return;

                case JSONType::NUMBER_VALUE:
                {
                    // 정수는 지수 표기 없이 그대로 (예: 100000000 → "1e+08"이 아니라 "100000000")
                    const double number{ value.GetNumber() };
                    if (std::trunc(number) == number && std::abs(number) < MAX_EXACT_INTEGER)
                    {
                        out += std::to_string(static_cast<std::int64_t>(number));
                        return;
                    }
                    out += std::vformat("{}", std::make_format_args(number));
                    return;
                }

                case JSONType::STRING_VALUE:
                    AppendQuoted(out, value.GetString());
                    return;

                case JSONType::ARRAY_VALUE:
                {
                    const std::vector<JSONValue>& items{ value.GetItems() };
                    out.push_back('[');
                    for (std::size_t index{}; index < items.size(); ++index)
                    {
                        out += index == 0 ? "\n" : ",\n";
                        AppendIndent(out, depth + 1);
                        AppendValue(out, items[index], depth + 1);
                    }
                    if (!items.empty())
                    {
                        out.push_back('\n');
                        AppendIndent(out, depth);
                    }
                    out.push_back(']');
                    return;
                }

                case JSONType::OBJECT_VALUE:
                {
                    const std::vector<std::string>& keys{ value.GetKeys() };
                    const std::vector<JSONValue>& values{ value.GetValues() };
                    out.push_back('{');
                    for (std::size_t index{}; index < keys.size(); ++index)
                    {
                        out += index == 0 ? "\n" : ",\n";
                        AppendIndent(out, depth + 1);
                        AppendQuoted(out, keys[index]);
                        out += ": ";
                        AppendValue(out, values[index], depth + 1);
                    }
                    if (!keys.empty())
                    {
                        out.push_back('\n');
                        AppendIndent(out, depth);
                    }
                    out.push_back('}');
                    return;
                }

                default:
                    out += NULL_LITERAL;
                    return;
            }
        }
    }

    std::string WriteJSONText(const JSONValue& value)
    {
        constexpr std::size_t ROOT_DEPTH{ 0 };

        std::string out;
        AppendValue(out, value, ROOT_DEPTH);
        out.push_back('\n');
        return out;
    }
