module LostArkCalculator.Core.APPConstants;

import std;

namespace LostArkCalculator::Core::APPConstants
{
	namespace
	{
		//	윈도우가 지원하는 가장 긴 경로 길이 (긴 경로 기능 기준)
		inline constexpr size_t EXE_PATH_BUFFER_SIZE{ 32767 };

		//	실행 파일 폴더 (작업 디렉터리와 무관하게 항상 exe 옆)
		std::filesystem::path GetExecutableDirectory()
		{
			std::wstring buffer(EXE_PATH_BUFFER_SIZE, L'\0');
			const DWORD length{ ::GetModuleFileNameW(nullptr, buffer.data(), static_cast<DWORD>(buffer.size())) };
			if (length == 0) throw std::runtime_error{ "실행 파일 경로를 가져오지 못했어요!" };

			buffer.resize(length);
			return std::filesystem::path{ buffer }.parent_path();
		}
	}

	std::filesystem::path GetSaveFilePath()
	{
		return GetExecutableDirectory() / std::filesystem::path{ SAVE_FILE_NAME };
	}

	std::filesystem::path GetBackupFilePath()
	{
		std::filesystem::path backupPath{ GetSaveFilePath() };
		backupPath += BACKUP_FILE_SUFFIX;

		return backupPath;
	}

	std::filesystem::path GetTempFilePath()
	{
		std::filesystem::path tempPath{ GetSaveFilePath() };
		tempPath += TEMP_FILE_SUFFIX;

		return tempPath;
	}
}﻿module LostArkCalculator.Core.APPExceptions;

