#define NOMINMAX
#define WIN32_LEAN_AND_MEAN
#define NOUSER   // winuser.h 제외: GetClassName 등이 GetClassNameW로 치환되는 매크로 충돌 방지
#include <Windows.h>

module LostArkCalculator.Services.JSONDataRepository;

import std;
import LostArkCalculator.Core.APPConstants;
import LostArkCalculator.Models.Character;
import LostArkCalculator.Models.ItemData;

namespace LostArkCalculator::Services
{
    namespace
    {
        // ===== 저장 파일 키 이름 (원본 C# 저장 파일과 같아야 옛 기록을 그대로 읽음) =====
        constexpr std::string_view KEY_CHARACTERS{ "Characters" };
        constexpr std::string_view KEY_HISTORY{ "History" };
        constexpr std::string_view KEY_CLASS_NAME{ "ClassName" };
        constexpr std::string_view KEY_ITEM_LEVEL{ "ItemLevel" };
        constexpr std::string_view KEY_MATERIALS{ "Materials" };
        constexpr std::string_view KEY_TOP_QTY{ "TopQty" };
        constexpr std::string_view KEY_BOTTOM_QTY{ "BottomQty" };

        // ===== JSON 문법 상수 =====
        constexpr std::string_view NULL_LITERAL{ "null" };
        constexpr std::string_view TRUE_LITERAL{ "true" };
        constexpr std::string_view FALSE_LITERAL{ "false" };
        constexpr std::string_view UTF8_BOM{ "\xEF\xBB\xBF" };
        constexpr std::string_view JSON_FORMAT_ERROR_MESSAGE{ "JSON 형식이 올바르지 않습니다." };
        constexpr char END_OF_TEXT{ '\0' };
        constexpr unsigned ASCII_LIMIT{ 0x80 };
        constexpr unsigned CONTROL_CHAR_LIMIT{ 0x20 };
        constexpr std::size_t HEX_DIGIT_COUNT{ 4 };
        constexpr int HEX_RADIX{ 16 };

        // ===== 쓰기 형식 =====
        constexpr std::size_t INDENT_WIDTH{ 2 };
        constexpr std::size_t ROOT_DEPTH{ 0 };
        constexpr std::size_t ROOT_MEMBER_DEPTH{ 1 };
        constexpr std::string_view HEX_DIGITS{ "0123456789abcdef" };
        constexpr unsigned NIBBLE_BITS{ 4 };
        constexpr unsigned NIBBLE_MASK{ 0xF };

        // 파일 읽기 결과 상태
        enum class LoadStatus
        {
            NOT_FOUND,
            LOADED,
            CORRUPTED
        };

        [[noreturn]] void ThrowFormatError()
        {
            throw std::runtime_error{ std::string{ JSON_FORMAT_ERROR_MESSAGE } };
        }

        // 지금 시각 (Windows 로컬 시간 = 원본 C#의 DateTime.Now와 같은 기준)
        SYSTEMTIME GetLocalNow()
        {
            SYSTEMTIME now{};
            ::GetLocalTime(&now);
            return now;
        }

        // 오늘 날짜 - 옛 "MM-dd" 기록 변환에 사용
        std::chrono::year_month_day GetLocalToday()
        {
            const SYSTEMTIME now{ GetLocalNow() };
            return std::chrono::year_month_day{
                std::chrono::year{ static_cast<int>(now.wYear) },
                std::chrono::month{ static_cast<unsigned>(now.wMonth) },
                std::chrono::day{ static_cast<unsigned>(now.wDay) }
            };
        }

        // 파일 이름용 타임스탬프 "yyyyMMdd_HHmmss"
        std::string MakeTimestamp()
        {
            const SYSTEMTIME now{ GetLocalNow() };
            return std::format("{:04}{:02}{:02}_{:02}{:02}{:02}",
                static_cast<int>(now.wYear), static_cast<int>(now.wMonth), static_cast<int>(now.wDay),
                static_cast<int>(now.wHour), static_cast<int>(now.wMinute), static_cast<int>(now.wSecond));
        }

        // 경로를 UTF-8 문자열로 (한글 경로가 깨지지 않도록 Windows 변환 API 사용)
        std::string ToUtf8String(const std::filesystem::path& path)
        {
            const std::wstring wide{ path.wstring() };
            if (wide.empty()) return {};

            const int wideLength{ static_cast<int>(wide.size()) };
            const int utf8Length{ ::WideCharToMultiByte(CP_UTF8, 0, wide.data(), wideLength, nullptr, 0, nullptr, nullptr) };
            std::string utf8(static_cast<std::size_t>(utf8Length), '\0');
            ::WideCharToMultiByte(CP_UTF8, 0, wide.data(), wideLength, utf8.data(), utf8Length, nullptr, nullptr);
            return utf8;
        }

        bool IsJsonWhitespace(char c) noexcept
        {
            return c == ' ' || c == '\t' || c == '\n' || c == '\r';
        }

        bool IsNumberChar(char c) noexcept
        {
            return (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E';
        }

        // ===== 읽기: 필요한 구조만 순서대로 읽는 최소 JSON 리더 =====
        class JsonReader
        {
        public:
            explicit JsonReader(std::string_view text)
                : m_text{ text }
            {}

            // 공백을 건너뛰고 다음 글자를 봄 (끝이면 END_OF_TEXT)
            [[nodiscard]] char PeekChar()
            {
                SkipWhitespace();
                return IsRawEnd() ? END_OF_TEXT : m_text[m_position];
            }

            // 공백을 건너뛴 뒤 끝까지 읽었는지 확인
            [[nodiscard]] bool IsAtEnd()
            {
                SkipWhitespace();
                return IsRawEnd();
            }

            void ExpectChar(char expected)
            {
                if (PeekChar() != expected) ThrowFormatError();
                ++m_position;
            }

            // "null"이면 소비하고 true
            [[nodiscard]] bool TryReadNull()
            {
                if (PeekChar() != NULL_LITERAL.front()) return false;
                ExpectLiteral(NULL_LITERAL);
                return true;
            }

            std::string ReadString()
            {
                ExpectChar('"');

                std::string result;
                while (true)
                {
                    if (IsRawEnd()) ThrowFormatError();
                    const char current{ m_text[m_position++] };

                    if (current == '"') return result;
                    if (current != '\\')
                    {
                        result.push_back(current);
                        continue;
                    }

                    if (IsRawEnd()) ThrowFormatError();
                    const char escaped{ m_text[m_position++] };
                    switch (escaped)
                    {
                        case '"':  result.push_back('"'); break;
                        case '\\': result.push_back('\\'); break;
                        case '/':  result.push_back('/'); break;
                        case 'b':  result.push_back('\b'); break;
                        case 'f':  result.push_back('\f'); break;
                        case 'n':  result.push_back('\n'); break;
                        case 'r':  result.push_back('\r'); break;
                        case 't':  result.push_back('\t'); break;
                        case 'u':
                        {
                            // Newtonsoft는 제어 문자만 \u로 쓰므로 ASCII 범위만 처리
                            const unsigned codepoint{ ReadHexCodepoint() };
                            if (codepoint >= ASCII_LIMIT) ThrowFormatError();
                            result.push_back(static_cast<char>(codepoint));
                            break;
                        }
                        default:
                            ThrowFormatError();
                    }
                }
            }

            double ReadNumber()
            {
                SkipWhitespace();
                const std::size_t start{ m_position };
                while (!IsRawEnd() && IsNumberChar(m_text[m_position])) ++m_position;

                const std::string_view token{ m_text.substr(start, m_position - start) };
                const char* first{ token.data() };
                const char* last{ token.data() + token.size() };

                double value{};
                const auto [ptr, ec] { std::from_chars(first, last, value) };
                if (token.empty() || ec != std::errc{} || ptr != last) ThrowFormatError();
                return value;
            }

            // 필요 없는 값은 구조만 건너뜀
            void SkipValue()
            {
                switch (PeekChar())
                {
                    case '{':
                        ReadObject([this](const std::string&) { SkipValue(); });
                        break;
                    case '[':
                        SkipArray();
                        break;
                    case '"':
                        ReadString();
                        break;
                    case 'n':
                        ExpectLiteral(NULL_LITERAL);
                        break;
                    case 't':
                        ExpectLiteral(TRUE_LITERAL);
                        break;
                    case 'f':
                        ExpectLiteral(FALSE_LITERAL);
                        break;
                    default:
                        ReadNumber();
                        break;
                }
            }

            // "{ key: value, ... }" 를 읽으면서 각 key마다 onMember 호출 (onMember가 value를 소비해야 함)
            void ReadObject(const std::function<void(const std::string&)>& onMember)
            {
                ExpectChar('{');
                if (PeekChar() == '}')
                {
                    ++m_position;
                    return;
                }

                while (true)
                {
                    const std::string key{ ReadString() };
                    ExpectChar(':');
                    onMember(key);

                    const char next{ PeekChar() };
                    if (next == ',')
                    {
                        ++m_position;
                        continue;
                    }
                    if (next == '}')
                    {
                        ++m_position;
                        return;
                    }
                    ThrowFormatError();
                }
            }

        private:
            void SkipWhitespace() noexcept
            {
                while (!IsRawEnd() && IsJsonWhitespace(m_text[m_position])) ++m_position;
            }

            [[nodiscard]] bool IsRawEnd() const noexcept
            {
                return m_position >= m_text.size();
            }

            void ExpectLiteral(std::string_view literal)
            {
                SkipWhitespace();
                if (m_text.substr(m_position, literal.size()) != literal) ThrowFormatError();
                m_position += literal.size();
            }

            void SkipArray()
            {
                ExpectChar('[');
                if (PeekChar() == ']')
                {
                    ++m_position;
                    return;
                }

                while (true)
                {
                    SkipValue();

                    const char next{ PeekChar() };
                    if (next == ',')
                    {
                        ++m_position;
                        continue;
                    }
                    if (next == ']')
                    {
                        ++m_position;
                        return;
                    }
                    ThrowFormatError();
                }
            }

            unsigned ReadHexCodepoint()
            {
                if (m_position + HEX_DIGIT_COUNT > m_text.size()) ThrowFormatError();

                const char* first{ m_text.data() + m_position };
                const char* last{ first + HEX_DIGIT_COUNT };
                unsigned codepoint{};
                const auto [ptr, ec] { std::from_chars(first, last, codepoint, HEX_RADIX) };
                if (ec != std::errc{} || ptr != last) ThrowFormatError();

                m_position += HEX_DIGIT_COUNT;
                return codepoint;
            }

            std::string_view m_text;
            std::size_t m_position{};
        };

        Models::ItemData ReadItem(JsonReader& reader)
        {
            Models::ItemData item;
            reader.ReadObject([&](const std::string& key) {
                if (key == KEY_TOP_QTY) item.SetTopQty(reader.ReadNumber());
                else if (key == KEY_BOTTOM_QTY) item.SetBottomQty(reader.ReadNumber());
                else reader.SkipValue();
            });
            return item;
        }

        std::unordered_map<std::string, Models::ItemData> ReadMaterials(JsonReader& reader)
        {
            std::unordered_map<std::string, Models::ItemData> materials;
            if (reader.TryReadNull()) return materials;

            reader.ReadObject([&](const std::string& key) {
                materials.insert_or_assign(key, ReadItem(reader));
            });
            return materials;
        }

        std::optional<std::string> ReadNullableString(JsonReader& reader)
        {
            if (reader.TryReadNull()) return std::nullopt;
            return reader.ReadString();
        }

        Models::Character ReadCharacter(JsonReader& reader)
        {
            Models::Character character;
            reader.ReadObject([&](const std::string& key) {
                if (key == KEY_CLASS_NAME) character.SetClassName(ReadNullableString(reader));
                else if (key == KEY_ITEM_LEVEL) character.SetItemLevel(reader.ReadNumber());
                else if (key == KEY_MATERIALS) character.SetMaterials(ReadMaterials(reader));
                else reader.SkipValue();
            });
            character.EnsureMaterials();   // 빠진 재료 키 보정 (원본 OnDeserialized와 같은 역할)
            return character;
        }

        Models::UserData ReadUserData(JsonReader& reader)
        {
            std::unordered_map<std::string, Models::Character> characters;
            std::map<std::string, double> history;

            reader.ReadObject([&](const std::string& key) {
                if (key == KEY_CHARACTERS)
                {
                    if (reader.TryReadNull()) return;
                    reader.ReadObject([&](const std::string& name) {
                        characters.insert_or_assign(name, reader.TryReadNull() ? Models::Character{} : ReadCharacter(reader));
                    });
                }
                else if (key == KEY_HISTORY)
                {
                    if (reader.TryReadNull()) return;
                    reader.ReadObject([&](const std::string& date) {
                        history.insert_or_assign(date, reader.ReadNumber());
                    });
                }
                else reader.SkipValue();
            });

            Models::UserData data;
            data.SetCharacters(std::move(characters));
            data.SetHistory(std::move(history));
            return data;
        }

        // ===== 쓰기 =====
        void AppendIndent(std::string& out, std::size_t depth)
        {
            out.append(depth * INDENT_WIDTH, ' ');
        }

        void AppendQuoted(std::string& out, std::string_view text)
        {
            out.push_back('"');
            for (const char c : text)
            {
                switch (c)
                {
                    case '"':  out += "\\\""; break;
                    case '\\': out += "\\\\"; break;
                    case '\n': out += "\\n"; break;
                    case '\r': out += "\\r"; break;
                    case '\t': out += "\\t"; break;
                    default:
                        if (static_cast<unsigned char>(c) < CONTROL_CHAR_LIMIT)
                        {
                            // \u00XX 형식을 직접 만듦 (std::format 없이 16진수 두 자리)
                            const auto value{ static_cast<unsigned char>(c) };
                            out += "\\u00";
                            out.push_back(HEX_DIGITS[static_cast<std::size_t>(value >> NIBBLE_BITS)]);
                            out.push_back(HEX_DIGITS[static_cast<std::size_t>(value & NIBBLE_MASK)]);
                        }
                        else
                        {
                            out.push_back(c);   // 한글 등 UTF-8 바이트는 그대로 씀 (원본과 같음)
                        }
                        break;
                }
            }
            out.push_back('"');
        }

        // 객체 멤버 하나 시작 (첫 멤버는 쉼표 없이)
        void AppendMemberPrefix(std::string& out, bool& isFirst, std::size_t depth)
        {
            out += isFirst ? "\n" : ",\n";
            isFirst = false;
            AppendIndent(out, depth);
        }

        // 객체 닫기 (객체 자신의 들여쓰기 depth 기준)
        void AppendMemberClose(std::string& out, bool isFirst, std::size_t depth)
        {
            if (!isFirst)
            {
                out.push_back('\n');
                AppendIndent(out, depth);
            }
            out.push_back('}');
        }

        std::string FormatNumber(double value)
        {
            return std::format("{}", value);
        }

        void AppendItem(std::string& out, const Models::ItemData& item, std::size_t depth)
        {
            out.push_back('{');
            bool isFirst{ true };

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_TOP_QTY);
            out += ": " + FormatNumber(item.GetTopQty());

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_BOTTOM_QTY);
            out += ": " + FormatNumber(item.GetBottomQty());

            AppendMemberClose(out, isFirst, depth);
        }

        void AppendMaterials(std::string& out, const Models::Character& character, std::size_t depth)
        {
            out.push_back('{');
            bool isFirst{ true };

            for (const std::string_view key : Core::APPConstants::MAT_KEYS)
            {
                if (key.empty()) continue;

                AppendMemberPrefix(out, isFirst, depth + 1);
                AppendQuoted(out, key);
                out += ": ";
                AppendItem(out, character.GetMaterial(key), depth + 1);
            }

            AppendMemberClose(out, isFirst, depth);
        }

        void AppendCharacter(std::string& out, const Models::Character& character, std::size_t depth)
        {
            out.push_back('{');
            bool isFirst{ true };

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_CLASS_NAME);
            out += ": ";
            if (character.GetClassName().has_value()) AppendQuoted(out, *character.GetClassName());
            else out += "null";

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_ITEM_LEVEL);
            out += ": " + FormatNumber(character.GetItemLevel());

            AppendMemberPrefix(out, isFirst, depth + 1);
            AppendQuoted(out, KEY_MATERIALS);
            out += ": ";
            AppendMaterials(out, character, depth + 1);

            AppendMemberClose(out, isFirst, depth);
        }

        void AppendCharacters(std::string& out, const Models::UserData& data, std::size_t depth)
        {
            const auto& characters{ data.GetCharacters() };

            // 저장 순서를 고정하려고 이름순 정렬
            std::vector<std::string_view> names;
            names.reserve(characters.size());
            for (const auto& entry : characters) names.push_back(entry.first);
            std::sort(names.begin(), names.end());

            out.push_back('{');
            bool isFirst{ true };
            for (const std::string_view name : names)
            {
                AppendMemberPrefix(out, isFirst, depth + 1);
                AppendQuoted(out, name);
                out += ": ";
                AppendCharacter(out, characters.at(std::string{ name }), depth + 1);
            }
            AppendMemberClose(out, isFirst, depth);
        }

        void AppendHistory(std::string& out, const Models::UserData& data, std::size_t depth)
        {
            out.push_back('{');
            bool isFirst{ true };
            for (const auto& entry : data.GetHistory())   // std::map이라 이미 날짜순
            {
                AppendMemberPrefix(out, isFirst, depth + 1);
                AppendQuoted(out, entry.first);
                out += ": " + FormatNumber(entry.second);
            }
            AppendMemberClose(out, isFirst, depth);
        }

        std::string BuildJsonText(const Models::UserData& data)
        {
            std::string out;
            out.push_back('{');
            bool isFirst{ true };

            AppendMemberPrefix(out, isFirst, ROOT_MEMBER_DEPTH);
            AppendQuoted(out, KEY_CHARACTERS);
            out += ": ";
            AppendCharacters(out, data, ROOT_MEMBER_DEPTH);

            AppendMemberPrefix(out, isFirst, ROOT_MEMBER_DEPTH);
            AppendQuoted(out, KEY_HISTORY);
            out += ": ";
            AppendHistory(out, data, ROOT_MEMBER_DEPTH);

            AppendMemberClose(out, isFirst, ROOT_DEPTH);
            out.push_back('\n');
            return out;
        }

        // ===== 파일 입출력 =====
        Models::UserData ParseUserDataFile(const std::filesystem::path& path)
        {
            std::ifstream in{ path, std::ios::binary };
            if (!in) throw std::runtime_error{ "저장 파일을 열지 못했습니다." };

            std::string text{ std::istreambuf_iterator<char>{ in }, std::istreambuf_iterator<char>{} };
            std::string_view view{ text };
            if (view.starts_with(UTF8_BOM)) view.remove_prefix(UTF8_BOM.size());

            JsonReader reader{ view };
            Models::UserData data{ ReadUserData(reader) };
            if (!reader.IsAtEnd()) ThrowFormatError();   // 뒤에 쓰레기 글자가 있으면 손상으로 봄
            return data;
        }

        // 파일 읽기: 없음 / 성공 / 손상 구분 (손상이면 예외 없이 CORRUPTED)
        std::pair<LoadStatus, std::optional<Models::UserData>> TryLoad(const std::filesystem::path& path)
        {
            std::error_code errorCode;
            if (!std::filesystem::exists(path, errorCode)) return { LoadStatus::NOT_FOUND, std::nullopt };

            try
            {
                Models::UserData data{ ParseUserDataFile(path) };
                data.MigrateLegacyHistory(GetLocalToday());
                return { LoadStatus::LOADED, std::move(data) };
            }
            catch (const std::exception&)
            {
                return { LoadStatus::CORRUPTED, std::nullopt };
            }
        }

        // 손상본은 별도 이름으로 보관하고, 본 파일 자리는 비움
        std::string PreserveCorruptFile(const std::filesystem::path& savePath)
        {
            std::filesystem::path corruptPath{ savePath };
            corruptPath += ".corrupt_" + MakeTimestamp();

            try
            {
                std::filesystem::rename(savePath, corruptPath);
                return ToUtf8String(corruptPath);
            }
            catch (const std::filesystem::filesystem_error& error)
            {
                return std::format("(보관 실패: {})", error.what());
            }
        }

        void WriteTextFile(const std::filesystem::path& path, const std::string& text)
        {
            std::ofstream out{ path, std::ios::binary | std::ios::trunc };
            if (!out) throw std::runtime_error{ "저장 파일을 열지 못했습니다." };

            out << text;
            out.close();
            if (out.fail()) throw std::runtime_error{ "저장 파일 쓰기에 실패했습니다." };
        }
    }

    JSONDataRepository::JSONDataRepository()
    {
        const std::filesystem::path savePath{ Core::APPConstants::GetSaveFilePath() };
        auto primary{ TryLoad(savePath) };

        if (primary.first == LoadStatus::CORRUPTED)
        {
            // 손상본을 먼저 치워야 다음 저장 때 .bak이 덮어써지지 않음
            const std::string corruptLocation{ PreserveCorruptFile(savePath) };
            auto backup{ TryLoad(Core::APPConstants::GetBackupFilePath()) };

            primary.second = std::move(backup.second);
            m_loadWarning = primary.second.has_value()
                ? std::format("저장 파일이 손상되어 백업에서 복구했습니다.\n손상된 원본: {}", corruptLocation)
                : std::format("저장 파일이 손상되어 새로 시작합니다.\n손상된 원본: {}", corruptLocation);
        }

        m_data = primary.second.has_value() ? std::move(*primary.second) : Models::UserData{};

        // 캐릭터가 하나도 없으면 기본 캐릭터 추가 (원본과 같음)
        if (m_data.GetCharacters().empty())
        {
            auto characters{ m_data.GetCharacters() };
            characters.try_emplace(std::string{ Core::APPConstants::DEFAULT_CHARACTER_NAME }, Models::Character{});
            m_data.SetCharacters(std::move(characters));
        }
    }

    Models::UserData& JSONDataRepository::GetData()
    {
        return m_data;
    }

    const Models::UserData& JSONDataRepository::GetData() const
    {
        return m_data;
    }

    const std::optional<std::string>& JSONDataRepository::GetLoadWarning() const noexcept
    {
        return m_loadWarning;
    }

    void JSONDataRepository::Save()
    {
        const std::filesystem::path savePath{ Core::APPConstants::GetSaveFilePath() };
        const std::filesystem::path tempPath{ Core::APPConstants::GetTempFilePath() };
        const std::filesystem::path backupPath{ Core::APPConstants::GetBackupFilePath() };

        // 1) 임시 파일에 먼저 전부 씀 (여기서 실패하면 기존 저장본은 그대로)
        WriteTextFile(tempPath, BuildJsonText(m_data));

        // 2) 처음 저장이면 그냥 이름 변경
        if (!std::filesystem::exists(savePath))
        {
            std::filesystem::rename(tempPath, savePath);
            return;
        }

        // 3) 기존 저장본은 .bak으로 보관하면서 원자적으로 교체 (원본 File.Replace와 같은 역할)
        if (!::ReplaceFileW(savePath.c_str(), tempPath.c_str(), backupPath.c_str(), 0, nullptr, nullptr))
        {
            // 교체가 막히면 복사로 대신하고 임시 파일 정리 (원본 IOException 대응)
            std::filesystem::copy_file(tempPath, savePath, std::filesystem::copy_options::overwrite_existing);
            std::filesystem::remove(tempPath);
        }
    }
}﻿module LostArkCalculator.Services.JSONValue;

import std;

namespace LostArkCalculator::Services
{
    namespace
    {
        constexpr std::string_view JSON_FORMAT_ERROR_MESSAGE{ "API 응답 형식이 올바르지 않습니다." };
        constexpr std::string_view NULL_LITERAL{ "null" };
        constexpr std::string_view TRUE_LITERAL{ "true" };
        constexpr std::string_view FALSE_LITERAL{ "false" };
        constexpr char END_OF_TEXT{ '\0' };

        // \uXXXX 이스케이프 처리용
        constexpr std::size_t HEX_DIGIT_COUNT{ 4 };
        constexpr int HEX_RADIX{ 16 };
        constexpr unsigned HIGH_SURROGATE_FIRST{ 0xD800 };
        constexpr unsigned HIGH_SURROGATE_LAST{ 0xDBFF };
        constexpr unsigned LOW_SURROGATE_FIRST{ 0xDC00 };
        constexpr unsigned LOW_SURROGATE_LAST{ 0xDFFF };
        constexpr unsigned SURROGATE_PAIR_BASE{ 0x10000 };
        constexpr unsigned SURROGATE_PAYLOAD_BITS{ 10 };
        constexpr std::size_t UNICODE_ESCAPE_PREFIX_LENGTH{ 2 };
        constexpr std::string_view UNICODE_ESCAPE_PREFIX{ "\\u" };

        // 코드 포인트 → UTF-8 변환용
        constexpr unsigned UTF8_2BYTE_START{ 0x80 };
        constexpr unsigned UTF8_3BYTE_START{ 0x800 };
        constexpr unsigned UTF8_4BYTE_START{ 0x10000 };
        constexpr unsigned UTF8_2BYTE_LEAD{ 0xC0 };
        constexpr unsigned UTF8_3BYTE_LEAD{ 0xE0 };
        constexpr unsigned UTF8_4BYTE_LEAD{ 0xF0 };
        constexpr unsigned UTF8_CONTINUATION{ 0x80 };
        constexpr unsigned UTF8_PAYLOAD_MASK{ 0x3F };
        constexpr unsigned UTF8_SHIFT_6{ 6 };
        constexpr unsigned UTF8_SHIFT_12{ 12 };
        constexpr unsigned UTF8_SHIFT_18{ 18 };

        [[noreturn]] void ThrowFormatError()
        {
            throw std::runtime_error{ std::string{ JSON_FORMAT_ERROR_MESSAGE } };
        }

        bool IsJsonWhitespace(char c) noexcept
        {
            return c == ' ' || c == '\t' || c == '\n' || c == '\r';
        }

        bool IsNumberChar(char c) noexcept
        {
            return (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E';
        }

        // 코드 포인트 하나를 UTF-8 바이트열로 덧붙임
        void AppendUtf8(std::string& out, unsigned codepoint)
        {
            if (codepoint < UTF8_2BYTE_START)
            {
                out.push_back(static_cast<char>(codepoint));
            }
            else if (codepoint < UTF8_3BYTE_START)
            {
                out.push_back(static_cast<char>(UTF8_2BYTE_LEAD | (codepoint >> UTF8_SHIFT_6)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | (codepoint & UTF8_PAYLOAD_MASK)));
            }
            else if (codepoint < UTF8_4BYTE_START)
            {
                out.push_back(static_cast<char>(UTF8_3BYTE_LEAD | (codepoint >> UTF8_SHIFT_12)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | ((codepoint >> UTF8_SHIFT_6) & UTF8_PAYLOAD_MASK)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | (codepoint & UTF8_PAYLOAD_MASK)));
            }
            else
            {
                out.push_back(static_cast<char>(UTF8_4BYTE_LEAD | (codepoint >> UTF8_SHIFT_18)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | ((codepoint >> UTF8_SHIFT_12) & UTF8_PAYLOAD_MASK)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | ((codepoint >> UTF8_SHIFT_6) & UTF8_PAYLOAD_MASK)));
                out.push_back(static_cast<char>(UTF8_CONTINUATION | (codepoint & UTF8_PAYLOAD_MASK)));
            }
        }

        // 재귀 하강 방식의 JSON 파서 (내부 전용)
        class JSONParser
        {
        public:
            explicit JSONParser(std::string_view text) noexcept
                : m_text{ text }
            {}

            JSONValue ParseDocument()
            {
                JSONValue root{ ParseValue() };
                SkipWhitespace();
                if (!IsRawEnd()) ThrowFormatError();   // 값 뒤에 남은 글자가 있으면 형식 오류
                return root;
            }

        private:
            JSONValue ParseValue()
            {
                switch (PeekChar())
                {
                    case '{': return ParseObject();
                    case '[': return ParseArray();
                    case '"': return JSONValue::CreateString(ParseString());
                    case 't':
                        ExpectLiteral(TRUE_LITERAL);
                        return JSONValue::CreateBool(true);
                    case 'f':
                        ExpectLiteral(FALSE_LITERAL);
                        return JSONValue::CreateBool(false);
                    case 'n':
                        ExpectLiteral(NULL_LITERAL);
                        return JSONValue{};
                    default:
                        return JSONValue::CreateNumber(ParseNumber());
                }
            }

            JSONValue ParseObject()
            {
                ExpectChar('{');
                std::vector<std::string> keys;
                std::vector<JSONValue> values;

                if (PeekChar() == '}')
                {
                    ++m_position;
                    return JSONValue::CreateObject(std::move(keys), std::move(values));
                }

                while (true)
                {
                    keys.push_back(ParseString());
                    ExpectChar(':');
                    values.push_back(ParseValue());

                    const char next{ PeekChar() };
                    if (next == ',')
                    {
                        ++m_position;
                        continue;
                    }
                    if (next == '}')
                    {
                        ++m_position;
                        break;
                    }
                    ThrowFormatError();
                }
                return JSONValue::CreateObject(std::move(keys), std::move(values));
            }

            JSONValue ParseArray()
            {
                ExpectChar('[');
                std::vector<JSONValue> items;

                if (PeekChar() == ']')
                {
                    ++m_position;
                    return JSONValue::CreateArray(std::move(items));
                }

                while (true)
                {
                    items.push_back(ParseValue());

                    const char next{ PeekChar() };
                    if (next == ',')
                    {
                        ++m_position;
                        continue;
                    }
                    if (next == ']')
                    {
                        ++m_position;
                        break;
                    }
                    ThrowFormatError();
                }
                return JSONValue::CreateArray(std::move(items));
            }

            std::string ParseString()
            {
                ExpectChar('"');

                std::string result;
                while (true)
                {
                    if (IsRawEnd()) ThrowFormatError();
                    const char current{ m_text[m_position++] };

                    if (current == '"') return result;
                    if (current != '\\')
                    {
                        result.push_back(current);
                        continue;
                    }

                    if (IsRawEnd()) ThrowFormatError();
                    const char escaped{ m_text[m_position++] };
                    switch (escaped)
                    {
                        case '"':  result.push_back('"'); break;
                        case '\\': result.push_back('\\'); break;
                        case '/':  result.push_back('/'); break;
                        case 'b':  result.push_back('\b'); break;
                        case 'f':  result.push_back('\f'); break;
                        case 'n':  result.push_back('\n'); break;
                        case 'r':  result.push_back('\r'); break;
                        case 't':  result.push_back('\t'); break;
                        case 'u':  AppendUtf8(result, ReadUnicodeEscape()); break;
                        default:   ThrowFormatError();
                    }
                }
            }

            // \uXXXX 한 개 (상위·하위 대리 문자면 쌍으로 묶어서 코드 포인트를 만듦)
            unsigned ReadUnicodeEscape()
            {
                const unsigned first{ ReadHex4() };
                if (first < HIGH_SURROGATE_FIRST || first > LOW_SURROGATE_LAST) return first;   // 일반 글자
                if (first >= LOW_SURROGATE_FIRST) ThrowFormatError();                           // 짝 없는 하위 대리 문자

                // 상위 대리 문자 바로 뒤에는 하위 대리 문자 이스케이프가 반드시 와야 함
                if (m_text.substr(m_position, UNICODE_ESCAPE_PREFIX_LENGTH) != UNICODE_ESCAPE_PREFIX) ThrowFormatError();
                m_position += UNICODE_ESCAPE_PREFIX_LENGTH;

                const unsigned second{ ReadHex4() };
                if (second < LOW_SURROGATE_FIRST || second > LOW_SURROGATE_LAST) ThrowFormatError();

                return SURROGATE_PAIR_BASE
                    + ((first - HIGH_SURROGATE_FIRST) << SURROGATE_PAYLOAD_BITS)
                    + (second - LOW_SURROGATE_FIRST);
            }

            unsigned ReadHex4()
            {
                if (m_position + HEX_DIGIT_COUNT > m_text.size()) ThrowFormatError();

                const char* first{ m_text.data() + m_position };
                const char* last{ first + HEX_DIGIT_COUNT };
                unsigned value{};
                const auto [ptr, ec] { std::from_chars(first, last, value, HEX_RADIX) };
                if (ec != std::errc{} || ptr != last) ThrowFormatError();

                m_position += HEX_DIGIT_COUNT;
                return value;
            }

            double ParseNumber()
            {
                SkipWhitespace();
                const std::size_t start{ m_position };
                while (!IsRawEnd() && IsNumberChar(m_text[m_position])) ++m_position;

                const std::string_view token{ m_text.substr(start, m_position - start) };
                double value{};
                const auto [ptr, ec] { std::from_chars(token.data(), token.data() + token.size(), value) };
                if (token.empty() || ec != std::errc{} || ptr != token.data() + token.size()) ThrowFormatError();
                return value;
            }

            void ExpectLiteral(std::string_view literal)
            {
                SkipWhitespace();
                if (m_text.substr(m_position, literal.size()) != literal) ThrowFormatError();
                m_position += literal.size();
            }

            void ExpectChar(char expected)
            {
                if (PeekChar() != expected) ThrowFormatError();
                ++m_position;
            }

            // 공백을 건너뛴 다음 글자를 봄 (끝이면 END_OF_TEXT)
            char PeekChar()
            {
                SkipWhitespace();
                return IsRawEnd() ? END_OF_TEXT : m_text[m_position];
            }

            void SkipWhitespace() noexcept
            {
                while (!IsRawEnd() && IsJsonWhitespace(m_text[m_position])) ++m_position;
            }

            [[nodiscard]] bool IsRawEnd() const noexcept
            {
                return m_position >= m_text.size();
            }

            std::string_view m_text;
            std::size_t m_position{};
        };
    }

    JSONValue::JSONValue() noexcept = default;

    JSONValue JSONValue::CreateBool(bool value)
    {
        JSONValue result;
        result.m_type = JsonType::BOOL_VALUE;
        result.m_boolValue = value;
        return result;
    }

    JSONValue JSONValue::CreateNumber(double value)
    {
        JSONValue result;
        result.m_type = JsonType::NUMBER_VALUE;
        result.m_numberValue = value;
        return result;
    }

    JSONValue JSONValue::CreateString(std::string value)
    {
        JSONValue result;
        result.m_type = JsonType::STRING_VALUE;
        result.m_stringValue = std::move(value);
        return result;
    }

    JSONValue JSONValue::CreateArray(std::vector<JSONValue> items)
    {
        JSONValue result;
        result.m_type = JsonType::ARRAY_VALUE;
        result.m_items = std::move(items);
        return result;
    }

    JSONValue JSONValue::CreateObject(std::vector<std::string> keys, std::vector<JSONValue> values)
    {
        JSONValue result;
        result.m_type = JsonType::OBJECT_VALUE;
        result.m_keys = std::move(keys);
        result.m_items = std::move(values);
        return result;
    }

    JsonType JSONValue::GetType() const noexcept
    {
        return m_type;
    }

    bool JSONValue::GetBool() const noexcept
    {
        return m_type == JsonType::BOOL_VALUE && m_boolValue;
    }

    double JSONValue::GetNumber() const noexcept
    {
        return m_type == JsonType::NUMBER_VALUE ? m_numberValue : 0.0;
    }

    const std::string& JSONValue::GetString() const noexcept
    {
        static const std::string EMPTY_STRING{};
        return m_type == JsonType::STRING_VALUE ? m_stringValue : EMPTY_STRING;
    }

    const std::vector<JSONValue>& JSONValue::GetItems() const noexcept
    {
        static const std::vector<JSONValue> EMPTY_ITEMS{};
        return m_type == JsonType::ARRAY_VALUE ? m_items : EMPTY_ITEMS;
    }

    const JSONValue& JSONValue::FindMember(std::string_view key) const noexcept
    {
        static const JSONValue NULL_NODE{};
        if (m_type != JsonType::OBJECT_VALUE) return NULL_NODE;

        for (std::size_t index{}; index < m_keys.size(); ++index)
        {
            if (m_keys[index] == key) return m_items[index];
        }
        return NULL_NODE;
    }

    JSONValue ParseJsonText(std::string_view text)
    {
        JSONParser parser{ text };
        return parser.ParseDocument();
    }
